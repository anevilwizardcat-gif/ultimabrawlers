;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]
[State -2, Hide Engine Power Bar]
type = AssertSpecial
trigger1 = 1
flag = noPowerBarDisplay
ignorehitpause = 1


[State -2]
type = assertspecial
trigger1 = 1
flag = noairguard
ignorehitpause = 1

