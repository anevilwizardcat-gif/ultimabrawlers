;============================================================================
; Maverick Hunter Zero Cns.
; Por DDarkbeing 2004 && Ariel Co. 2002  
; Version: 0.70
;----------------------------------------------------------------------------


[Data]

life = 1000
attack = 100
defence = 100 
fall.defence_up = 50
liedown.time = 50
airjuggle = 77
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 13    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60	          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 1     ;Set to 1 to scale projectiles too   
head.pos = -5, -80   ;Approximate position of head
mid.pos = -5, -50    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 4        ;Walk forward
walk.back = -4       ;Walk backward
run.fwd  = 5.9, 0    ;Run forward (x, y)
run.back = -6.6,-3.8 ;Hop backward (x, y)
jump.neu = 0,-9.4    ;Neutral jumping velocity (x, y)
jump.back = -3.5     ;Jump back Speed (x, y)
jump.fwd = 3.5       ;Jump forward Speed (x, y)
airjump.neu = 0,-8  ;.
airjump.back = -3    ;Air jump speeds (opt)
airjump.fwd = 3      ;.

[Movement]
airjump.num = 3      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85 ;Friction coefficient when standing
crouch.friction = .82;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[state 180,1]
type = varrandom
trigger1 = MatchOver = 0
trigger1 = time = 0
v = 1
range = 1,1

[state 180,1]
type = varrandom
trigger1 = MatchOver = 1
v = 1
range = 2,2

[State 180, 2]
type = ChangeState
trigger1 = Time = 0 && var(1) = 1
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Time = 0 && var(1) = 2
value = 182

;---------------------------------------------------------------------------

; Win pose - Yeah !
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = playsnd
trigger1 = AnimElem = 2
value = 10,3

[State 181, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1


; Win pose - Yeah teleport
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 181, 1]
type = playsnd
trigger1 = AnimElem = 2
value = 10,3

[State 181, 1]
type = playsnd
trigger1 = AnimElem = 6
value = 0,4

[State 181, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;------ |INTRO| -----------------------------------------------

[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 1500, 1]
type = PlaySnd
trigger1 = AnimElem = 3
value = 10,1 

[State 191, 3]
type = PlaySnd
trigger1 = AnimElem = 11
value = 0,6

[State 195, 1]
type = playsnd
trigger1 = AnimElem = 16
value = 10,3

[State 191, 1]
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] 
type = AssertSpecial
trigger1 = AnimElemTime(10) < 0
flag = Intro

[state 192,5]
type = changestate
trigger1 = animtime = 0
value = 0

;---------------------------------------------------------------------------
; Taunt
; CNS difficulty: easy
[Statedef 195]
type = S
ctrl = 0
poweradd = 0
anim = 195
velset = 0,0
movetype = I
physics = S

[State 195, 1]
type = CtrlSet
trigger1 = Time = 40
value = 1

[State 195, 1]
type = playsnd
trigger1 = AnimElem = 2
value = 10,3

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = A
anim = 39

[state 12,12]
type = turn
triggerall = Time = 1
trigger1 = vel x < 0 

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 0
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 50, Additional Gravity]
type = VelAdd
trigger1 = var(1) = 1
y = .4

[State 45, 7]
type = ChangeState
trigger1 = Time = 24
value = 50
ctrl = 1


