;BULLET SHELL HELPER
[Statedef 1304]
type = A
physics = N
anim = 1504
velset = -2.5,-4
sprpriority = 6

[State 1305, Shell Snd]
type = PlaySnd
trigger1 = !Time
value = S1100,2
volume = 255

[State 1304, Gravity]
type = VelAdd
trigger1 = 1
y = 0.35

[State 1304, ChangeState]
type = ChangeState
triggerall = Time > 1
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 1305

;Bullet Shell part 2
[Statedef 1305]
type = A
physics = N

[State 1305, Shell Snd]
type = PlaySnd
trigger1 = !Time
value = S1100,2
volume = 255
channel = -1
freqmul = 1.0
loop = 0
pan = 0

[State 1305, PosSet]
type = PosSet
trigger1 = !Time
y = 0

[State 1305, VelMul]
type = VelMul
trigger1 = !Time
x = .6
y = -.4

[State 1305, Gravity]
type = VelAdd
trigger1 = 1
y = .3

[State 1305, VarAdd]
type = VarAdd
trigger1 = vel y > 0
var(0) = 1

[State 1305, Transparency]
type = trans
trigger1 = var(0)
trans = addalpha
alpha = 256-(var(0)*10),var(0)*10

[State 1305, ChangeState]
type = ChangeState
triggerall = Time > 1
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 1306

[State 1305, End]
type = DestroySelf
trigger1 = var(0) >= 25

