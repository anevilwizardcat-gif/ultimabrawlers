; ここにキャラ情報を書いてください
[Info]
name = "pucci"        ;キャラの名前
displayname = "Enrico Pucci" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "0011"         ;キャラの製作者名
pal.defaults = 1,2,3,6      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = pucci.cmd           ;コマンド
cns     = pucci.cns           ;プログラム
st      = pucci.cns           ;プログラム
st1      = tandem.cns         ;タンデム（プログラム）
st2      = Remotecontrol.cns  ;遠隔操作
st3      = _config.txt        ;コンフィグ
st4      = Rtandem.cns        ;タンデム（リアルタイム）
stcommon = jojocommon.cns     ;common
sprite  = pucci.sff   ;キャラの絵
anim    = pucci.air   ;キャラの動き
sound   = pucci.snd;   ;キャラの音
pal1    = truemanga.act   ;キャラの色（最大１２個）