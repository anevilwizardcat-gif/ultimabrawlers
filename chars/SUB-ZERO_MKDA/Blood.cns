;----------------------------------------
;dayum
[Statedef 7028]
type    = A
movetype= A
physics = N
poweradd= 0
anim = 9999
velset = 0,0
ctrl = 0
sprpriority = 1

[State gotas]
type = Helper
trigger1 = animelemtime(2) < 45 ;&& !(time%2)
helpertype = Normal
id = 315
stateno = 315
ownpal = 1
ignorehitpause = 1

[State ]
type = playsnd
trigger1 = !time
value = 1,8

[State blackness]
type = null;palfx
trigger1 = !(time%2)
time = 2
add = -50,-50, -50

[State ]
type = Explod
trigger1 = time <= 4
anim = 7022
id = 7021
removetime = 1
Postype = p1
bindtime = -1
pos = 0,0
scale = 0+fvar(0),0+fvar(0)
sprpriority = 3

[State ]
type = Explod
trigger1 = time = 5
anim = 7022
id = 7021
removetime = 4
Postype = p1
bindtime = -1
pos = 0,0
sprpriority = 3

[State ]
type = Explod
trigger1 = time >= 9
anim = 7022
id = 7021
removetime = 1
Postype = p1
bindtime = -1
pos = 0,0
scale = 1-fvar(1),1-fvar(1)
sprpriority = 3

[State ]
type = varadd
trigger1 = time <= 4
fvar(0) = .2
[State ]
type = varadd
trigger1 = time >= 9
fvar(1) = .1

[State end]
type = destroyself
trigger1 = time = 19

