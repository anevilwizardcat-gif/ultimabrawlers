;===========================================================================
;---------------------------------------------------------------------------
;受身（空中）
[State -1]
type = ChangeState
value = 5210
triggerall = Var(59) = 1
triggerall = Alive
triggerall = CanRecover
triggerall = Vel Y > -1
triggerall = Pos Y >= -40
triggerall = StateNo = 5050
trigger1 = random = [150,200]

;---------------------------------------------------------------------------
;受身（地上）
[State -1]
type = ChangeState
value = 5200
triggerall = var(59) = 1
triggerall = ((var(20) = 1 || var(20) = 4 || var(20) = 5 || var(20) = 6) && !(var(0)&2**10)) || CanRecover
triggerall = Alive
triggerall = StateNo = 5050 || StateNo = 5071
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
trigger1 = random <= 400

;---------------------------------------------------------------------------
;ジャンプ（投げ回避）
[state -1, Guard]
type = ChangeState
value = 40
triggerall = var(59) = 1
triggerall = roundstate = 2
triggerall = InGuardDist || P2bodydist X = [-60,120]
triggerall = ctrl || stateno = 21
triggerall = statetype != A
trigger1 = enemynear,HitDefAttr = SC, NT,ST,HT
	trigger1 = random = [0,700]

;---------------------------------------------------------------------------
;歩き
[State -1, Walk]
type = ChangeState
value = 21
triggerall = Var(59) = 1
triggerall = StateType != A
triggerall = Ctrl
triggerall = !InGuardDist
triggerall = stateno != [10,12]
triggerall = prevstateno != [10,12]
triggerall = stateno != 20
triggerall = prevstateno != 20
triggerall = stateno != 21
triggerall = prevstateno != 21
triggerall = stateno != [120,159]
triggerall = prevstateno != [120,159]
triggerall = P2stateno != 5120
trigger1 = !(var(16) && numtarget)
	trigger1 = random%10<=8

[State -1, Walk]
type = ChangeState
value = 21
triggerall = Var(59) = 1
triggerall = StateType != A
triggerall = Ctrl
triggerall = !InGuardDist
triggerall = stateno != 20
triggerall = prevstateno != 20
triggerall = stateno != [120,159]
triggerall = time > 10
trigger1 = !(var(16) && numtarget)
	trigger1 = random%10<=8

;---------------------------------------------------------------------------
;オリコン発動（地上）
[State -1]
type = ChangeState
value = 870
triggerall = var(59) = 1
triggerall = var(20) = 1 || var(20) = 6
triggerall = Power >= 3000
triggerall = !var(15) && !var(16)
triggerall = roundstate = 2
triggerall = statetype != A
triggerall = P2life > 150 || (100*life/const(data.life))<=15
trigger1 = ctrl || stateno = 21 || (stateno = 100 && animelemtime(2) > 1) || stateno = 101
trigger1 = P2bodydist X = [-5,30]
trigger1 = P2StateType = S || P2StateType = C
trigger1 = P2MoveType = A
	trigger1 = random = [200,700]

;===========================================================================
;起き上がりリバーサル

;---------------------------------------------------------------------------
;愛と友情のツープラトン攻撃：ロシアより愛を込めて
[State -1, god press]
type = ChangeState
value = 3300
triggerall = var(59) = 1
triggerall = !var(12)
triggerall = ((!var(20) || var(20) = 2 || (var(20) = 6 && !var(16))) && Power >= 3000) || (var(20) = 3 && (100*life/const(data.life))<=30 && var(14)) || (var(15) && Power >= 1000) || (var(0)&2**3) 
triggerall = statetype != A
triggerall = P2StateType != L
triggerall = P2stateno != 5120
triggerall = P2stateno != 5201
triggerall = P2life > 300 || (100*life/const(data.life))<=20 || var(20) = 3 || var(20) = 5
triggerall = ctrl && prevstateno = 5120 && time <= 1
triggerall = enemynear,time >= (4+random%10)
trigger1 = P2bodydist X = [-5,30]
trigger1 = P2StateType != A || ((enemynear,Pos Y = [-30,0]) && enemynear,Vel Y > 1)
trigger1 = P2MoveType = A
trigger1 = enemynear,Vel X >= 0
trigger1 = !(var(16) && numtarget)
	trigger1 = Random <= 550
ignorehitpause = 0

