;===========================================================================
; -2 State
;===========================================================================

[Statedef -2]

[state -2, debug]
type = DisplayToClipboard
trigger1 = 1
text = "stand = %d stand2 = %d var = %d hit = %d"
params = var(0),var(9),var(12),var(40)
ignorehitpause = 1

;긚깛긤긶깑긬
[state -2, helper]
type = helper
trigger1 = roundstate = 2
trigger1 = !numhelper(10000)
helpertype = normal
name = "stand helper"
stateno = 10000
id = 10000
postype = p1
pos = 0,0
ownpal = 0
keyctrl = 0
pausemovetime = 0
supermovetime = 0

;뫬긶깑긬
[state -2, helper]
type = helper
trigger1 = roundstate = 2
trigger1 = !numhelper(20000)
helpertype = normal
name = "pol helper"
stateno = 20000
id = 20000
postype = p1
pos = 0,0
ownpal = 0
keyctrl = 0
pausemovetime = 999999
supermovetime = 0

;뵯뚹긶깑긬
[state -2, helper]
type = helper
trigger1 = roundstate = 2
trigger1 = !numhelper(40000)
helpertype = normal
name = "kirakira"
stateno = 40000
id = 40000
postype = p1
pos = 0,0
ownpal = 1
keyctrl = 0
pausemovetime = 999999
supermovetime = 999999

;긽긞긜긙귺귽긓깛
[state -2, helper]
type = helper
trigger1 = roundstate = 2
trigger1 = !numhelper(7520)
helpertype = normal
name = "message helper"
stateno = 7500
id = 7500
postype = back
pos = 0,0
ownpal = 1
keyctrl = 0
pausemovetime = 999999
supermovetime = 999999

;긚깛긤긒긙
[state -2, helper]
type = helper
trigger1 = roundstate = 2
trigger1 = !numhelper(7520)
helpertype = normal
name = "system helper"
stateno = 7520
id = 7520
postype = back
pos = 0,0
ownpal = 1
keyctrl = 0
pausemovetime = 999999
supermovetime = 999999

;긚깛긤뎓뤑궢
[state -2, assert]
type = assertspecial
trigger1 = var(0)
flag = Noshadow
ignorehitpause = 1

;긚깛긤뢯뙸렄긊븉
[state -2, assert]
type = assertspecial
trigger1 = var(9)
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard
ignorehitpause = 1

;떗맕습噴FF
[state -2, var]
type = varset
triggerall = var(0)
triggerall = movetype = H
triggerall = stateno != [120,159]
trigger1 = stateno != [5000,5999]
trigger2 = anim = [0,5999]
trigger3 = stateno = [4000,4100]
var(0) = 0
ignorehitpause = 0

[State -2, anim]
type = changeanim
trigger1 = var(0)
trigger1 = anim < 10000
value = anim + 10000

;2뭝긙긿깛긵뵽믦
[state -2, var]
type = varadd
trigger1 = var(3) > 0
var(3) = 1
[state -2, var]
type = varset
triggerall = time = 1
trigger1 = stateno = 50
trigger2 = stateno = 5210
var(3) = 1
[state -2, var]
type = varset
trigger1 = var(3) >= 8
trigger1 = command != "holdup"
var(3) = 0

;pausetime뾭
[state -2, var]
type = varadd
trigger1 = var(8)
var(8) = -1
ignorehitpause = 1

;뗴뭷긞긘깄뵽믦
[state -2, var]
type = varadd
trigger1 = var(18) > 0
var(18) = -1
[state -2, var]
type = varset
triggerall = !time
trigger1 = stateno = 111
trigger2 = stateno = 116
var(18) = 24
[state -2, var]
type = varset
trigger1 = var(18) <= 0
trigger1 = command != "holdfwd" && command != "holdback"
var(18) = 0

;긚깛긤뤑땸븉됀렄듩
[state -2, var]
type = varadd
trigger1 = var(19)
var(19) = -1
ignorehitpause = 1

;깛긢띋볺쀍븉됀렄듩
[state -2, var]
type = varadd
trigger1 = var(23)
var(23) = -1
ignorehitpause = 1

;됷귟뜛귒띋볺쀍븉됀렄듩
[state -3, var]
type = varadd
trigger1 = var(24)>0
var(24) = -1
[state -3, var]
type = varset
trigger1 = var(24)<0
var(24) = 0

;긛봃렞뾭
[state -2, var]
type = varset
trigger1 = 1
var(25) = 0

;gametime
[state -2, var]
type = varset
trigger1 = 1
var(46) = gametime

;긬긣긥긌긿깋뵽빶뾭
[state -2, var]
type = varset
triggerall = roundstate < 2
triggerall = teammode = simul
triggerall = numpartner
trigger1 = partner,authorname = "Warusaki3"
trigger1 = partner,name = "dio" || partner,name = "final dio" || partner,name = "vanillaice" || partner,name = "Jotaro Kujo"
trigger2 = partner,authorname = "Izumo"
trigger2 = id > partner,id
var(57) = 1

;===========================================================================
;긚깛긤긒긙
[state -2, var]
type = varset
trigger1 = roundstate = 0
trigger2 = var(1) > 100
var(1) = 100
ignorehitpause = 1

[state -2, var]
type = varset
trigger1 = var(1) < 0
var(1) = 0
ignorehitpause = 1

;뙵룺
[state -2, var]
type = varadd
trigger1 = var(0)
trigger1 = var(1) > 0
trigger1 = var(51)-life > 0
var(1) = -2-ceil((var(51)-life)*.15)
ignorehitpause = 1

;됷븳
[state -2, var]
type = varadd
trigger1 = !var(0)
trigger1 = var(1) = [1,99]
trigger1 = !(gametime%2)
var(1) = 1
ignorehitpause = 1

;랁귟뼰뚼
[state -2, life]
type = lifeadd
triggerall = var(0)
triggerall = var(51)-life > 0
trigger1 = stateno = 120
trigger2 = stateno = [130,132]
trigger3 = stateno = 140
trigger4 = stateno = [150,155]
value = ceil((var(51)-life)*1.15)
ignorehitpause = 1

[state -2, var]
type = varset
trigger1 = alive
var(51) = life
ignorehitpause = 1

;---------------------------------------------------------------------------
;긚깛긤긏깋긞긘깄
[state -2, var]
type = varadd
trigger1 = var(52)
var(52) = -1
ignorehitpause = 1

[state -2, var]
type = varadd
trigger1 = !var(52) && var(53)
var(53) = -1
ignorehitpause = 1

[state -2, var]
type = varset
trigger1 = stateno != [4000,4999]
var(52) = gethitvar(hitshaketime)
ignorehitpause = 1

[state -2, var]
type = varset
trigger1 = stateno != [4000,4999]
var(53) = gethitvar(hittime)
ignorehitpause = 1

[State -2, end]
type = changestate
triggerall = !var(1)
triggerall = !var(20)
triggerall = stateno != 4000
triggerall = alive
trigger1 = stateno = [5000,5001]
trigger2 = stateno = [5010,5011]
trigger3 = stateno = 5020
trigger4 = stateno = 5030
trigger5 = stateno = 5035
trigger6 = stateno = 5040
trigger7 = stateno = 5050
trigger8 = stateno = [5070,5071]
trigger9 = stateno = [5080,5081]
trigger10 = stateno = [5100,5101]
trigger11 = stateno = 5110
trigger12 = stateno = 5120
trigger13 = stateno = 5150
trigger14 = stateno = [5200,5201]
trigger15 = stateno = 5210
value = 4000

[State -2, end]
type = changestate
triggerall = !var(1)
triggerall = !var(20)
triggerall = stateno != 4000
triggerall = alive
trigger1 = stateno = 120
trigger2 = stateno = [130,132]
trigger3 = stateno = 140
trigger4 = stateno = [150,155]
value = 4100

;됷븳븉됀
[state -2, var]
type = varset
trigger1 = var(20) = 20
var(1) = 1
ignorehitpause = 1

[state -2, var]
type = varset
trigger1 = var(20) = 20
var(20) = 0
ignorehitpause = 1

[state -2, var]
type = varadd
trigger1 = !var(1)
var(20) = 1
ignorehitpause = 1


