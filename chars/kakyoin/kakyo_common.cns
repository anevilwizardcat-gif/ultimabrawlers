type = C
physics = C
ctrl = 1
anim = 10+var(0)
sprpriority = 0

[State 0, vel]
type = velmul
trigger1 = !time
x = .75

[State 10, 5] 
type = ChangeState 
trigger1 = var(59) = 1
trigger1 = enemynear,movetype != H
value = 0 
ctrl = 1 

[State 0, end]
type = changestate
triggerall = var(59) = 0
trigger1 = command != "holddown"
value = 12

[State 0, end]
type = changestate
trigger1 = !animtime
value = 11

