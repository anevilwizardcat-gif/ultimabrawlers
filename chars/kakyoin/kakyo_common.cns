;Run
[Statedef 100]
type    = S
movetype = I
physics = N
ctrl = 0
anim = 100+var(0)
velset = 0,0
sprpriority = 0

[State 0, pos]
type = posset
trigger1 = !time
y = 0

[State 0, vel]
type = velset
trigger1 = time = 1
x = ifelse(!var(0),const(velocity.run.fwd.x),const(velocity.run.fwd.x)*.75)

[State 0, assert]
type = assertspecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 0, end]
type = changestate
triggerall = var(59) = 0
trigger1 = command = "holdup"
value = 40

[State 0, anim]
type = changeanim
triggerall = var(59) = 0
triggerall = anim = 100+var(0)
trigger1 = time > 9
trigger1 = command != "holdfwd" || command = "holdback"
trigger2 = !var(0) && time = 40
trigger3 = var(0) && time = 18
value = 101+var(0)


[State 0, anim]
type = changeanim
triggerall = var(59) = 1
triggerall = anim = 100+var(0)
trigger1 = !var(0) && time = 40
trigger2 = var(0) && time = 18
trigger3 = time > 9
trigger3 = var(9) = 0 || var(9) = 3
trigger3 = random < (320 - p2bodydist X)+time
trigger4 = time > 9
trigger4 = enemynear,movetype = A 
trigger4 = enemynear,HitDefAttr = SCA, AA || enemynear,HitDefAttr = SCA, AP
trigger4 = p2bodydist X >= 40
trigger5 = time > 9
trigger5 = inguarddist
trigger6 = time > 9
trigger6 = var(9) = 0 
Trigger6 = P2BodyDist X <= 80
Trigger6 = P2BodyDist Y >= -100
trigger6 = EnemyNear,movetype != H
trigger6 = EnemyNear,statetype = A
trigger6 = random < 100
trigger7 = time > 9
trigger7 = numhelper(76767) > 0
trigger7 = helper(76767),InGuardDist
value = 101+var(0)




[State 0, vel]
type = velmul
trigger1 = anim = 101+var(0)
x = .95

[State 0, end]
type = changestate
triggerall = anim = 101+var(0)
trigger1 = !animtime
value = 0
ctrl = 1

