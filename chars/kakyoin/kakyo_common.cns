;------------------------------------------------------------------------------------------
;Walk
[Statedef 20]
type = S
physics = S
ctrl = 1
anim = 20+var(0)
sprpriority = 0

[State 0, vel]
type = velset
triggerall = var(59) = 0
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 0, vel]
type = velset
triggerall = var(59) = 0
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 5] 
type = ChangeState 
trigger1 = var(59) = 1
value = 0 
ctrl = 1

[State 0, anim]
type = changeanim
triggerall = vel x > 0
trigger1 = anim != (20+var(0)) && anim != (5+var(0))
trigger2 = anim = (5+var(0)) && (!animtime)
value = 20+var(0)

[State 0, anim]
type = changeanim
triggerall = vel x < 0
trigger1 = anim != (21+var(0)) && anim != (5+var(0))
trigger2 = anim = (5+var(0)) && (!animtime)
value = 21+var(0)

;------------------------------------------------------------------------------------------
;Jump Start
[Statedef 40]
type = S
physics = S
ctrl = 0
anim = 40+var(0)
velset = 0,0
sprpriority = 0

[State 0, sysvar]
type = varset
triggerall = var(59) = 0
trigger1 = !time
sysvar(1) = command = "holdfwd"-command = "holdback"

[State 0, var]
type = varset
trigger1 = !time
var(4) = 0

[State 0, var]
type = varset
triggerall = var(59) = 0
triggerall = !time
trigger1 = prevstateno = 100 || prevstateno = 105
trigger2 = command = "highjump"
var(4) = 1

[State 0, var]
type = varset
trigger1 = !time
var(5) = 0

[State 0, var]
type = varset
triggerall = var(59) = 0
trigger1 = command != "holdup"
var(5) = 1

[State 0, vel]
type = velset
trigger1 = !animtime
x = ifelse(!sysvar(1),0,ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))*ifelse(var(4)&&(!var(0)||(var(0)&&!var(5))),1.54,1)

[State 0, vel]
type = velset
trigger1 = !animtime
y = const(velocity.jump.y)*ifelse(var(5),.8,1)*ifelse(var(4),ifelse(!var(0),1.12,1.25),1)



[State 40, AI] 
type = ChangeState 
triggerall = var(59) = 1
triggerall = time = 0
trigger1 = 1
value = 0 
ctrl = 1



[State 0, end]
type = changestate
trigger1 = !animtime
value = 50
ctrl = 1

;------------------------------------------------------------------------------------------
;Jump
[Statedef 50]
type = A
physics = N
ctrl = 1
sprpriority = 0

[State 0, gravity]
type = gravity
trigger1 = 1

[State 0, anim]
type = changeanim
trigger1 = !time
value = ifelse(!sysvar(1),41,ifelse(sysvar(1)=1,42,43))+var(0)

[State 0, sysvar]
type = varset
trigger1 = !time
sysvar(1) = 0

[State 0, anim]
type = changeanim
trigger1 = vel y > -2
trigger1 = SelfAnimExist(anim + 3)
value = anim + 3
persistent = 0

[State 0, end]
type = changestate
trigger1 = pos y >= 0 && vel y > 0
value = 52

