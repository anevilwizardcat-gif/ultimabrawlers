trigger1 = !time
trigger1 = p2dist x < 0

[State 0, var]
type = varset
trigger1 = !time
var(17) = 0

[State 0, ctrl]
type = ctrlset
trigger1 = time = 1
value = 1

[State 0, snd]
type = playsnd
trigger1 = time = 3
value = 0,17
volume = 64


[State 0, end]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

