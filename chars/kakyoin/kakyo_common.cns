;---------------------------------------------------------------------------
;Stand
[Statedef 0]
type = S
movetype = I
physics = S
velset = 0,0
sprpriority = 0

[State 0, anim]
type = changeanim
triggerall = !time
trigger1 = anim = 10050
trigger2 = (anim = [15005,15007]) || (anim = [15015,15017]) || (anim = [15025,15027])
value = 10001

[State 0, anim]
type = changeanim
trigger1 = anim != (0+var(0)) && anim != (1+var(0)) && anim != (5+var(0))
trigger1 = prevstateno != 193
trigger2 = anim = (5+var(0)) && !animtime
value = 0+var(0)

[State 0, end]
type = changestate
trigger1 = !alive
value = 5050

[State 0, end]
type = DestroySelf
trigger1 = IsHelper

;---------------------------------------------------------------------------
;Stand to Crouch
