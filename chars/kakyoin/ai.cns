;Air Jump Start
[Statedef 46]
type = A
physics = N
ctrl = 0
anim = 40+var(0)
velset = 0,0
sprpriority = 0

[State 0, sysvar]
type = varset
triggerall = var(59) = 1
triggerall = var(48) || 1
trigger1 = !time
sysvar(1) = -1;(command = "holdfwd"-command = "holdback")*((p2dist x >= 0)-(p2dist x < 0))

[State 0, turn]
type = turn
trigger1 = !time
trigger1 = p2dist x < 0

[State 0, var]
type = varset
triggerall = var(59) = 1
trigger1 = !time
var(4) = 0

[State 0, var]
type = null;varset
triggerall = var(59) = 1
triggerall = !time
trigger1 = command = "highjump"
var(4) = 1

[State 0, var]
type = varset
triggerall = var(59) = 1
trigger1 = !time
var(5) = 0

[State 0, var]
type = null;varset
triggerall = var(59) = 1
trigger1 = command != "holdup"
var(5) = 1

[State 0, var]
type = varset
trigger1 = !time
var(17) = 1

[State 0, snd]
type = playsnd
trigger1 = time = 1
value = 2,0
channel = 0

[State 0, vel]
type = velset
trigger1 = !animtime
x = ifelse(!sysvar(1),0,ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))*ifelse(var(4)&&(!var(0)||(var(0)&&!var(5))),1.54,1)

[State 0, vel]
type = velset
trigger1 = !animtime
y = const(velocity.jump.y)*ifelse(var(5),.8,1)*ifelse(var(4),ifelse(!var(0),1.12,1.25),1)

[State 0, end]
type = changestate
trigger1 = !animtime
value = 60
ctrl = 1

