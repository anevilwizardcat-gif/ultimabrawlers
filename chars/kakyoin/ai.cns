;------------------------------------------------------------------------------------------
;Jump Start믅륂
[Statedef 35]
type = S
physics = S
ctrl = 0
anim = 40+var(0)
velset = 0,0
sprpriority = 0

[State 0, sysvar]
type = varset
triggerall = var(59) = 1
triggerall = !time
trigger1 = p2bodydist X < 60
trigger1 = random < 100
trigger2 = p2bodydist X >= 60
trigger2 = p2bodydist X < 120 
trigger2 = random < 100
trigger3 = p2bodydist X >= 120
trigger3 = random = [100,300]
sysvar(1) = 0;command = "holdfwd"-command = "holdback"

[State 0, sysvar]
type = varset
triggerall = var(59) = 1
triggerall = !time
trigger1 = p2bodydist X < 60
trigger1 = random > 300
trigger2 = p2bodydist X >= 60
trigger2 = p2bodydist X < 120 
trigger2 = random > 300
trigger3 = p2bodydist X >= 120
trigger3 = random > 300
sysvar(1) = 1;command = "holdfwd"-command = "holdback"

[State 0, sysvar]
type = varset
triggerall = var(59) = 1
triggerall = !time
trigger1 = p2bodydist X < 60
trigger1 = random = [100,300]
trigger2 = p2bodydist X >= 60
trigger2 = p2bodydist X < 120 
trigger2 = random = [100,300]
trigger3 = p2bodydist X >= 120
trigger3 = random < 100
sysvar(1) = -1;command = "holdfwd"-command = "holdback"

[State 0, var]
type = varset
triggerall = var(59) = 1
triggerall = !time
trigger1 = sysvar(1) >= 0
trigger1 = p2bodydist X < 60
trigger1 = random < 500
trigger2 = p2bodydist X >= 60
trigger2 = p2bodydist X < 120
trigger2 = random >= 650 
var(4) = 0

[State 0, var]
type = varset
triggerall = var(59) = 1
triggerall = !time
;trigger1 = prevstateno = 100 || prevstateno = 105
;trigger2 = command = "highjump"
trigger1 = sysvar(1) >= 0
trigger1 = p2bodydist X < 60
trigger1 = random > 500
trigger2 = p2bodydist X >= 60
trigger2 = p2bodydist X < 120
trigger2 = random < 650 
trigger3 = p2bodydist X < 60
trigger3 = random > 500
trigger4 = prevstateno = 100 || prevstateno = 105
var(4) = 1

[State 0, var]
type = varset
triggerall = var(59) = 1
triggerall = !time
trigger1 = p2bodydist X < 60
trigger1 = random >= 250
var(5) = 0

[State 0, var]
type = varset
triggerall = var(59) = 1
;trigger1 = command != "holdup"
trigger1 = sysvar(1) = 0
trigger2 = p2bodydist X < 60
trigger2 = random < 750
trigger3 = p2bodydist X >= 60
trigger3 = random < 500
trigger3 = p2bodydist X < 120
trigger4 = random < 250
trigger4 = p2bodydist X >= 120
trigger4 = p2bodydist X < 180
trigger5 = random < 125
trigger5 = p2bodydist X >= 180 
var(5) = 1

[State 0, vel]
type = velset
trigger1 = !animtime
x = ifelse(!sysvar(1),0,ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))*ifelse(var(4)&&(!var(0)||(var(0)&&!var(5))),1.54,1)

[State 0, vel]
type = velset
trigger1 = !animtime
y = const(velocity.jump.y)*ifelse(var(5),.8,1)*ifelse(var(4),ifelse(!var(0),1.12,1.25),1)

[State 0, end]
type = changestate
trigger1 = !animtime
value = 50
ctrl = 1




