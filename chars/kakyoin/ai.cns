;------------------------------------------------------------------------------------------
;AIWalk믅륂
[Statedef 17]
type = S
physics = S
ctrl = 0
anim = 20+var(0)
sprpriority = 0


[State 0, vel]
type = velset
triggerall = var(59) = 1
trigger1 = vel X = 0
trigger1 = time = 0
trigger1 = random < (p2bodydist X)
trigger2 = vel X > 0
trigger3 = vel X = 0
trigger3 = time = 0
trigger3 = (BackEdgeBodyDist<11) || (p2bodydist X>=210) 
x = const(velocity.walk.fwd.x)

[State 0, vel]
type = velset
triggerall = var(59) = 1
triggerall = BackEdgeBodyDist >= 5
trigger1 = vel X = 0
trigger1 = time = 0
trigger1 = random >= (p2bodydist X)*2
trigger2 = vel X < 0
trigger3 = vel X = 0
trigger3 = time = 0
trigger3 = playerID(var(15)),statetype = L
;trigger1 = command = "holdback"
x = const(velocity.walk.back.x)


[State 0, 믠] 
type = ChangeState 
triggerall = var(59) = 1
trigger1 = movetype != H
trigger1 = vel X = 0 
trigger2 = playerID(var(15)),movetype = A 
trigger2 = playerID(var(15)),HitDefAttr = SCA, NA,SA,HA
trigger2 = p2bodydist X < 80
trigger3 = inguarddist
trigger4 = roundstate != 2
trigger5 = playerID(var(15)),movetype = H
trigger6 = vel X != 0
trigger6 = random < (360 - (p2bodydist X))/12
trigger6 = time > 30
trigger7 = p2dist x < 0
;trigger8 = numhelper(76767) > 0
;trigger8 = helper(76767),InGuardDist
value = 0 
ctrl = 1 



[State 0, anim]
type = changeanim
triggerall = vel x > 0
trigger1 = anim != (20+var(0)) && anim != (5+var(0))
trigger2 = anim = (5+var(0)) && (!animtime)
value = 20+var(0)

[State 0, anim]
type = changeanim
triggerall = vel x < 0
trigger1 = anim != (21+var(0)) && anim != (5+var(0))
trigger2 = anim = (5+var(0)) && (!animtime)
value = 21+var(0)













;------------------------------------------------------------------------------------------
;Walk딳궖뛘귕
[Statedef 18]
type = S
physics = S
ctrl = 0
anim = 20+var(0)
sprpriority = 0

[State 0, vel]
type = velset
triggerall = var(59) = 1
trigger1 = p2bodydist X >60 ;command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 0, vel]
type = velset
triggerall = var(59) = 1
trigger1 = p2bodydist X <=60 ;command = "holdback"
x = const(velocity.walk.back.x)

[State 0, 믠] 
type = ChangeState 
triggerall = var(59) = 1
trigger1 = movetype != H
trigger1 = vel X = 0 
trigger2 = playerID(var(15)),movetype = A 
trigger2 = playerID(var(15)),HitDefAttr = SCA, NA,SA,HA
trigger2 = p2bodydist X < 80
trigger3 = inguarddist
trigger4 = roundstate != 2
trigger5 = p2bodydist X = [58,62]
trigger6 = p2dist x < 0
trigger7 = var(47) = 0
value = 0 
ctrl = 1 


[State 0, anim]
type = changeanim
triggerall = vel x > 0
trigger1 = anim != (20+var(0)) && anim != (5+var(0))
trigger2 = anim = (5+var(0)) && (!animtime)
value = 20+var(0)

[State 0, anim]
type = changeanim
triggerall = vel x < 0
trigger1 = anim != (21+var(0)) && anim != (5+var(0))
trigger2 = anim = (5+var(0)) && (!animtime)
value = 21+var(0)


