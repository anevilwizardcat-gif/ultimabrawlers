; Definition file for Kakyoin
; Contains all the filenames needed for the character
; Sell this in a CD game and you shall suffer wrong death!
; The latest version of Setsuna is always found at http://rotb.cjb.net
; and other mirror affiliates.

; Player information
[Info]
name         = "Noriaki Kakyoin"       ;The name of this l33t character.
versiondate  = 04,03,2001      ;Version date of character
mugenversion = 04,14,2001      ;Version of M.U.G.E.N character works on
author       = "Orochi Herman" ;l33t Character author name
;pal.defaults = 4,5,6,1,2,3     ;Default palettes in order of preference
pal.defaults = 2,5,6,1,2,3     ;Default palettes in order of preference
original.creator   = "CAPCOM"
converter.homepage = "http://rotb.mgbr.net"

; Files for the player
[Files]
cmd      = kakyoin.cmd      ; L33t Capcomized button layout.
cns      = kakyoin.cns      ; Constants
st       = kakyoin.cns      ; States
st1      = stand.cns   ; Heirophant Green State
st2      = constant.cns     ; State -2 data
st3      = override.cns     ; Data overriden from common1.cns
st4      = supers.cns       ; Super moves
st5      = misc.cns         ; lose portrait code
st6      = kakyoin.ai       ; Custom AI settings
stcommon = common1.cns      ; Common states (in data/)
sprite   = kakyoin.sff      ; Sprite
anim     = kakyoin.air      ; Animation
sound    = kakyoin.snd      ; Sound
ai       = ai.ai
pal1     = original.act     ; Original Pallete
pal2     = anime.act    ; Original Alternate
pal3     = evilscientist.act     ; Original Pallete
pal4     = blueice.act    ; Original Alternate
pal5     = gouki.act     ; Original Pallete
pal6     = original.act    ; Original Alternate
pal7     = anime.act     ; Original Pallete
pal8     = evilscientist.act    ; Original Alternate
pal9     = blueice.act     ; Original Pallete
pal10     = gouki.act    ; Original Alternate
pal11     = original.act     ; Original Pallete
pal12     = anime.act    ; Original Alternate
;pal6     = speed1.act       ; Speed 1st Color
;pal1     = speed2.act       ; Speed 2nd Color
;pal2     = ex1.act          ; EX 1st Color
;pal3     = ex2.act          ; EX 2nd Color
;pal7     = ebony.act        ; Black and White, but much craftier..:P
;pal8     = rose.act         ; Deep red and Blue color!!
;pal9     = kewl.act         ; Kewl-ishly Khaki!
;pal10    = Kakyoin.act      ; HAIROPANTO GURINN!!!
;pal11    = colorful.act     ; Technicolor!
;pal12    = mono.act         ; Black and White!

;Variable Utilization Tally

; Var(0) = Randomizer for intro.
; Var(1) = Used for randomizing winposes
; Var(2) = Used for randomizing stances, tauntposes and some stuff.
; Var(3) = Dedicated variable for taunt poses
; Var(4) = Stores animation used, to return when turning
; Var(5) = Heirophant Green SinAdd simulator
; Var(6) = Determines Play Mode by Button Selection:
;		   0 = Crossover Mode (aka. Catalyst Mode)
;		   1 = JoJo's Venture Mode
;		   2 = JoJo's Bizarre Adventure Mode
;		   3 = New Kakyoin JoJo's Venture Mode
;		   4 = New Kakyoin JoJo's Bizarre Adventure Mode
;		   5 = Custom Mode (Special Settings based on Kakyoin.AI)
; Var(7) = Forced Play Mode Implementor via Kakyoin.AI
;		   0 = Selection dependent on Button Press
;		   1 = Permanent Catalyst Mode	
;		   2 = JoJo's Venture Mode
;		   3 = JoJo's Bizarre Adventure Mode
;		   4 = New Kakyoin JoJo's Venture Mode
;		   5 = New Kakyoin JoJo's Bizarre Adventure Mode
;		   6 = Custom Mode (Special Settings based on Kakyoin.AI)
;		   7 = Randomize, becomes your permanent selection for the whole game
;		   8 = Randomize, changes every match set
; Var(8) = Determines Button Layout by Button Selection:
;		   0 = Catalyst 6-button Layout
;		   1 = Original 4-button Layout	
; Var(9) = Forced Button Layout via Kakyoin.AI:
;		   0 = Determined by Playmode used. (Not applicable to Custom Mode)
;		   1 = Always Catalyst 6-button Layout
;		   2 = Always Original 4-button Layout
;		   3 = Randomize, becomes your permanent selection for the whole game
;		   4 = Randomize, changes every match set
; Var(10) = Heirophant Green SinAdd simulator (secondary)
; Var(11) = Mystic trap X switch; tells which commannd launched it.
; Var(12) = JoJo Super Screen Control (Super Screens, KO chimes, etc)
;		   0 = JoJo's Bizarre Adventure super screen
;		   1 = JoJo's Venture super screen
; Var(13) = Forced Super Screen setting via Kakyoin.AI:
;		   0 = Determined by Playmode used. (Not applicable to Custom Mode)
;		   1 = Always JoJo's Bizarre Adventure
;		   2 = Always JoJo's Venture
;		   3 = Randomize, becomes your permanent selection for the whole game
;		   4 = Randomize, changes every match set
;		   5 = Randomize, changes all the time
; Var(14) = Rolling getup (crossover mode only)
;		   0 = Enabled
;		   1 = Disabled
; Var(15) = Forced Rolling Getup setting via Kakyoin.AI:
;		   0 = Determined by Playmode used. (Not applicable to Custom Mode)
;		   1 = Enabled
;		   2 = Disabled
;		   3 = Randomize, becomes your permanent selection for the whole game
;		   4 = Randomize, changes every match set
; Var(16) = Animation Quality
;		   0 = Enhanced
;		   1 = Original JoJo's Venture
;		   2 = Original JoJo's Bizarre Adventure
; Var(17) = Animation Quality setting via Kakyoin.AI:
;		   0 = Determined by Playmode used. (Not applicable to Custom Mode)
;		   1 = Enhanced
;		   2 = Original JoJo's Venture
;		   3 = Original JoJo's Bizarre Adventure
;		   4 = Randomize, becomes your permanent selection for the whole game
;		   5 = Randomize, changes every match set
;		   6 = Randomize, changes all the time
; var(18) = KO Sound echo
; Var(19) = Mystic trap Y switch; tells which commannd launched it.
; Var(20) = Mystic trap Z switch; tells which commannd launched it.
; Var(21) = Stand Mode indicator
;			0 = Stand is Inactive
;			1 = Active Stand Mode
;			2 = Remote Stand Mode
;			3 = Tandem Attack
; Var(22) = Movehit counter for emerald splashes.
; Var(23) = Moveguarded counter for emerald splashes.
; Var(24) = Stand Mode Indicator
;			0 = Inactive Mode
;			1 = Active Mode
;			2 = Active Remote Mode
;			3 = Tandem Attack Mode
; Var(25) = Indicates a presence of a Stand during inactive mode, which
;			disables special moves/certain basic attacks.
;			0 = Flag OK - can perfrom
;			1 = Stand attack detected, cannot be done.
; Var(26) = Screen Language (SFX, win)
;		   0 = English
;		   1 = Japanese
; Var(27) = Screen Language (SFX, win)
;		   0 = English
;		   1 = Japanese
;		   2 = Randomize, becomes your permanent selection for the whole game
;		   3 = Randomize, changes every match set
;		   4 = Randomize, changes all the time

; FVar(1) = Super Screen X scaler
; FVar(2) = Heirophant Green Scaler
; FVar(3) = Y Velocity marker
; FVar(4) = Super Screen Y scaler
; FVar(5) = Stand Scaling (Dissapear effect) X
; FVar(6) = Stand Scaling (Dissapear effect) Y
; FVar(7) = Scaler for winko duration.

; SysVar(0) = Special Purposes within common1.cns
; SysVar(1) = Special Purposes within common1.cns
; Sysvar(2) = Jump handling for override.cns
; SysVar(3) = Ditch limit. (delaying variable)
; SysVar(4) = India's Arm Variation Marker.

; COmmon Helper Variable Usage:

; Stand Basic Attacks:
;
; var(0) = randomizer, in 20m Emerald Splash
; var(1) = Sprite Priority marker which is also followed by the extension helper.
; var(5) = used as randomizer in Heirophant Finish
; var(10) = Animation Element of the main helper, used for parsing by the extension helper.
; var(11) = An incrementing variable used to play guarding sound.
; var(12) = An incrementing variable used to play hitsounds.
; var(18) = Hitsound value, used cascadingly thoughout helpers.
;
; fvar(0) = Stand scaling X axis
; fvar(1) = Stand scaling Y axis
;
; Sysvar(0) = Tells the helperID to the extension helper, so that it will check if this helper still exists.
