; HIT_GETUP
[Statedef 5120]
type    = L
movetype= I
physics = N
velset = 0,0,0

[State 5120, 0] ; Sneak Roll Backwards for Back
type = ChangeState
triggerall = anim != 5111
triggerall = time <= 1;5
trigger1 = command = "holddownback"
trigger2 = command = "holdback"
value = 5122

[State 5120, 1] ; Sneak Roll Forwards for Back
type = ChangeState
triggerall = anim != 5111
triggerall = time <= 1;5
trigger1 = command = "holddownforward"
trigger2 = command = "holdfwd"
value = 5123

[State 5120, 0] ; Sneak Roll Backwards for Up
type = ChangeState
triggerall = anim = 5111
triggerall = time <= 1;5
trigger1 = command = "holddownback"
trigger2 = command = "holdback"
value = 5124

[State 5120, 1] ; Sneak Roll Forwards for Up
type = ChangeState
triggerall = anim = 5111
triggerall = time <= 1;5
trigger1 = command = "holddownforward"
trigger2 = command = "holdfwd"
value = 5125

[State 5120, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 5120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 5120, 2]
type = VelSet
trigger1 = Time = 0
x = 0

[State 5120, 3]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 5120, 4]
type = CtrlSet
trigger1 = AnimTime = 0
value = 1

[State 5120, 5]
type = HitFallSet
trigger1 = AnimTime = 0
value = 1

[State 5120, 6] ;Can't be thrown right after getting up
type = NotHitBy
trigger1 = AnimTime = 0
value = , NT,ST,HT
time = 12

[State 5120, 6] ;Can't be hit right after getting up (short time)
type = NotHitBy
trigger1 = AnimTime = 0
value2 = SCA
time = 3

[state haha]
type = turn
trigger1 = anim = 5120
trigger1 = animelem = 6
trigger1 = p2dist x < 0
ignorehitpause = 1

[State 5120, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 11 + (command != "holddown")
ctrl = 1
