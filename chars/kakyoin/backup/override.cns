;---------------------------------------------------------------------------l
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

; Stand
[Statedef 0]
type = S
physics = S
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = ctrl = 0
value = SCA
time = 1

[state haha]
type = posset
trigger1 = pos Y > 0
y = 0

[state hehe]
type = varset
trigger1 = anim = [90,94]
trigger2 = anim = 201
trigger3 = anim = 231
trigger4 = anim = 2500
var(4) = anim

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Time = 0
trigger1 = anim != [90, 94]
trigger1 = anim != 201
trigger1 = anim != 231
trigger1 = anim != 2500
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
;trigger3 = (Anim = 1 || Anim = 2) && animtime = 0 && var(2) = [0,4]
value = var(4)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State Randomizer]
type = Varrandom
trigger1 = Time >= 0
v = 2
range = 2

[State Animation 1, Chosen the same ani]
type = ChangeAnim
;trigger1 = (Anim = 0 || Anim = 2) && animtime = 0
;trigger1 = var(2) = [5,9]
;value = 1
trigger1 = (anim = [0,2]) && animtime = 0
value = var(2)

;[State Animation 1, Chosen the same ani]
;type = ChangeAnim
;trigger1 = (anim = 1 || Anim = 0) && Animtime = 0
;trigger1 = var(2) = [10,14]
;value = 2

; Walk
[Statedef 20]
type    = S
physics = S

[State 0, 2]
type = VelSet
trigger1 = 1
y = 0

[State 0, 2]
type = VelSet
trigger1 = anim = 5 || anim = 6
x = 0

[State 0, 2]
type = PosSet
trigger1 = 1
y = 0

[State 0, 2]
type = null;ChangeAnim
triggerall = time = 0
trigger1 = anim = [25,27]
trigger1 = p2dist X < 0
value = 5

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger1 = anim != 5 || anim != 6
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
trigger1 = anim != 5 || anim != 6
x = const(velocity.walk.back.x)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0 && command = "holdback" ;&& prevstateno != 1205
trigger1 = Anim != 21 && Anim != 5 && anim != 22 && Anim != 26 && Anim != 27
trigger2 = Anim = 5 && AnimTime = 0
trigger3 = Anim = 4 && AnimTime = 0
trigger4 = (anim = [26,27]) && animtime = 0
value = 21 + ((var(16) = 1) * (random >= 500)) + (5 * (var(16) = 1))

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0 && command = "holdfwd"
trigger1 = Anim != 20 && Anim != 5 && Anim != 25
trigger2 = Anim = 5 && AnimTime = 0
value = 20 + (5 * (var(16) = 1))

[state 20, 5, safeguard]
type = null;ChangeAnim
trigger1 = prevstateno = 1205 && anim = 5 && numhelper(1205) = 1
trigger1 = vel X != 0 && (command != "holdfwd" || command != "holdback")
value = 0

; RUN_FWD
[Statedef 100]
type    = S
physics = N
anim = 100
ctrl = 0
velset = const(velocity.run.fwd.x),0

[State 1500, 2]
type = AssertSpecial
trigger1 = 1
flag = nowalk
flag2 = noautoturn

[state haha]
type = assertspecial
trigger1 = 1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
ignorehitpause = 1

[state haha]
type = varset
trigger1 = 1
sysvar(2) = 2

[State 1500, 2]
type = PosAdd
trigger1 = backedgedist = -194
x = 180
persistent = 0

[state 100, velset]
type = velset
trigger1 = backedgedist > 0 && anim = 101
x = 0

[State 100, 83]
type = Changestate
triggerall = backedgedist > 0 && anim = 100
trigger1 = time <= 25 && command != "holdfwd"
trigger2 = time >= 30
value = 101

[State 183, 1]
type = PlayerPush
trigger1 = 1 && backedgedist < -1
value = 0
time = 999

[State haha]
type = VarSet
trigger1 = Command = "holdfwd"
sysvar(1) = 1

[State haha]
type = VarSet
trigger1 = Command = "holdfwd"
sysvar(2) = 1

[State haha]
type = VarSet
trigger1 = Command = "holdback"
sysvar(2) = -1 ;0

[State haha]
type = ChangeState
trigger1 = Command = "holdup"
value = 40
;ctrl = 1

[State haha]
type = VarSet
trigger1 = Time = 0
sysvar(4) = 0

