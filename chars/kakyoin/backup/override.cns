[state haha]
type = posset
trigger1 = pos Y > 0 && GetHitVar(animtype) != [3,5]
y = 0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype) + (P2StateType = c * ifelse((GetHitVar(animtype) = [0,1]), 1, 2))

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 3] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0 && gethitvar(animtype) = [3,5]
value = anim

[State 5000, 4] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 && GetHitVar(fall)
trigger2 = Pos Y != 0
value = a

[State 5000, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5001 ;HITG_SLIDE

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 5001]
type    = S
movetype= H
physics = S

[State 5001, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5001, 2]
type = ChangeAnim
triggerall = AnimTime = 0 
trigger1 = Anim = [5000, 5004]
trigger2 = Anim = [5010, 5014]
trigger3 = Anim = [5020, 5024]
value = Anim + 5

[State 5001, 2]
type = ChangeAnim
triggerall = AnimTime = 0 
trigger1 = Anim != [5000, 5029]
;trigger1 = Anim != [5010, 5014]
;trigger1 = Anim != [5020, 5024]
value = 5005 + GetHitVar(animtype) + ((GetHitVar(groundtype) = 2) * 10)

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 5001, 6]
type = SelfState
trigger1 = HitOver
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0 && pos Y >= 0 ;45
;trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 25, 35)
value = 5100 ;HIT_BOUNCE former value = 0,25

;---------------------------------------------------------------------------
; HIT_TRIP (shaking)
[Statedef 5070]
type    = U
movetype= H
physics = N
velset = 0,0

[State 5070, 1]
type = ChangeAnim 
trigger1 = 1
value = 5070

[state haha]
type = posset
trigger1 = statetype != A
y = 0

[State 5070, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 5071

[State 5070, 3]
type = ForceFeedback
trigger1 = time = 0
time = 12
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HIT_TRIP2 (fall through air)
[Statedef 5071]
type    = U
movetype= H
physics = N

[State 5071, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = (statetype = A)

[State 5071, 2] ;Acceleration
type = VelAdd
trigger1 = (statetype = A)
y = GetHitVar(yaccel)

[State 5071, 3] ;Hit ground
trigger1 = statetype = A
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0;45
trigger2 = statetype != A
trigger2 = animtime = 0
type = ChangeState
value = 5110

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S
;anim = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State Randomizer]
type = Varrandom
trigger1 = 1
v = 2
range = 0, 2

[State Animation 1, Chosen the same ani]
type = ChangeAnim
trigger1 = (Anim = [0,2]) && animtime = 0
value = var(2)

; The following is coding grafted from VK.
[State 190, 2] ; Vs Gill (Boss Intro)
type = ChangeState
;trigger1 = RoundNo = 1 && Facing = 1
triggerall = !teammode = turns
;triggerall = RoundNo = 1 && MatchNo != 1 && !IsHomeTeam
triggerall = RoundNo = 1 && !IsHomeTeam
trigger1 = NumEnemy = 1
trigger1 = Enemy(0), Name = "Gill" && Enemy(0), IsHomeTeam && Enemy(0), NumPartner = 0
trigger2 = NumEnemy = 2
trigger2 = Enemy(0), Name = "Gill" && Enemy(0), IsHomeTeam && Enemy(0), NumPartner = 0
trigger3 = NumEnemy = 2
trigger3 = Enemy(1), Name = "Gill" && Enemy(1), IsHomeTeam && Enemy(1), NumPartner = 0
value = 55087719

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 1
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 1
fvalue = 0

[State 5900, 3] ;Intro
type = ChangeState
trigger1 = roundno = 1
trigger2 = RoundsExisted = 0
trigger2 = TeamMode = Turns
trigger2 = RoundNo > 0
value = 190

;---------------------------------------------------------------------------
; HITA_RECOV (recovering in air, not falling)
[Statedef 5040]
type    = A
movetype= H
physics = N

[State 5040, 1]
type = ChangeState
trigger1 = !Alive
value = 5050

[State 5040, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim != 5040
trigger2 = Time = 0
trigger2 = Anim != 5035
value = 5040

[State 5040, 3]
type = CtrlSet
trigger1 = HitOver
value = 1

[State 5040, 4]
type = StateTypeSet
trigger1 = HitOver
movetype = I

[State 5040, 5]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = alive
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 5040, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMPLAND

; Collapse
[Statedef 5130]
type = S
movetype = H
physics = S
anim = 5130

[State haha]
type = DefenceMulSet
trigger1 = 1
value = 1
ignorehitpause = 1

; Insert bits of coding here, including hurt sound, or whatever

[State 2012, Go to 2014 if not on ground]
type = ChangeState
Trigger1 = anim = 5130
trigger1 = animtime = 0
value = 5131

; Collapse (lying Down)
[Statedef 5131]
type = L
movetype = H
physics = C
anim = 5131

[State 2013, Change animation to Lying down on face]
type = ChangeAnim
;trigger1 = !animexist(5130)
;trigger1 = !animexist(5131)
trigger1 = Anim = 5131
trigger1 = AnimTime = 0
value = IfElse(SelfAnimExist(5111), 5111, 5110)

[State 5081, 3] ;Don't show hit ground frame
type = VarSet
trigger1 = Time = 0
sysvar(0) = 1

[State 5110, 6]
type = PlaySnd
trigger1 = animelem = 4
value = F7, 1

[State 5110, 7]
type = GameMakeAnim
trigger1 = animelem = 4
value = 61
pos = 0, 0
under = 1

[State 1281, 3]
type = ChangeState
trigger1 = Anim = [5110,5111]
value = 5110 + IfElse(Alive, 0, 40) ;;HIT_BOUNCE