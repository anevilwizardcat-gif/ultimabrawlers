type    = S
physics = S
;ctrl = ifelse((p2movetype = H && (p2stateno != [5050, 5999])), 1, 0)
ctrl = 1
velset = 0,0
facep2 = 1 * (anim = 43)

[state heh]
type = turn
trigger1 = anim = 43
persistent = 0

[state heh]
type = turn
trigger1 = anim = 48 && animelem = 17 && p2dist X < 0
trigger2 = anim = 49 && animelem = 16 && p2dist X < 0
persistent = 0

[State 52, 0]
type       = PlaySnd
trigger1   = Time = 0 ;&& anim = 44
;trigger2   = time = 2 && anim = 48
;trigger3   = Time = 0 && anim = 47
value      = S0,16
;persistent = 0

;[state haha]
;type = assertspecial
;trigger1 = anim =47
;trigger1 = animelemno(0) = [1,7]
;flag = nowalk
;ignorehitpause = 1

;[state haha]
;type = velset
;triggerall = p2dist X < 0
;trigger1 = (anim = 41 || anim = 44 || anim = 2041)
;trigger2 = anim = 47
;trigger3 = anim = 460
;x = 0

[state haha]
type = changestate
triggerall = var(6) != 0
triggerall = p2dist X < 0
trigger1 = (anim = 41 || anim = 44 || anim = 2041)
trigger2 = anim = 47
trigger3 = anim = 460
trigger4 = anim = 42 
;trigger5 = anim = 43 ;&& pos Y >= 23 && vel Y >= 0
value = 0
ctrl = (RoundState <= 3)

[state hah]
type = assertspecial
trigger1 = 1
flag = noautoturn
ignorehitpause = 1

[state 1, hehe]
type = changeanim
trigger1 = time = 0
trigger1 = anim = 44
value = 47
persistent = 0

;[state haha]
;type = velset
;trigger1 = time = 3
;trigger1 = anim = 47
;trigger2 = (anim = 42 || anim = 43) && time = 2
;x = 0
;y = 0
;persistent = 0

[state 1, hehe]
type = changeanim
triggerall = time = 0
trigger1 = anim != [42, 48]
trigger2 = anim = 5040
value = 47

[state 1, hehe]
type = changeanim
trigger1 = (anim = 42 || anim = 43) && time = 0
value = 48 + var(16)
ctrl = 1

;[State 52, 1]
;type = VelSet
;triggerall = Time = 0
;trigger1 = anim = 41 || anim = 44 || anim = 2041
;trigger2 = anim = 47
;trigger3 = anim = 460
;y = 0

;[State 52, 1]
;type = VelSet
;triggerall = Time = 0
;trigger1 = anim = 41 || anim = 44 || anim = 2041
;trigger2 = anim = 47
;trigger3 = anim = 460
;x = 0

;[state secondary]
;type = velset
;triggerall = pos Y >= 23
;trigger1 = anim = 48
;t;rigger2 = anim = 43
;y = 0

[State 52, 3]
type = PosSet
trigger1 = Time = 0
;trigger1 = anim = 41 || anim = 44 || anim = 2041
;trigger2 = anim = 47
;trigger3 = anim = 460
y = 0

;[state secondary]
;type = posset
;triggerall = pos Y >= 23 && vel Y >= 0
;trigger1 = anim = 48
;trigger2 = anim = 43
;y = 0

;[State 52, 3]
;type = null;CtrlSet
;trigger1 = anim = 48 && animelem = 2
;value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0 && ((anim = [47,49]) || anim = 5)
value = 0
ctrl = (RoundState <= 3)

;[state extra]
;type = null;posadd
;trigger1 = anim = 48 && animelem = 1
;x = 15

[State 52, 4]
type = ChangeState
trigger1 = command = "holddown" && animelem >= 9
value = 11
ctrl = (roundstate = 2)

[State 52, 4]
type = ChangeState
trigger1 = command = "holdup" ;&& animelem >= 9
value = 40
ctrl = (roundstate = 2)

[State 52, 4]
