var(0) = 7

[State 4900, 7]
type = Varset
trigger1 = var(0) = 8
var(0) = 0

[State 4900, 7]
type = VarAdd
triggerall = var(0) = 0
triggerall = var(40) < 3
trigger1 = command = "bl1"&&root,facing = 1
trigger2 = command = "bl3"&&root,facing = -1
V = 40
Value = 1

[State 4900, 7]
type = VarAdd
triggerall = var(0) = 0
triggerall = var(40) > 0
trigger1 = command = "bl3"&&root,facing = 1
trigger2 = command = "bl1"&&root,facing = -1
V = 40
Value = -1

