;簡易システムディレクション
;項目えらい少ないけど、まあわざわざマイナス要素にする人も
;少ねーだろってことでこんな感じ。
[Statedef 9000]
type = S
anim = 1
velset = 0,0
sprpriority = 5
ctrl = 0

[State 200, 1]
