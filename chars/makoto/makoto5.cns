trigger2 = command = "bl3"
value = 0, 4
channel = 0

[State 200, 1]
type = PlaySnd
trigger1 = command = "bl2"
value = 0, 0
channel = 0

[State 200, 1]
type = PlaySnd
trigger1 = command = "up"
value = 0, 2
channel = 0

