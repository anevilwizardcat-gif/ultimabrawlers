;ピヨリエフェクト
[Statedef 6700]
type    = S
movetype= I
physics = N
anim = 1

[State -2,ランダム]
type = VarRandom
trigger1 = time = 0
v = 0
range = 0,3

[State -2, 0];スタン時
type = Explod
triggerall = NumExplod(6700) = 0
trigger1 = time = 0
anim = 6700+var(0)
id = 6700
pos = 0,-20
postype = p1
sprpriority = 5
facing = 1
bindtime = -1
ownpal = 1
removetime = 99999
ignorehitpause = 1

[State -2, 0]
type = RemoveExplod
trigger1 = NumExplod(6700) != 0
trigger1 = p2stateno != 15300
id = 6700
ignorehitpause = 1

[State 210, 1]
type = PlaySnd
triggerall = time%18 = 0
trigger1 = var(0) = 0
trigger2 = var(0) = 3
value = 7, 2

[State 210, 1]
type = PlaySnd
triggerall = time%38 = 0
trigger1 = var(0) = 1
value = 7, 3
channel = 1

[State 6410,3]
type = BindToParent
trigger1 = 1
pos = (parent,p2dist x),(parent,p2dist y + (enemy,const(size.head.pos.y)))
time = 1

[State 6400, 7]
type = DestroySelf
trigger1 = p2stateno != 15300
