Ground.HitTime  = 17                                    ;コンボが繋がる時間（高くしすぎない事）
Ground.Velocity = 5,-4                                   ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
Air.Type = Trip                                          ;空中で相手がくらった場所（上と同じ）
