	type = ChangeState
	trigger1 = sysvar(0)
	trigger1 = command = "holdback"
	trigger1 = inguarddist
	value = 130

[State 0]
	type = ChangeState
	trigger1 = sysvar(0)
	value = 52

[State 0]
	type = ChangeState
	trigger1 = command != "holdback"
	trigger2 = !inguarddist
	value = 140

