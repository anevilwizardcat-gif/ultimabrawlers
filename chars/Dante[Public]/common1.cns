;--------------------------------------------------------------
; AirJump Start (No AirJump)
[Statedef 45]
type = A
physics = N
ctrl = 0
velset = 0,0
power >= 1000

[State 0]
	type = ChangeAnim
	trigger1 = SelfAnimExist(44)
	value = 44

[State 0]
	type = ChangeAnim
	trigger1 = !SelfAnimExist(44)
	value = 41

[State 0]
	type = VarSet
	trigger1 = Time = 0
	sysvar(1) = 0

[State 0]
	type = VarSet
	trigger1 = command = "holdfwd"
	sysvar(1) = 1

[State 0]
	type = VarSet
	trigger1 = command = "holdback"
	sysvar(1) = -1

[State 0]
	type = VelSet
	trigger1 = Time = 2
	x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
	y = const(velocity.airjump.y)

[State 0]
	type = ChangeState
	trigger1 = Time = 2
	value = 50
	ctrl = 1


