physics = S
anim = 40
ctrl = 0

[State 0]
	type = VarSet
	trigger1 = time = 0
	sysfvar(1) = 1 

[State 0]
	type = VelSet
	trigger1 = AnimTime = 0
	x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
	y = const(velocity.runjump.y)

[State 0]
	type = ChangeState
	trigger1 = AnimTime = 0
	value = 50
	ctrl = 1

;-----------------------------
[Statedef 43] ;ï
type = S
physics = S
anim = 40
ctrl = 0

[State 0]
	type = VarSet
	trigger1 = time = 0
	sysfvar(1) = Ifelse(sysvar(4) != 2, 3, 0)

[State 0]
	type = VelSet
	trigger1 = AnimTime = 0
	x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
	y = Ifelse(sysfvar(1) = 3, - Const(movement.yaccel) / 0.50 * 6.66, const(velocity.jump.y))

[State 0]
	type = ChangeState
	trigger1 = AnimTime = 0
	value = 50
	ctrl = 1



