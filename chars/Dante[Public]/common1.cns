[Statedef 48]   ; Jump Start
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
velset = 0, 0

[State 0]
	type = VelSet
	trigger1 = AnimTime = 0
	x = Ifelse(command = "holdfwd", 2 , Ifelse(command="holdback", -2, 0))
	y = - Const(movement.yaccel) / 0.50 * 6.24

	;*å≤
	;	(1): Const(movement.yaccel) / 0.50 * 6.24
	;	(2): Const(velocity.runjump.y) / 1.25

[State 0]
	type = ChangeState
	trigger1 = AnimTime = 0
	value = 58
	ctrl = 0




