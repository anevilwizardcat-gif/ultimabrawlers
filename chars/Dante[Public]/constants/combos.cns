[state -2]; Swordplay mode
type = Varset
triggerall = (stateno = 200 || stateno = 210 || stateno = 220 || stateno = 230 || stateno = 240 || stateno = 2440 || stateno = 400 || stateno = 410 || stateno = 420 || stateno = 430 || stateno = 600 || stateno = 610 || stateno = 620 || stateno = 630)
