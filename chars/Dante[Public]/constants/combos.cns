v =  2
value = 1

[state -2]; Swordplay mode
type = Varset
trigger1 = stateno = 710
v =  2
value = 1

[state -2]; Freehand mode
type = Varset
triggerall = (stateno = 300 || stateno = 310 || stateno = 320 || stateno = 330 || stateno = 500 || stateno = 510 || stateno = 520 || stateno = 341)
trigger1 = time = 0
trigger2 = stateno = 341
v = 2
value = 0

[state -2]; change from Freehand to Swordplay modes and vice versa.
type = varset
triggerall = (stateno = 0 ||stateno = 20 || stateno = 100 || stateno = 105 || stateno = 40 || stateno = 45 || stateno = 50 || stateno = 51 || stateno = 52 || stateno = 11 || stateno = 5520 || stateno = 240 || Movetype = H) || stateno = (130,155] 
trigger1 = command = "y"
v = 2
value = ifelse(var(2) = 0,1,0)

[State -2]; Plays A sound to indicate that the style of fighting just changed.
