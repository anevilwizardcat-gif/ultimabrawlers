;-------------------------------------------------------
;The variables below are to detect if hiryu won a round 
;or not in order for the panther to activate its 
;self destruction sequence.
;-------------------------------------------------------

;--------------------------------------------------------
;Below are the states to make Hiryu react on his own and 
;make the panther engage it's self destruct sequence.
;--------------------------------------------------------

;----------------------------------------------------------------------
;Dramatic Knockout Game Effect. SFIII, ROTD like.
;----------------------------------------------------------------------
[State -2]
type = Pause
trigger1 = var(1) = 1 
time = 70
ignorehitpause = 1

[State -2]
type = VarAdd
triggerall = (winko) 
trigger1 = time > 0  
v =  1
value = 1

[State -2]
type = Varset
triggerall = (!winko)
trigger1 = time = 0
v =  1
value = 0
ignorehitpause = 1

[State -2];pause trigger remedy, based on Flowagirls custom music coding from his open source code docs.
type = Helper  
trigger1 = var(1) = 1
helpertype = Normal
id = 77777
pos = 0,900
postype = p1
facing = -1
stateno = 77777
keyctrl = 0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999
ignorehitpause = 1
;----------------------------------------------------
[State -2 ];dramatic hit before death move states
type = Pause
trigger1 = Var(6) = 1 
time = 100

[State -2]
type = VarAdd
triggerall = roundno != 1
triggerall = (p2life <=3 && p2movetype = H) && (!win = 1)
trigger1 = time > 0
v = 6
value = 1

[State -2 ]
type = Varset
triggerall = roundno != 1
triggerall = (p2life = 0 && !p2movetype = H) && (winko);(!p2life <=3 && !p2movetype = H) && (!win = 1)
trigger1 = time = 0
v = 6
value = 0
ignorehitpause = 1

[State -2];edited from Flowagirls custom music coding from his open source code docs.
type = Helper
trigger1 = Var(6) = 1 
helpertype = normal
ID = 77778
pos = 0,-9999
postype = p1
facing = -1
stateno = 77778
pausemovetime = 99999
supermovetime = 99999

[State -2]
type = Helper
trigger1 = Var(6) = 1 
ID = 9010 
pos = 160, -140
postype = left
stateno = 9010
helpertype = normal
keyctrl = 0
ownpal = 1
pausemovetime = 99999
supermovetime = 99999

[State -2]
type = PlaySnd
trigger1 = Var(6) = 1
value = s20,0
volume = 100
channel = 5

[State -2]
