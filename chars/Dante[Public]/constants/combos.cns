;------------------------------------------------------------------
; Combo Damage Dampener (Values are applied in the hitdef,
; The code below is to reset the dampener), Thanks to GohanSSM2,
; O'Illusionista, Reu, And Mr. Fong for helping me figure this out.
;------------------------------------------------------------------
[State -2]; Dampener Reset
type = varset
triggerall = p2movetype != H
triggerall = Var(13) != 0
trigger1 = p2stateno != [5000,5999]
trigger2 = p2stateno = 5120
trigger3 = p2stateno = [5200,5220]
v = 13
value = 0
ignorehitpause = 1
persistent = 0

