trigger1 = p2life = 0
value = s20,0
volume = 100
channel = 5
;---------------------------------------------------------------------------------
; Death Move states taken from Chong Wong open source fatality codes.
; Most of them are edited to my likings, with additional codes created by myself.
;---------------------------------------------------------------------------------
[State -2]
type = AssertSpecial
trigger1 = P2Life <= 1 && RoundNo != 1 && (!win = 1)
flag = noshadow
flag2 = nobardisplay
ignorehitpause = 1

[State -2, 0] 
type = varset
trigger1 = Win = 1
v = 59 
value = 1

[State -2, 1] 
type = varset
trigger1 = Win = 1
trigger1 = p2life != 0
v = 59 
value = 0

[State -2, 5] 
type = AttackMulSet
triggerall = !Var(59) && p2life <= 1
trigger1 = RoundNo != 1 && Win=0
trigger2 = p2stateno = 987123
value = 9999

[State -2]
type = Explod
trigger1 = var(6) = 1 
anim = 9011
ID = 9011
pos = -154,100
postype = right
facing = 1
bindtime = -1
pausemovetime = 99999
sprpriority = 4
