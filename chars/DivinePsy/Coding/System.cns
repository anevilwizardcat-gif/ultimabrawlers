;-------------------------------------------------------------
;INITIALIZE
[Statedef 5900]
type = S

[State 5900, Varreset]
type = varrangeset
trigger1 = !roundsexisted
value = 0

[State 5900, Varreset]
type = varrangeset
trigger1 = !roundsexisted
fvalue = 0

[State 5900, Intro vs Infinite's Cable]
type = ChangeState
trigger1 = NumEnemy
trigger1 = !RoundsExisted && !(Enemy,RoundsExisted)
trigger1 = !(TeamMode = Simul) && !(Enemy,TeamMode = Simul)
trigger1 = Enemy,Name = "Cable" && Enemy,AuthorName = "Infinite"
value = 198

[State 5900, Turns Intro]
type = ChangeState
trigger1 = TeamMode = Turns
trigger1 = !RoundsExisted && RoundNo >= 2
value = 6900

[State 5900, Intro Decider]
type = ChangeState
trigger1 = RoundNo = 1
value = 190 + (random%3)

[State 5900, End]
type = ChangeState
trigger1 = 1
value = 0

