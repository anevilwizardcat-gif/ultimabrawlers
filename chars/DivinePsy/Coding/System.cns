; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, Voice]
type = PlaySnd
trigger1 = AnimElem = 2
value = 5950, 0
channel = 0

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, win quote]
type = VictoryQuote
trigger1 = !time
value = 1 + (random % 10)
persistent = 0

[State 180, win quotes (perfect)]
type = VictoryQuote
trigger1 = Life = LifeMax
value = 30 + (random % 2)

[State 180, win quotes (low life)]
type = VictoryQuote
trigger1 = Life <= 150
value = 40 + (random % 2)

[State 180, win quotes vs. other Psylockes]
type = VictoryQuote
trigger1 = Enemy, Name = "Psylocke" || Enemy, Name = "Psylocke" && Enemy, AuthorName = "DivineWolf" || Enemy, Name = "CVS Psylocke"
value = 50 + (random % 2)

[State 180, 1]
type = ChangeState
trigger1 = !Time 
value = 181 + (random % 3)

