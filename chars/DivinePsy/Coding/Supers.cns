;======================<PSI-THRUST>===================
[Statedef 3000]
type    = S
movetype= A
physics = N
velset = 0,0
ctrl = 0
anim = 3000
poweradd = ifelse(var(20) > 0, 0, -1000)
sprpriority = 2
facep2 = 1

[State 3000, NotHitBy]
type = NotHitBy
trigger1 = AnimElemTime(4) < 0
time = 1
value = SCA

[State 3000, No Corner Push]
type = VarSet
trigger1 = Time = 3
fvar(5) = 0

[State 3000, Unguardable]
type = VarSet
trigger1 = Time = 3 && NumEnemy
trigger1 = (EnemyNear, StateNo != [120,155])
var(17) = 50

[State 3000, Super Cancel Flag]
type = VarSet
trigger1 = !Time
var(21) = (PrevStateNo = [1000,2999]) && var(6)

[State 3000, Hyper Cancel Flag]
type = VarSet
trigger1 = !Time
var(22) = (PrevStateNo = [3000,4999]) && var(7)

[State 3000, Super Cancel Flash]
type = PalFX
trigger1 = var(21) || var(22)
trigger1 = !(Time % 2) && Time <= 12
time = 1
add = 255,255,255
ignoreHitPause = 1

[State 3000, Super Cancel Juggle Reset]
type = VarSet
trigger1 = !Time
trigger1 = var(21) || var(22)
var(15) = 0
ignoreHitPause = 1

[State 3000, SuperPause FX]
type = Helper
trigger1 = Time = 3
helperType = Normal
stateNo = 8500
ID = 8500
name = "Superpause FX"
posType = P1
pos = 16,-86
superMoveTime = 255
size.xScale = 1
size.yScale = 1
ownPal = 1

[State 3000, SuperPause]
type = SuperPause
trigger1 = Time = 3
time = 50
moveTime = 50
p2DefMul = 1
unHittable = 1
anim = -1
sound = s8500,0
darken = 0
poweradd = 0

[State 3000, PosSet]
type = PosSet
trigger1 = !Time
y = 0

[State 3000, Hand Blade FX]
type = Explod
trigger1 = !NumExplod(3001)
trigger1 = AnimElem = 2
anim = 3001
ID = 3001
pos = -5, 0
postype = P1
sprpriority = 3
scale = .4,.5
ignorehitpause = 1
bindtime = 1
removetime = 50
pausemovetime = 200
supermovetime = 200
ownpal = 1
removeongethit = 1

[State 3000, Psi-Thrust FX]
type = Explod
trigger1 = !NumExplod(3002)
trigger1 = AnimElem = 4
anim = 3002
ID = 3002
pos = -3, -10
postype = P1
sprpriority = 4
scale = .4,.5
ignorehitpause = 1
bindtime = -1
removetime = -1
ownpal = 1
removeongethit = 1

[State 3000, Width: Edge]
type = Width
trigger1 = AnimElemTime(9) < 0
edge = 25,0

[State 3000, PSI-THRUST!!]
type = PlaySnd
trigger1 = AnimElem = 3
value = 3000, 0
channel = 0

[State 3000, Energy Snd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 1, 7
channel = 1

[State 3000, Velocity: Going Forward]
type = VelSet
trigger1 = AnimElem = 4
x = 17

[State 3000, Friction]
type = VelMul
trigger1 = AnimElemTime(4) >= 0
trigger1 = AnimElemTime(9) < 0
x = .96

[State 3000, Velstop]
type = Velset
trigger1 = AnimElemTime(9) = 0
x = 0

[State 3000, StateTypeSet: Air, no physics]
type = StateTypeSet
trigger1 = AnimElem = 9 
statetype = A       
physics = N         

[State 3000, Velocity: Jumping Back]
type = Velset
trigger1 = AnimElemTime(9) = 1
x = -3
y = -10

[State 3000, Dust Helper]
type = Helper
trigger1 = AnimElem = 9
helperType = Normal
stateNo = 8100
ID = 8100
name = "Jump Dust"
posType = P1
ownPal = 1

[State 3000, Jump Snd]
type = PlaySnd
trigger1 = AnimElem = 9
value = 40, 0
channel = 2

[State 3000, Gravity]
type = VelAdd
trigger1 = AnimElemTime(9) >= 1 
y = .5

[State 3000, Hits 1-4]
type = HitDef
trigger1 = !var(16) && var(15) < 5
trigger1 = AnimElem = 4 || AnimElem = 5 || Animelem = 6 || AnimElem = 7
attr = S, HA
damage = ceil(ifElse(fvar(11) * 30 < 7, 7, fvar(11) * 30)), 8
priority = 4, hit
animtype = Hard
getpower = 0, 0
givepower = 35, 35
guardflag = M
hitflag = MAF
hitsound = S2,10
guardsound = S130,0
pausetime = 6,6
guard.pausetime = 6,6
sparkNo = -1 + 0 * (var(33) := 8017)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 87), var(36) := -56
air.animtype = Back
fall.animtype = Back
ground.type = Low
air.type = Low
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -6
air.velocity = -6, -0.85
guard.velocity = -6
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .58
fall = 0
air.fall = 1
fall.recover = 0
forcestand = 1
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 18
envshake.ampl = 6
envShake.freq = 120

[State 3000, Final Hit]
type = HitDef
trigger1 = !var(16) && var(15) < 6
trigger1 = AnimElem = 8
attr = S, HA
damage = ceil(ifElse(fvar(11) * 35 < 7, 7, fvar(11) * 35)), 8
priority = 4, hit
animtype = Diagup
getpower = 0, 0
givepower = 35, 35
guardflag = M
hitflag = MAF
hitsound = S2,10
guardsound = S130,0
pausetime = 6,6
guard.pausetime = 6,6
sparkNo = -1 + 0 * (var(33) := 8017)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 87), var(36) := -56
air.animtype = Diagup
fall.animtype = Diagup
ground.type = Low
air.type = Low
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -9, -6
air.velocity = -9, -5
guard.velocity = -10
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .58
fall = 1
fall.recover = 0
forcestand = 1
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 18
envshake.ampl = 6
envShake.freq = 120

[State 3000, Remove Energy FX]
type = RemoveExplod
trigger1 = AnimElemTime(9) = 0
id = 3002
ignorehitpause = 1

[State 3000, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(9) >= 0
movetype = I

[State 3000, End]
type = ChangeState
trigger1 = pos y > -vel y
value = 52

