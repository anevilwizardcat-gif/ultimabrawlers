trigger3 = ((P2stateno=5120&&enemynear,animtime>-10&&var(54)%5<3)||P2statetype!=L)&&ifelse(P2statetype=L,random%5=0,(var(50)>=ifelse(var(54)%11<5,60,ifelse(var(54)%11<7,30,8))&&random%7=0))
trigger3 = P2bodydist X<=(80+(var(51)>=17)*10)&&(prevstateno!=[200,1999]) && time>=var(51)&&time>=5&&var(50)<50&&fvar(38)
trigger4 = (prevstateno=[5000,5099]) && P2bodydist X<=(80+(var(51)>=17)*10) && random%5<2 && time>=var(51)&&time>=5&&var(50)<50&&fvar(38)
value = 955+(var(50)>=17)+(var(50)>=50)

