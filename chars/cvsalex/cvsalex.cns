;---------------------------------------------------------------------------
; Statedef -3
;---------------------------------------------------------------------------
[Statedef -3]
;---------------------
; Sound
[State -3, Michael Jackson voice]
type = VarSet
trigger1 = RoundState = 0
var(24) = ifElse(Var(23) = 1,10,0)
[State -3, Michael Jackson voice]
type = VarSet
triggerall = Var(23) = 2
triggerall = (random%24) = 17
triggerall = RoundState = 2
triggerall = Time = 0
trigger1 = (StateNo%5) = 0
trigger1 = MoveType = A
trigger2 = (StateNo%50) = 0
var(24) = ifElse(Var(24)=0,10,0)

[State -3, Bounding Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 5100 || StateNo = [5110,5111]
value = S5100,0
freqmul = ifElse(StateNo = 5110,0.97,1)
channel = 13

[State -3, Hurt Sound]
type = PlaySnd
triggerall = Random < 500
triggerall = Time = 1
triggerall = Alive
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5070 || StateNo = 5080 || StateNo = 5100
value = S5000+Var(24),ifElse(StateNo = 5100||GetHitVar(animtype) = 2,1,0)
channel = 4

[State 5201, PlaySnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 5201 || StateNo = 5210
value = S8+Var(24),3
channel = 0

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
;---------------------------------------------------------------------------
; DTC
[State -2, Display to Clipboard]
type = DisplaytoClipboard
trigger1 = (GameTime%200) = 0
ignorehitpause = 1
text = "Alex (CvS2) by Jesuszilla"

[State -2, Display to Clipboard]
type = DisplaytoClipboard
trigger1 = (GameTime%200) = 100
ignorehitpause = 1
text = "http://www.trinitymugen.net/"

[State -2, DisplaytoClipboard]
type = null;DisplaytoClipboard
trigger1 = (GameTime%100) = 0
ignorehitpause = 1
text = "GROOVE = %d, GAUGE = %d, SMALL JUMP = %d\nPARRY = %d, JD = %d"
params = Var(20), Var(10), Var(6), var(5)&8, var(5)&4

[State - 2, DTC]
type = Null;DisplaytoClipboard
trigger1 = (GameTime%200) = 0
ignorehitpause = 1
text = "Var(9) = %d, Var(10) = %d, Var(11) = %d, Var(12) = %d, Var(13) = %d"
params = Var(9), Var(10), Var(11), Var(12), Var(13)

[State -2, DTC]
type = Null;DisplaytoClipboard
trigger1 = (GameTime%300) = 0
ignorehitpause = 1
text = "Var(14) = %d, Var(15) = %d, Var(16) = %d, Var(30) = %d"
params = Var(14), Var(15), Var(16), Var(47)

[State -2, DTC]
type = null;DisplayToClipboard
trigger1 = 1
text = "Combo = %d, Var(11) = %d, Cornerpush = %f, Var(56) = %d, MJ = %d"
params = Var(50), Var(11), FVar(39), Var(56), Var(23)

[State -2, DTC]
type = null;DisplayToClipboard
trigger1 = 1
text = "FVar(13) = %f, P2Recovery  = %f, Juggle Count = %f, JD = %d, Shake = %d"
params = FVar(13), FVar(18), FVar(19), Var(0), Var(2)

[State -2, DTC]
type = null;DisplayToClipboard
trigger1 = 1
text = "OC = %d, P2Body X = %f, P2Body Y = %f, FEBD = %f"
params = Var(31), P2BodyDist X, P2BodyDist Y, FrontEdgeBodyDist

[State -2, DTC]
type = null;DisplayToClipboard
trigger1 = 1
text = "var(5) = %d, Damage = %d, combo = %d, hitcount = %d, sysvar(3) = %d"
params = var(5), var(49), var(51), hitcount, sysvar(3)
ignorehitpause = 1

