v = 9
value = 8
[State 0, VarSet]
type = VarAdd
trigger1 = root, AILevel > 2
trigger1 = root, StateNo != 5120 && Var(9) > 0
v = 9
value = -1

[State 0, VarSet]
type = VarSet
trigger1 = Var(9) < 0
v = 9
value = 0

; DON'T DO STUPID SHIT WHILE THEY'RE DIZZIED, do cool shit instead.
[State 0, VarSet]
type = VarSet
trigger1 = Enemy(0), StateNo = [5300,5345]
v = 15
value = 1
[State 0, VarSet]
type = VarSet
trigger1 = NumEnemy > 1
trigger1 = Enemy(1), StateNo = [5300,5345]
v = 15
value = 2
[State 0, VarSet]
