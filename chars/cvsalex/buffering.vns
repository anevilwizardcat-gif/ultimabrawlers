trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0,  3,  2))*((Var(22)&(2**7  - 1)) > (2**6))))) ; DP
trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0,  2,  3))*((Var(23)&(2**7  - 1)) > (2**6))))) ; rDP
trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0,  5,  4))*((Var(24)&(2**9  - 1)) > (2**8))))) ; HCF
trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0,  4,  5))*((Var(25)&(2**9  - 1)) > (2**8))))) ; HCB
trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0,  7,  6))*((Var(26)&(2**6  - 1)) > (2**5))))) ; CB,F
trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0,  6,  7))*((Var(27)&(2**6  - 1)) > (2**5))))) ; CF,B
trigger1 = e||(var(59) := (var(59)|((2**8)*((Var(28)&(2**6  - 1)) > (2**5)))))                          ; CD,U
trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0, 10,  9))*((Var(40)&(2**9  - 1)) > (2**8))))) ; QCFx2
trigger1 = e||(var(59) := (var(59)|((2**cond(P2Dist X < 0,  9, 10))*((Var(41)&(2**9  - 1)) > (2**8))))) ; QCBx2
trigger1 = e||(var(59) := (var(59)|((2**11)*((Var(42)&(2**8  - 1)) > (2**7)))))                         ; 360
