postype = p1              ; Se mide desde el eje de Carnage
facing = 1
sprpriority = 5           ; ¡Importante! Prioridad alta para que la sangre cubra a ambos
removetime = -2           ; Se borra sola al terminar su animación
pausemovetime = 0
scale = 1,1               ; Puedes poner 1.5, 1.5 si quieres que sea mucha sangre
ownpal = 1                ; Usa los colores propios de la chispa



[State 1610, Sangre]
type = Explod
trigger1 = AnimElem = 5
anim = 1615               
ID = 1615
pos = 25, -65             
postype = p1
sprpriority = 5           ; <--- Un 5 asegura que tape al oponente
facing = 1
removetime = -2
scale = 1,1
ownpal = 1               ; Muy importante para que use sus propios colores



;--- Temblor de pantalla leve ---
[State 1610, Temblor]
type = EnvShake
trigger1 = AnimElem = 5   ; El momento del impacto
time = 10                 ; Duración del temblor (10 frames es muy rápido)
ampl = -2                 ; Qué tan fuerte salta (2 es leve, 8 es como Hulk)
freq = 120                ; Qué tan rápido vibra (entre más alto, más frenético)



[State 1610, Fin]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1



