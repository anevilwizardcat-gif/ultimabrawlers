trigger1 = time = 1
name = "Line Helper"
ID = 107
stateno = 107
pos = 100,-130
postype = p1
ownpal = 0

[State 0, VelSet]
type = VelAdd
trigger1 = AnimElemTime(3) >= 1
y = const(movement.yaccel)

[State 0, VelSet]
