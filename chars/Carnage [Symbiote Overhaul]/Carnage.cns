x = 0.75

[State 0, VelSet]
type = VelAdd
trigger1 = AnimElemTime(1) >= 25
x = -0.1

[State 0, VelSet]
type = VelSet
trigger1 = AnimElemNo(0) >= 2
trigger1 = Vel X < 7.5
x = 7.5

[State 112, Turn]
type = Turn
trigger1 = P2Dist X < -5
trigger1 = AnimTime = 0

[State 1340]
