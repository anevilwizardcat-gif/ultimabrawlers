value = 1

[State 0, VelSet]
type = VelAdd
trigger1 = AnimElemTime(1) >= 10 && AnimElemTime(1) < 17
y = 1.1

[State 0, VelSet]
type = VelAdd
trigger1 = AnimElemTime(1) >= 17 && AnimElemTime(1) < 20
y = -0.6

[State 0, VelSet]
type = VelAdd
