id = 10001
pos = ceil(enemynear, screenpos x), 20 + (enemynear, screenpos y > 0) * 155
postype = left
ignorehitpause = 1
ontop = 1
bindtime = -1
persistent = 1
removetime = 1
scale = 1, 1
ownpal =1
sprpriority = 9


