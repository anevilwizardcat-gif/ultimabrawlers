;---------------------------------------------------------------------------
;Combo Detection

[State -2:		VarSet]
type			= VarSet
trigger1		= 1
v			= 10
value			= 0
ignorehitpause	= 1

[State -2:		VarSet]
type			= VarSet
triggerall		= (MoveContact) && (Var(20) = 0)
trigger1		= ((StateNo = 200) && (AnimElem = 2, < 5)) || ((StateNo = 215) && (AnimElem = 4, < 5)) || ((StateNo = 240) && (AnimElem = 2, < 5))
trigger2		= ((StateNo = 265) && (AnimElem = 2, < 5)) || ((StateNo = 400) && (AnimElem = 3, < 5)) || ((StateNo = 410) && (AnimElem = 3, < 5))
trigger3		= ((StateNo = 440) && (AnimElem = 2, < 5)) || ((StateNo = 450) && (AnimElem = 2, < 5))
trigger4		= ((StateNo = 210) && (Time <= 5)) || ((StateNo = 215) && (Time <= 5))
v			= 10
value			= 1
ignorehitpause	= 1

