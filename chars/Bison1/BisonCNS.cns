;======================================
;"Bison", from Street Fighter Alpha 3
;======================================

;----------------------------------------
;Author:	FlowaGirl
;		flowergirl@cutey.com
;----------------------------------------

;===========================================================================
;-| Notes |-----------------------------------------------------------------
;None!

;--------------
;Integer Variables:
;--------------

;0: Long Jump
;1: Intro/Win/Lose
;2: AI Activation
;3: HitSpark Position X
;4: HitSpark Position Y
;5: First Attack
;6: Counter Hit
;7: Reversal
;8: Cheap
;9: KO
;10: Combo Detection
;11: FlowaGirl's 3-in-1 state thingy.
;12: Corner Juggle Limit
;13: Opponent Fatness
;14: Guard Crush Detection
;15: Guard Protection/Dampening
;16: Guard Crush Recover
;17: Guard Crush Point
;18: Guard Crush Bar
;19: Slow Motion Timer
;20: AI Sequence
;21: Psycho Field Timer
;22: Deadly Throw Direction
;23: Recovery Roll
;24: Ultimate Psycho Crusher: Once per round
;25: Ultimate Psycho Crusher: Position
;26: Ultimate Psycho Crusher: Remove timer
;27: Taunt: Once per round
;28: Psycho Crusher (A-Ism): Hit combo limit
;29: BreakFall: ON/OFF
;30: BreakFall: Control
;31: Float 1
;32: Float 2

;--------------
;Float Variables:
;--------------

;0: Velocity X
;1: Velocity Y

;--------------
;Sound Data:
;--------------

;0: Voices
;1: GetHit
;2: Effects
;3: Hit/Guard

;--------------
;SFF/AIR/State Data:
;--------------

;200-399: Basic (Stand)
;400-599: Basic (Crouch)
;600-799: Basic (Air)
;800-999: Basic (Throws/Misc.)

;--------------
;1000-2999: Special
;--------------

;	1000: Psycho Shot
;	1010: Psycho Field
;	1020: Psuedo Head Press
;	1030: Double Knee Press
;	1040:	Head Press
;	1050: Bison Warp Forward
;	1060: Bison Warp Backward
;	1070: Psycho Crusher (X-Ism)

;--------------
;3000-4999: Super
;--------------

;	3000: Psycho Crusher (A-Ism)
;	3010: Knee Press Nightmare
;	3020: Ultimate Psycho Crusher

;--------------
;5000-6999: Required
;--------------

;5000-5300: Required

;--------------
;7000-8999: Misc.
;--------------

;	7000: Recovery Roll
;	7010: Alpha Counter

;--------------
;9000-10999: Effects (May use helpers.)
;--------------

;--------------
;11000: Helper
;--------------

;===========================================================================
;-| Data |------------------------------------------------------------------

;---------------------------------------------------------------------------
[Data]
life 			= 1000
attack 		= 100
defence 		= 110
power			= 3000
fall.defence_up 	= 50
liedown.time 	= 10
airjuggle 		= 3
sparkno 		= S9030
guard.sparkno 	= S9060
KO.echo 		= 0
volume 		= 255
IntPersistIndex 	= 60
FloatPersistIndex = 40

[Size]
xscale 		= 0.83 ;Bison is too damn fat. >_<
yscale 		= 1.07
ground.back 	= 20
ground.front 	= 20
air.back 		= 20
air.front 		= 20
height 		= 60
attack.dist 	= 160
proj.attack.dist 	= 90
proj.doscale 	= 1
head.pos 		= 12,-80
mid.pos 		= 0,-50
shadowoffset 	= 0
draw.offset 	= 0,0

[Velocity]
walk.fwd  		= 3.7
walk.back 		= -3.1
run.fwd  		= 8,0
run.back 		= -7,0
jump.neu 		= 0,-12.3
jump.back 		= -4.7
jump.fwd 		= 5.3
runjump.back 	= -7.8
runjump.fwd 	= 8
airjump.neu 	= 0,-8
airjump.back 	= -3.8,-8
airjump.fwd 	= 4.0,-8

[Movement]
airjump.num 	= 0
airjump.height 	= 35
yaccel 		= .72
stand.friction 	= .85
crouch.friction 	= .85

