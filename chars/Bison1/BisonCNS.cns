triggerall		= (PalNo = [7,12])
trigger1 		= ((Anim != 1) && (Anim != 5)) || ((Anim = 5) && (AnimTime = 0))
value 		= 1

[State 0: 		VelSet]
type 			= VelSet
trigger1 		= (!Time)
y 			= 0

[State 0: 		VelSet] 
type 			= VelSet
trigger1 		= (Abs(Vel X) < 2) || (Time = 4)
x 			= 0

[State 0:		ChangeState]
type			= ChangeState
trigger1		= (Pos Y < 0)
value			= 50

