;SFA3's Recovery System

[State -2: 		Null]
type 			= Null
trigger1 		= (StateNo != 5050) && (StateNo != 5071)
trigger1		= (Var(29) := 0)
trigger2 		= (Var(29) = 0) && (EnemyNear, Ctrl) && ((StateNo = 5050) || (StateNo = 5071))
trigger2		= (Var(29) := 1)
trigger3 		= (P2StateNo != 5050) && (P2StateNo != 5071)
trigger3		= (Var(30) := 0)
trigger4 		= (Var(30) = 0) && (Ctrl) && ((P2StateNo = 5050) || (P2StateNo = 5071))
trigger4		= (Var(30) := 1)

[State -2: 		ChangeState]
type 			= ChangeState
triggerall 		= (Var(29) = 1) && ((StateNo = 5050) || (StateNo = 5071))
trigger1 		= (Vel Y > 0) && (Alive) && (Var(23) = 0) && (Command = "recovery")
value 		= 5200

[State -2: 		ChangeState]
type 			= ChangeState
triggerall 		= (Var(29) = 1) && ((StateNo = 5050) || (StateNo = 5071))
trigger1 		= (Vel Y > -1) && (Alive) && (Var(23) = 0) && (Command = "recovery")
value 		= 5200

[State -2: 		TargetState]
