triggerall 		= (Var(30) = 1) && (NumTarget > 0) && ((P2StateNo = 5050) || (P2StateNo = 5071))
trigger1 		= (Target, Vel Y > 0) && (Target, Alive) && (Target, Command = "recovery")
value 		= 5200

[State -2: 		TargetState]
type 			= TargetState
triggerall 		= (Var(30) = 1) && (NumTarget > 0) && ((P2StateNo = 5050) || (P2StateNo = 5071))
trigger1 		= (Target, Vel Y > -1) && (Target, Alive) && (Target, Command = "recovery")
value 		= 5200

