;Corner Juggle Limit

[State -2:		AssertSpecial]
type			= AssertSpecial
trigger1		= Var(12) = 0
flag			= NoJuggleCheck

[State -2:		VarSet]
type			= VarSet
trigger1		= 1
v			= 12
