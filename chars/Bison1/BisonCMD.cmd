;-| Hyper |-----------------------------------------------------------------

;---------------------------------------------------------------------------
;Ultimate Psycho Crusher
[State -1: 		Ultimate Psycho Crusher]
type 			= ChangeState
value 		= 3020
triggerall 		= (Command = "Ultimate Psycho Crusher") && (Power >= 3000) && (Var(24) = 0) && (NumProj = 0)
trigger1		= ((StateType != A) && (Ctrl)) || (Var(10) = 1)
trigger2		= (StateNo = 1030) && (AnimElem = 6, > 0)

;---------------------------------------------------------------------------
;Psycho Crusher (A-Ism)
[State -1: 		Psycho Crusher]
type 			= ChangeState
value 		= 3000
triggerall		= (((StateType != A) && (Ctrl)) || (Var(10) = 1)) && (StateNo != 3000)
triggerall		= (Var(11) := IfElse((Command = "holdx" || Command = "relx"),50,IfElse((Command = "holdy" || Command = "rely"),62,86)))
trigger1 		= (Command = "Psycho Crusher Level1") && (Power >= 1000)
trigger2 		= (Command = "Psycho Crusher Level2") && (Power >= 2000)
trigger3 		= (Command = "Psycho Crusher Level3") && (Power >= 3000)
trigger4		= (StateNo = 1030) && (AnimElem = 6, > 0)

;---------------------------------------------------------------------------
;Knee Press Nightmare
[State -1: 		Knee Press Nightmare]
type 			= ChangeState
value 		= 3010
triggerall		= (((StateType != A) && (Ctrl)) || (Var(10) = 1)) && (StateNo != 3010)
triggerall		= (Var(11) := IfElse((Command = "holda" || Command = "rela"),1,IfElse((Command = "holdb" || Command = "relb"),2,3)))
trigger1 		= (Command = "Knee Press Nightmare Level1") && (Power >= 1000)
trigger2 		= (Command = "Knee Press Nightmare Level2") && (Power >= 2000)
trigger3 		= (Command = "Knee Press Nightmare Level3") && (Power >= 3000)
trigger4		= (StateNo = 1030) && (AnimElem = 6, > 0)

