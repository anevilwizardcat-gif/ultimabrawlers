;---------------------------------------------------------------------------
;Taunt
[State -1: 		Taunt]
type 			= ChangeState
value 		= 195
triggerall 		= (Command = "s") && (Var(27) = 0)
trigger1		= (StateType != A) && (Ctrl)

;---------------------------------------------------------------------------
;Alpha Counter
[State -1: 		Alpha Counter]
type 			= ChangeState
value 		= 7010
triggerall 		= (Command = "holdfwd") && (Command = "cz") && (Power >= 1000)
trigger1		= (StateNo = 150) || (StateNo = 152)

