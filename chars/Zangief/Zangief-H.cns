; ファイナルアトミックバスター					Ｌｖ１
;------------------------ スーパーコンボ演出
[Statedef 3000]
type = S
movetype = A
physics = S
anim = 3000
velset = 0, 0
ctrl = 0
poweradd = 0
juggle = 8

[State 3000,Muteki]
type = NotHitBy
trigger1 = AnimElem = 2, < 0
value = SCA

[State 3000,SuperPause]
type = SuperPause
trigger1 = Time = 4
time = 49
anim = S2000
sound = S2000, 1
pos = 12,-82
movetime = 49
darken = 1
poweradd = -1000
unhittable = 1

[State 3000,AfterImage]
type = AfterImage
trigger1 = Time = 0
time = 999
length = 16
palcolor = 256
palinvertall = 0
palbright = 30,30,30
palcontrast = 180,180,180
palpostbright = 0, 0, 0
paladd = 25,25,25
palmul = .75,.75,.75
timegap = 2
framegap = 4
trans = add1

[State 3000,HitDef]
type = Hitdef
triggerall = P2MoveType != H
triggerall = P2StateNo != [150,155]
;triggerall = P2StateNo != 40
trigger1 = Time = 5
attr = S, HT
getpower = 0
givepower = 80 + (Var(31) != 0) * 37
hitflag = M-
priority = 7,Miss
guardflag = None
numhits = 0
sparkno = -1
p1facing = 1
p2facing = 1
p1stateno = 3010
p2stateno = 3040
p2getp1state = 1
hitsound = S800, 0
fall = 1
fall.recover = 0

[State 3000,AfterImageTime]
type = AfterImageTime
trigger1 = AnimTime = 0
time = 0

[State 3000,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 6
value = 800, 2

[State 3000,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

