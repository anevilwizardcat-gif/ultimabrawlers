;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 0]
type = ScreenBound
trigger1 = 1
value = 0

[State 190, ChangeAnim]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

[State 190,ChangeState]
type = ChangeState
triggerall = Time = 0
triggerall = Numenemy = 1 && NumPartner = 0
trigger1 = Enemy,authorname = "H”" && Enemy,Name = "raiden"
value = 4400


[State 190,ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "R.MIKA" || P4Name = "R.MIKA"
trigger2 = P2Name = "Mika" || P4Name = "Mika"
trigger3 = P2Name = "Rainbow Mika By TAMAGO" || P4Name = "Rainbow Mika By TAMAGO"
value = 4300

[State 190,ChangeState] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191

;---------------------------------------------------------------------
; イントロ１
