type = S
ctrl = 0
anim = 191
velset = 0,0,0

[State 191,4]
type = AssertSpecial
trigger1 = Time = [0,150]
flag = Intro

[State 191,Helper]
type = Helper
trigger1 = AnimElem = 13
helpertype = Normal
name = "Mantle"
ID = 191
pos = 0, 0
postype = P1
stateno = 192
keyctrl = 0
ownpal = 1

[State 191,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 11
value = 190, 0

[State 191,5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

