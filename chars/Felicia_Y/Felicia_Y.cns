; Dash Forward
[Statedef 102]
type	= A
physics = N
ctrl = 0
anim = 102
velset = 0,0

[State 40, 1]
type = VarSet
triggerall = !AILevel
trigger1 = numHelper(10372)
sysvar(1) = (((helper(10372), Var(4)&136) > 0) - ((helper(10372), Var(4)&68) > 0))

[State 102, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S40,3
channel = 13

[State 102, Dust]
type = Helper
trigger1 = AnimElemTime(2) = 0
stateno = 8103
ID = 8100
name = "Dash Dust"
postype = P1
pausemovetime = 255
supermovetime = 255
ownpal = 1

[State 102, 1]
type = VelSet
trigger1 = AnimElemTime(2) = 0
x = 11.5*(5.0/4.0)*Const(Size.XScale)
y = -5*(5.0/4.0)*Const(Size.YScale)

[State 0, PlayerPush]
type = PlayerPush
trigger1 = Time > 2
value = 0

[State 102, 1]
type = VelAdd
trigger1 = AnimElemTime(2) > 0
x = ifElse(Vel X <= 0, 0, -0.4375*(25.0/16.0))*Const(Size.XScale)
y = 0.46875*(25.0/16.0)*Const(Size.YScale);0.768;0.625

[State 102, ChangeState]
type = ChangeState
triggerall = Time > 9
triggerall = numHelper(10372)
trigger1 = sysvar(1) = -1
value = 50
ctrl = 1

[State 102, 3]
type = ChangeState
triggerall = AnimElemTime(2) > 0
trigger1 = Pos Y + Vel Y >= 0
value = 103

