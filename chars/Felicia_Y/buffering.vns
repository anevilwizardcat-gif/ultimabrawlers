;#region command_read_helper.vns
;-----------------------------[COMMAND READ HELPER]----------------------------;
; This helper is spawned to check for enemy commands.
;
; Important vars:
;	 var(0) = ATK_PRESS
;	 var(1) = ATK_HOLD
;	 var(2) = ATK_RLS
;	 var(3) = DIR_PRESS
;	 var(4) = DIR_HOLD
;	 var(5) = DIR_RLS
; sysvar(0) = THROW TECH ACTIVE
; sysvar(1) = STRENGTH (1 = LIGHT, 2 = MEDIUM, 3 = HEAVY)
;
[Statedef 10379]
anim = 1
ctrl = 0

[State 10379, Remove 1-tick Lag]
