;--------------------------------[BUTTONS]-------------------------------------;
;BUTTON:
;var(0) = PRESS
;var(1) = HOLD
;var(2) = RELEASE
;Final tick (pattern repeats going up, can store 4 ticks):
; LP	= 0x01
; MP	= 0x02
; HP	= 0x04
; Start = 0x08
; LK	= 0x10
; MK	= 0x20
; HK	= 0x40

[State 10379, Hold Dec]
