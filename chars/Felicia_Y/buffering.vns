trigger1 = Var(4)
var(4) = var(4)/16
ignorehitpause = 1

[State 10379, Press Dec]
type = VarSet
trigger1 = Var(3)
var(3) = var(3)/16
ignorehitpause = 1

[State 10379, Negative Edge Dec]
type = VarSet
trigger1 = Var(5)
var(5) = var(5)/16
ignorehitpause = 1

