trigger1 = 1
var(1) = var(1)/128
ignorehitpause = 1

[State 10379, Press Dec]
type = VarSet
trigger1 = 1
var(0) = var(0)/128
ignorehitpause = 1

[State 10379, Negative Edge Dec]
type = VarSet
trigger1 = 1
var(2) = var(2)/128
ignorehitpause = 1

;---------------------------------[DIRECTIONS]---------------------------------;
;DIRECTIONAL:
;var(3) = PRESS
;var(4) = HOLD
;var(5) = RELEASE
;Final tick (pattern repeats going up, can store 8 ticks):
; Up	  = 0x01
; Down	  = 0x02
; Back	  = 0x04
; Forward = 0x08

[State 10379, Hold Dec]
