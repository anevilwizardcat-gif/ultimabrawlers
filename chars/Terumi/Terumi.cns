trigger1 = 1
value = SCA
time = 1

[State 195, 1]
type = playsnd
triggerall = !time
trigger1 = enemynear,name != "Ragna the Bloodedge"
trigger2 = numenemy = 0
value = 181,0+random%3
channel = 0

[State 195, 1]
type = playsnd
trigger1 = enemynear,name = "Ragna the Bloodedge"
trigger1 = !time
value = 184, 0
channel = 0

[State 181, 1]
type = assertspecial
trigger1 = time <= 300
flag = roundnotover

