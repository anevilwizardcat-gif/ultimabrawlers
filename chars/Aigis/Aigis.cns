[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0
sprpriority = 2

[State 0]
type = null
trigger1 = var(55) = 29
trigger1 = var(55) := 1
trigger2 = var(55) = 1
trigger2 = ifelse(teamside=2,command = "fwd",command = "back")
trigger2 = var(55) := 29
trigger3 = var(55) = -1
trigger3 = var(55) := 1
[State 0]
type = varadd
triggerall = var(13) > 1
trigger1 = command = "fwd" && teamside = 1
trigger2 = command = "back" && teamside = 2
var(55) = 1
[State 0]
type = varadd
triggerall = var(13) > 1
trigger1 = command = "back" && teamside = 1
trigger2 = command = "fwd" && teamside = 2
var(55) = -1
[State 0]
type = playsnd
triggerall = var(13) > 1
trigger1 = command = "fwd"
trigger2 = command = "back"
value = 1,38
abspan = 0
[State 0]
type = playsnd
trigger1 = var(13) < 1
value = 1,ifelse(ailevel != 0,-1,39)
abspan = 0
persistent = 0

[State -2] ;Hud
type=explod
triggerall = var(13) > 1
trigger1=1
anim=ifelse(teamside=1,3050,3065)
id = 3050
bindtime=-1
removetime=1
facing=1-(teamside=2)*2
ontop=1
ownpal=1
scale = const480p(1),const480p(1)
pos=-30,-140
postype=p1
ontop = 1
ignorehitpause=1
[State -2] ;Tens
type=explod
triggerall = var(13) > 1
trigger1=var(55)>=1  ;;  replace with ""1"" if you want them to appear even when their value is 0
anim=3051+((var(55)/10)%10)
id = 3050
bindtime=-1
removetime=1
facing=1-(teamside=2)*2
ontop=1
ownpal=1
scale = const480p(1),const480p(1)
pos=ifelse(teamside=1,const480p(44),const480p(60)),-130
postype=p1
ontop = 1
ignorehitpause=1
[State -2] ;Ones
type=explod
triggerall = var(13) > 1
trigger1=1
anim=3051+(var(55)%10)
id = 3050
bindtime=-1
removetime=1
facing=1-(teamside=2)*2
ontop=1
ownpal=1
scale = const480p(1),const480p(1)
pos=ifelse(teamside=1,const480p(64),const480p(40)),-130
postype=p1
ontop = 1
ignorehitpause=1

