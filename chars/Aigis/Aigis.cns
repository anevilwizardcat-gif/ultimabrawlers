trigger1 = 1
var(7) = 0
[State 0]
type = varset
trigger1 = 1
var(8) = 0
[State 0]
type = varset
trigger1 = 1
var(20) = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 104
value = S0,random %4
volume = 355
channel = 8

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 107
value = S1,27

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 108
trigger2 = AnimElem = 114
trigger3 = AnimElem = 120
trigger4 = AnimElem = 126
value = S1,28

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 130
value = S1,29

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 20
value = 22

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 21
value = 23

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && anim != [20,23]
trigger2 = Anim = 5 && AnimTime = 0
trigger3 = (anim = 22 || anim = 23)
trigger3 = animtime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0]
type = varset
trigger1 = prevstateno = 210
trigger2 = prevstateno = 215
var(31) = 0
ignorehitpause = 1

[State 0, VarSet]
type = VarSet
trigger1 = Time = 0
var(7) = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

