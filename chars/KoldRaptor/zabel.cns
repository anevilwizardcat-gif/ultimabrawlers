[Data]
life = 1000			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
power = 3000
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 0			;Volume offset (negative for softer)
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = .8333           	;Horizontal scaling factor.
yscale = 1           	;Vertical scaling factor.
ground.back = 15     	;Player width (back, ground)
ground.front = 16    	;Player width (front, ground)
air.back = 12        	;Player width (back, air)
air.front = 12       	;Player width (front, air)
height = 60      		;Height of player (for opponent to jump over)
attack.dist = 160    	;Default attack distance
proj.attack.dist = 90 	;Default attack distance for projectiles
proj.doscale = 0     	;Set to 1 to scale projectiles too
head.pos = -5, -90   	;Approximate position of head
mid.pos = -5, -60    	;Approximate position of midsection
shadowoffset = 0     	;Number of pixels to vertically offset the shadow
draw.offset = 0,0    	;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.4      	;Walk forward
walk.back = -3.2     	;Walk backward
run.fwd  = 5, 0    	;Run forward (x, y)
run.back = -5,0		;Hop backward (x, y)
jump.neu = 0,-8.4    	;Neutral jumping velocity (x, y)
jump.back = -3.5    	;Jump back Speed (x, y)
jump.fwd = 4.5       	;Jump forward Speed (x, y)
;runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
;runjump.fwd = 4,-8.1     ;.
airjump.neu = 0,-8.1     ;.
airjump.back = -2.55     ;Air jump speeds (opt)
airjump.fwd = 2.5        ;.

[Movement]
airjump.num = 0      	;Number of air jumps allowed (opt)
airjump.height = 35  	;Minimum distance from ground before you can air jump (opt)
yaccel = .44         	;Vertical acceleration
stand.friction = .85  	;Friction coefficient when standing
crouch.friction = .82 	;Friction coefficient when crouching

[Quotes]
victory0 = "You should thank me. That broken face is very becoming on you."
victory1 = "Bah! I should not waste my time on such inferior opponents!"
victory2 = "A good attempt, but road to the netherworld is paved with good attempts."
victory3 = "Losing to me is as inevitable as death itself!"
victory4 = "Can you hear it? It's my song of pain! It'll make you cry!"
victory5 = "Encore? How many times do you have to die?"
victory6 = "Everyone has to die sometime. I just speed it up for them!"
victory7 = "Hey you! Get up! Don't die yet! The fun's just begun!"
victory8 = "I need backup to get in the mood... more scream!"
victory9 = "I'm dead and lively today as usual!!"
victory10 = "It's show time! A decapitation magic, for real!!"
victory11 = "It's time for your finale! I don't want an encore!"
victory12 = "People tell me that I'm the man of backbone!!"
victory13 = "Say hello to my buddy Le Marta! He's a sharp guy!"
victory14 = "Scream in harmony with the devil's choir!"
victory15 = "Shut up! You're supposed to be dead!"
victory16 = "This's bad! You've no pulse, soul, or rhythm."
victory17 = "What? Go to hell!? I just came from there!!"
victory18 = "You had no past, now you have no future!"

;-------------------------------------------------------------------
;Used Var
;var(1)= Used for Pounce
;var(2)= Hell Dunk messenger
;var(3)= Hell Dunk Ball
;var(4)= Used in Intro
;var(5)= Used in Winposes
;var(9)= A.I.
;var(10) = ES ON/OFF
;var(11) = ES Timer
;var(12) = DARK FORCE ON/OFF
;var(13) = DARK FORCE BG color
;var(14) = DARK FORCE Timer
;fvar(29) = Hell Dunk position
;-------------------------------------------------------------------

; Stand
[Statedef 0]
type = S
physics = S
anim = 0 + 3000*(var(12))
sprpriority = 0

[State 0, 1]
type = ChangeAnim
triggerall = !var(12) ;D.F. OFF
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = ChangeAnim
triggerall = var(12) ;D.F. ON
trigger1 = Anim != 3000 && Anim != 3005
trigger2 = Anim = 3005 && AnimTime = 0 ;Turn anim over
value = 3000

[State 0, 3]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 4] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 5]
type = PosSet
trigger1 = Time = 0
y = 0

;-------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11 + 3000*(var(12))
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
triggerall = !var(12) ;D.F. OFF
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 1] ;Change from turning animation
type = ChangeAnim
triggerall = var(12) ;D.F. ON
trigger1 = Anim = 3006 && AnimTime = 0
value = 11

; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = !var(12) ;D.F. OFF
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 3]
type = ChangeAnim
triggerall = var(12) ;D.F. ON
triggerall = vel x > 0
trigger1 = Anim != 3020 && Anim != 3005
trigger2 = Anim = 3005 && AnimTime = 0
value = 3020

[State 20, 4]
type = ChangeAnim
triggerall = !var(12) ;D.F. OFF
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, 4]
type = ChangeAnim
triggerall = var(12) ;D.F. ON
triggerall = vel x < 0
trigger1 = Anim != 3021 && Anim != 3005
trigger2 = Anim = 3005 && AnimTime = 0
value = 3021

;---------------------------------------------------------------------------
; JUMP_UP START
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0
facep2 = 1

[State 40, Dust]
type = helper
trigger1 = !animtime
helpertype = normal
stateno = 17100
ID = 7100
name = "Dust"
postype = p1
ownpal = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 3]
type = VarSet
trigger1 = command = "longjump"
trigger2 = prevstateno = 100
v = 8
value = 1

[State 810, AfterImage]
type = Afterimage
trigger1 = time = 0 && var(8)
time = 23
timegap = 1
framegap = 3
length = 12
palbright = 0, 0, 0
paladd = 0, 0, 0
palmul = 0.9, 0.9, 0.9
palcontrast = 120, 120, 120
palpostbright = 0, 0, 0
trans = add1

[State 40, 1]
type = PlaySnd
trigger1 = animTime = 0 && var(8)
value = 0,41
volume = -50

[State 40, 2]
type = PlaySnd
trigger1 = animTime = 0 && !var(8)
value = 0,40
volume = -50

[State 40, 3]
type = VelSet
trigger1 = AnimTime = 0 && var(8)
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*1.5, const(velocity.jump.back.x)*1.25))
y = const(velocity.jump.y)*1.12

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0 && !var(8)
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 13]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

