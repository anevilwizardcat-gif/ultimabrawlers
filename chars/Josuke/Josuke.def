; ここにキャラ情報を書いてください
[Info]
name = "ASB_JOSUKE"         ;キャラの名前
displayname = "Josuke"      ;表示されるキャラの名前
versiondate = 08,19,2014    ;キャラの更新情報
mugenversion = 04,14,2002   ;キャラが動くmugenのバージョン
author = "280号"            ;キャラの製作者名   ;SFF edit by Iver Stone
pal.defaults = 1,2,3,4,5,6  ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd      = ASB_JOSUKE_AI/ASB_JOSUKE.cmd   ;キャラのコマンド
cns      = ASB_JOSUKE_AI/ASB_JOSUKE.cns   ;本体モード通常、必殺
st       = ASB_JOSUKE_AI/ASB_JOSUKE.cns   ;本体モード通常、必殺
st1      = ASB_JOSUKE_AI/ASB_JOSUKE2.cns  ;本体モードスパコン
st2      = ASB_JOSUKE_AI/ASB_JOSUKE3.cns  ;スタンドモード通常、必殺
st3      = crazy.cns                      ;スタプラ基本行動
st4      = ASB_JOSUKE_AI/ASB_JOSUKE4.cns  ;スタンドモードモードスパコン
st5      = ASB_JOSUKE_AI/ASB_JOSUKE5.cns  ;デム
st6      = ASB_JOSUKE_AI/ASB_JOSUKE00.cns ;common、-2、-3
st7      = ASB_JOSUKE6.cns                ;俺の髪をけなすやつァゆるさねぇ！専用
st8      = ASB_JOSUKE7.cns                ;おめーをすでに治しといた専用
st9      = st9.cns                     ;挑発ボイス専用
stcommon = common1.cns 
sprite   = ASB_JOSUKE.sff   ;キャラの絵
anim     = ASB_JOSUKE.air   ;キャラの動き
sound    = ASB_JOSUKE.snd   ;キャラの音
pal1     = anime.act  ;1pカラー
pal2     = ASB001.act  ;2pカラー
pal3     = ASB002.act  ;3pカラー
pal4     = ASB003.act  ;4pカラー
pal5     = ASB004.act  ;5pカラー
pal6     = ASB005.act  ;6pカラー