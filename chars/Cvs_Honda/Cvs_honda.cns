;---------------------------------------------------------------------------
;イントロ1 
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0,0

[State 190,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 0, 0+random%2
channel = 0

[State 190,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5,=1
value = 4, 0

[State 190,Explod]
type = Explod
trigger1 = AnimElem = 5,=1
anim = 191
pos = 0,0
postype = P1
sprpriority = 1
bindtime = 1
ownpal = 1
scale = const(Size.xscale),1

[State 190,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
 
;-------------------------------------------------------------------------------
;挑発 
