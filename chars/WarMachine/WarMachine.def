; Definition file for WarMachine
; Contains all the filenames needed for the character

; Player information
[Info]
name = "War Machine"        ;Name of character
displayname = "War Machine" ;Name of character to display
mugenversion = 1.0
author = "One Winged Angel & Unko Man"      ;Character author name
Edited = "REDHOT"
pal.defaults = 1,2,3,4,5,6   ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = CMND/WarMachine.cmd   ;Command set
cns      = CNS/WarMachine.cns
st       = CNS/WarMachine.cns
st1      = CNS/config.txt
stcommon = CNS/common1.cns
sprite   = SPRITES/WarMachine.sff
anim     = ANIMATIONS/WarMachine.air
sound    = SOUNDS/WarMachine.snd
pal1     = PALETTES/WarMachine_01.act
pal2     = PALETTES/WarMachine_02.act
pal3     = PALETTES/WarMachine_03.act
pal4     = PALETTES/WarMachine_04.act
pal5     = PALETTES/WarMachine_05.act
pal6     = PALETTES/WarMachine_06.act