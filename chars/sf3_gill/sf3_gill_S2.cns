trigger1 = AnimElemTime(16) < 0
y = .50*const(size.yscale)

[State 1110, Gravity]
type = VelAdd
trigger1 = AnimElemTime(16) >= 0
y = 5.0*const(size.yscale)

[State -2, poweradd]
type = poweradd
trigger1 = animelemtime(14) = 0
value = 20

[State 1100, HitDef]
type = HitDef
triggerall = !var(24) && !var(5)         
triggerall = var(35) != 1200
trigger1 = animelemtime(15) >= 0
attr = A, SA
animtype  = hard
air.animtype  = back
damage = ceil(60*fvar(0)*fvar(26)*fvar(28)*fvar(29)),ceil(4*fvar(26))
priority = 5,Hit
getpower = 40,20
givepower = 10,0
hitflag = MAF
guardflag = M
pausetime = 8,8
guard.pausetime = 8,8
sparkno = -1;S8230
guard.sparkno = S8410+(P2dist X<0)*5
sparkxy = -15, ceil(-60*const(size.yscale)) 
hitsound = S2,7
guardsound = S3,1
ground.type = high
ground.slidetime = 13
ground.hittime  = 15
guard.hittime = 15
guard.slidetime = 13
guard.ctrltime = 15
air.hittime  = 15
ground.velocity = -15.0*const(size.xscale)*ifelse(p2dist X<0,-1,1)
guard.velocity = -15.0*const(size.xscale)*ifelse(p2dist X<0,-1,1)
air.velocity = -2.0*const(size.xscale)*ifelse(p2dist X<0,-1,1),-9.6*const(size.yscale)
fall = 0
fall.recover = 0
fall.envshake.time = 12
fall.envshake.freq = 80
fall.envshake.ampl = -4
down.bounce = 1
air.fall = 1
air.recover = 0
yaccel = .60*const(size.yscale)
envshake.time = 5
envshake.freq = 60
envshake.ampl = 3
;envshake.phase = 
P2facing = ifelse(p2dist X<0,-1,1)
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
id = 1200 

