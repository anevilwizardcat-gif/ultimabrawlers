trigger1 = power >= 1280
trigger1 = var(45) != 2
trigger1 = alive
;trigger1 = movetype = H
trigger1 = stateno != [4000,4205]
trigger1 = gethitvar(fall.kill) = 1
trigger1 = life <= 0 || GetHitVar(damage) >= life
trigger1 = var(45):= 1
value = 1
ignorehitpause = 1

[State -2, AssertSpecial]
type = AssertSpecial
triggerall = Enemy,life != 0 && var(45) != 2
trigger1 = power >= 1280 || power = powermax
flag = NoKO

