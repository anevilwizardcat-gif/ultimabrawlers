;---------------------------------------------------------------------------
;ジャンプ（投げ回避）
[state -1, Guard]
type = ChangeState
value = 40
triggerall = var(59) = 1
triggerall = roundstate = 2
triggerall = InGuardDist || P2bodydist X = [-60,120]
triggerall = ctrl || (stateno = [10,17]) || stateno = 21
triggerall = statetype != A
trigger1 = enemynear,HitDefAttr = SC, NT,ST,HT
	trigger1 = random = [0,700]

;---------------------------------------------------------------------------
;受身（空中）
[State -1]
type = ChangeState
value = 5210
triggerall = Var(59) = 1
triggerall = Alive
triggerall = CanRecover
triggerall = Vel Y > -1
triggerall = Pos Y >= -40
triggerall = StateNo = 5050
trigger1 = random = [150,200]

;---------------------------------------------------------------------------
;受身（地上）
[State -1]
type = ChangeState
value = 5200
triggerall = var(59) = 1
triggerall = ((var(20) = 1 || var(20) = 4 || var(20) = 5 || var(20) = 6) && !(var(0)&2**10)) || CanRecover
triggerall = Alive
triggerall = StateNo = 5050 || StateNo = 5071
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
trigger1 = random <= 400

;---------------------------------------------------------------------------
;オリコン発動（地上）
[State -1]
type = ChangeState
value = 870
triggerall = var(59) = 1
triggerall = var(20) = 1 || var(20) = 6
triggerall = Power >= 3000
triggerall = !var(15) && !var(16)
triggerall = roundstate = 2
triggerall = statetype != A
triggerall = P2life > 150 || (100*life/const(data.life))<=15
trigger1 = ctrl || (stateno = [10,17]) || (stateno = 100 && animelemtime(2) > 1) || stateno = 101
trigger1 = P2bodydist X = [0,60]
trigger1 = P2StateType = S || P2StateType = C || ((P2bodydist Y = [-20,0]) && enemynear,Vel X >= 0 && enemynear,Vel Y > 0)
trigger1 = P2MoveType = A
trigger1 = !(var(16) && numtarget)
	trigger1 = random <= 200
trigger2 = ctrl || stateno = 21 || (stateno = 100 && animelemtime(2) > 1) || stateno = 101 || stateno = 40 || (stateno = 52 && anim = 57 && time >= 2)
trigger2 = P2bodydist X = [30,50]
trigger2 = P2bodydist Y = [-60,-30]
trigger2 = numtarget
trigger2 = target,stateno = [5000,5070]
trigger2 = target,stateno != 5040
trigger2 = target,Vel Y <= 4
trigger2 = target,Vel Y
trigger2 = !(var(16) && numtarget)
trigger3 = ctrl || stateno = 21 || (stateno = 100 && animelemtime(2) > 1) || stateno = 101 || stateno = 40 || (stateno = 52 && anim = 57 && time >= 2)
trigger3 = P2bodydist X = [-10,50]
trigger3 = P2bodydist Y = [-60,-30]
trigger3 = numtarget
trigger3 = target,stateno = [5000,5070]
trigger3 = target,stateno != 5040
trigger3 = target,Vel Y = [0,4]
trigger3 = target,Vel Y
trigger3 = !(var(16) && numtarget)

;---------------------------------------------------------------------------
;しゃがみ
[State -1, Walk]
type = ChangeState
value = 15
triggerall = var(59) = 1
triggerall = StateType != A
triggerall = !enemynear,numproj
triggerall = stateno != [10,17]
triggerall = prevstateno != [10,17]
triggerall = stateno != [120,159]
triggerall = !(var(16) && numtarget)
trigger1 = P2bodydist X >= 50
trigger1 = ctrl
trigger1 = !inguarddist
	trigger1 = random%3=1
trigger2 = P2bodydist X >= 50
trigger2 = ctrl
trigger2 = inguarddist
	trigger2 = random%10=1
trigger3 = P2bodydist X >= 150
trigger3 = ctrl
trigger3 = !inguarddist
trigger4 = P2bodydist X >= 200
trigger4 = stateno = 21
trigger4 = time > 20
trigger4 = !inguarddist
trigger5 = P2bodydist X > 30
trigger5 = stateno = 0
trigger5 = ctrl
trigger5 = !inguarddist

;---------------------------------------------------------------------------
;歩き
[State -1, Walk]
