;---------------------------------------------------------------------------
;ママハハ（通常）
[Statedef 20000]
type = A
movetype = I
physics = N
ctrl = 0

[State 181, 2]
type = ChangeAnim
trigger1 = anim != 20000
value = 20000

[State 181, 2]
type = Turn
trigger1 = facing != root,facing
persistent = 1

[State 5900, 3]
type = SprPriority
trigger1 = 1
value = -1

[State 181, 2]
type = SprPriority
trigger1 = root,movetype != H
trigger1 = root,stateno = 3102
value = 3

[State 1000, Spark]
type = RemoveExplod
trigger1 = time = 0
ID = 7400

[State 7000, VarSet]
type = VarSet
trigger1 = 1
fvar(0) = rootdist x+0.0001

[State 7000, VarSet]
type = VarSet
trigger1 = 1
fvar(1) = rootdist y-140

[State 105, 1]
type = VelSet
trigger1 = 1
x = 1.333*cos(atan(fvar(1)/fvar(0))+(pi*(fvar(0)<0)))
y = 1.333*sin(atan(fvar(1)/fvar(0))+(pi*(fvar(0)<0)))

[State 1125, Velocity]
type = VelSet
triggerall = root,facing * facing = 1
trigger1 = Vel X > 0
trigger1 = rootdist X < 1.33
trigger2 = Vel X < 0
trigger2 = rootdist X > -1.33
x = 0
persistent = 1

[State 1125, Velocity]
type = VelSet
trigger1 = Vel Y > 0
trigger1 = rootdist Y < 141.33
trigger2 = Vel Y < 0
trigger2 = rootdist Y > 138.67
y = 0
persistent = 1

[State 181, 2]
type = PlaySnd
trigger1 = AnimElem = 2
value = 20000, 1

[State 3001, VarSet]
type = VarSet
trigger1 = root,stateno != 0
trigger2 = root,stateno = 0 && root,anim = 5
trigger3 = var(1) = 300
var(1) = 0

[State 3001, VarSet]
type = VarAdd
trigger1 = root,stateno = 0
var(1) = 1

[State 5900, 3]
type = ChangeState
triggerall = root,movetype != H
trigger1 = root,stateno = 1200 && root,animelem = 6
value = 21200

[State 5900, 3]
type = ChangeState
triggerall = root,movetype != H
trigger1 = root,stateno = 1300
value = 21300

[State 5900, 3]
type = ChangeState
triggerall = root,movetype != H
trigger1 = root,stateno = 3000 && root,animelemtime(5) = 1
value = 23000

[State 5900, 3]
type = ChangeState
triggerall = root,movetype != H
trigger1 = root,stateno = 3100 && root,animelem = 1
value = 23100

[State 5900, 3]
type = ChangeState
triggerall = root,movetype != H
trigger1 = root,stateno = 3102 && root,var(5) = 1 && root,animelem = 36
trigger2 = root,stateno = 3102 && root,var(5) = 2 && root,animelem = 51
value = 23102

[State 5900, 3]
type = ChangeState
triggerall = root,movetype != H
trigger1 = root,stateno = 3200 && root,animelem = 1
value = 23200

[State 5900, 3]
type = ChangeState
trigger1 = Pos Y <= -135
trigger1 = root,stateno = 170 || root,stateno = 175
value = 20170

[State 5900, 3]
type = ChangeState
trigger1 = root,stateno = 183
value = 20180

[State 5900, 3]
type = ChangeState
trigger1 = root,stateno = 186 && root,animelem = 5
value = 20182

[State 5900, 3]
type = ChangeState
trigger1 = root,stateno = 191 && prevstateno != 20190
value = 20190

[State 5900, 3]
type = ChangeState
trigger1 = rootdist X > 70
value = 20020

[State 5900, 3]
type = ChangeState
trigger1 = rootdist X < -70
value = 20021

[State 5900, 3]
type = ChangeState
trigger1 = var(1) >= 300
value = 20001

