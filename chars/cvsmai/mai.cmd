triggerall = !var(22)
TriggerAll = var(43)&&floor(var(50)/100000%10)=1 || var(30)=3&&floor(var(52)/100%10)=1 || var(30)=4 && floor(var(52)/10%10)=1 && fvar(8)=-1
triggerall = (StateNo = [1000,1999])|| StateNo = 4505
trigger1   = MoveHit && ((StateNo = [1100,1199]) || (StateNo = [1300,1399]) || (StateNo = [1400,1499]))
trigger2   = (ProjContactTime(1050)=[1,18]) && (StateNo = [1000,1099])
var(22)    = -2
ignorehitpause = 1

;------------------------
[State -1,空振りキャンセル]
