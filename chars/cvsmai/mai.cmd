;---------------------------------------------------------------------
[State -1,Lv.2スパコンキャンセル]
type = varset
triggerall = RoundState = 2
triggerall = !var(22)
triggerall = Var(30) = 1
trigger1   = ((ProjHitTime(3061)=[1,18])||(ProjHitTime(3062)=[1,18])||(ProjHitTime(3063)=[1,18]))&& StateNo = 3010
trigger2   = ((ProjHitTime(3064)=[1,18])||(ProjHitTime(3065)=[1,18])||(ProjHitTime(3066)=[1,18]))&& StateNo = 3010
trigger3   = ((ProjHitTime(3067)=[1,18])||(ProjHitTime(3068)=[1,18])||(ProjHitTime(3069)=[1,18]))&& StateNo = 3010
trigger4   = (PrevStateNo = 3110 && StateNo = 3105 || StateNo = 3110) && MoveHit && var(36) = 1
trigger5   = (PrevStateNo = 3210 && StateNo = 3205 || StateNo = 3210) && MoveHit && var(36) = 1
var(22)    = -1
ignorehitpause = 1

;------------------------
[State -1,スパコンキャンセル（EXグルーヴ）]
type       = varset
