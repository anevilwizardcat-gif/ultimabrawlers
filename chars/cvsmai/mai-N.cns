;---------------------------------------------------------------------------
; プレイントロ
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, ChangeState]
type = ChangeState
triggerall = roundno = 1
triggerall = Time = 0
trigger1 = P2Name = "Chun Li" || P4Name = "Chun Li"
trigger2 = P2Name = "cvschunli" || P4Name = "cvschunli"
value = 192

[State 190, ChangeState]
type = ChangeState
triggerall = roundno = 1
triggerall = Time = 0
trigger1 = (P2Name = "Joe Higashi" || P4Name = "Joe Higashi") && enemy,authorName = "H”"
trigger2 = P2Name = "cvsjoe" || P4Name = "cvsjoe"
value = 193

[State 190, ChangeState]
type = ChangeState
triggerall = roundno = 1
triggerall = Time = 0
trigger1 = (P2Name = "cvsyoko" || P4Name = "cvsyoko") && EnemyNear,AuthorName = "warusaki3"
value = 194

[State 180,ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 191

