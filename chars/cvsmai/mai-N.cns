type = S
ctrl = 0
anim = 182
velset = 0,0,0

[State 100,1]
type = PlaySnd
trigger1 = AnimElem = 11
value = 0, 3
channel = 0

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,200]
flag = RoundNotOver

