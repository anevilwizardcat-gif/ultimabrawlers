triggerall = GetHitVar(fall) = 1
triggerall = Time = 1 && Alive && Random < 400
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5002 || Anim = 5012 || Anim = 5022
value = 5000,20
channel = 0

