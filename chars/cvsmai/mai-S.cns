;===================================================================== 
; Definition of the Special Arts
;=====================================================================

;-------------------------------------------------------------------------------
; 花蝶扇
;------------------------弱
[Statedef 1000]
type = S
movetype = A
physics = S
anim = 1000
ctrl = 0
velset = 0,0
poweradd = floor(72*fvar(5))

[State -2,VarSet]
type = VarSet
trigger1 = Time = 0 && var(22)=-1
var(25) = 0

[State -2,VarSet]
type = VarSet
trigger1 = Time = 0
var(20) = 100
[State -2,VarSet]
type = VarSet
trigger1 = Time = 0
var(21) = 100

[State 200,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1,=1
value = 0,11
channel = 0

[State 1200,helper]
type = helper
trigger1 = AnimElem = 5,=0
name = "Kacho Sen"
id = 1050
pos = 58,-78
postype = p1
stateno = 1050
helpertype = normal
ownpal = 1
keyctrl = 0
ignorehitpause = 1
persistent = 0

[State 1000,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

