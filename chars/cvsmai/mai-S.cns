trigger1 = AnimElem = 5,=1
value = 2, 1

[State 193, 1]
type = Explod
trigger1 = AnimElem = 5,=1
anim = 1150
id = 1150
pos = 0,0
scale = 2,2
bindtime = -1
sprpriority = 2
ownpal = 1
removeongethit = 1

[State 3000,Projectile]
type = Projectile
trigger1 = AnimElem = 5,=1
projanim = 1155
ProjHitAnim = -1
projid = 1150
offset = 0,0
attr = S, SP
damage = 0
guardflag = M
hitflag = P
projremovetime = 21

[State 1321, HitDef]
type = HitDef
triggerall = var(25) < 1
trigger1 = !MoveContact
trigger1 = !MoveReversed
trigger1 = AnimElem = 6 || AnimElem = 7
trigger1 = NumProjid(1150)
attr = S, SA
damage    = ceil(ifelse(var(12)<7,7,var(12))),ceil(ifelse((var(12)/8)<7,7,(var(12)/8)))
animtype = back
getpower = floor(IfElse(var(41)>1,72,143)*fvar(5)),floor(36*fvar(5))
givepower = 35, 35
guardflag = M
hitflag = MAF
hitsound = S5,11
guardsound = S6,0
pausetime = 4,Ceil(12*IfElse(var(47),.5,1))
sparkno = S8210+(random%8)
guard.sparkno = S8105
sparkxy = var(20),var(21)
ground.type = Low
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = -4.5,-7
air.velocity = -4.5,-7
guard.velocity = -10
yaccel = .5
fall = 1
fall.recover = 0
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
palfx.time = 44
palfx.add = 159,8,15
palfx.mul = 100, 20, 25
palfx.color = 100
id = 1100
envshake.time = 10
envshake.ampl = 2
forcestand = 1

[State 1000, 0]
type = RemoveExplod
trigger1 = NumProjid(1150)!
id = 1150

[State 1205, PosAdd]
type = PosAdd
trigger1 = AnimElem = 2 || AnimElem = 3
x = 4

[State 1205, PosAdd]
type = PosAdd
trigger1 = AnimElem = 4 || AnimElem = 5 || AnimElem = 6 || AnimElem = 7
x = 5

[State 420,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 8
movetype = I

[State 1000,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

