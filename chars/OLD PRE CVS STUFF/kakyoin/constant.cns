;---------------------------------------------------------------------------
; States that are always checked (use -2) :
;---------------------------------------------------------------------------
[Statedef -2]
; PLAYMODE SETTINGS
; These state controller batch cannot be optimized because of the pallete triggers.

[State -2, Asserts Crossover Mode]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base playmode on button selection
trigger1 = PalNo = [1,6] ;Buttons X to C are pressed
trigger2 = var(7) = 1 ;Kakyoin.AI explictly tells you to use Crossover Mode
var(6) = 0

[State -2, Asserts JoJo's Venture Mode]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base playmode on button selection
trigger1 = PalNo = 10 ; button X is pressed
trigger2 = var(7) = 2 ;Kakyoin.AI explictly tells you to use JoJo's Venture Mode
var(6) = 1

[State -2, Asserts JoJo's Bizarre Adventure Mode]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base playmode on button selection
trigger1 = PalNo = 7 ; button A is pressed
trigger2 = var(7) = 3 ;Kakyoin.AI explictly tells you to use JoJo's Bizarre Adventure Mode
var(6) = 2

[State -2, Asserts New Kakyoin JoJo's Venture Mode]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base playmode on button selection
trigger1 = PalNo = 11 ; button Y is pressed
trigger2 = var(7) = 4 ;Kakyoin.AI explictly tells you to use New Kakyoin JoJo's Venture Mode
var(6) = 3

[State -2, Asserts New Kakyoin JoJo's Bizarre Adventure Mode]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base playmode on button selection
trigger1 = PalNo = 8 ; button B is pressed
trigger2 = var(7) = 5 ;Kakyoin.AI explictly tells you to use New Kakyoin JoJo's Bizarre Adventure Mode
var(6) = 4

[State -2, Asserts Custom Mode]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base playmode on button selection
trigger1 = PalNo = 9 || PalNo = 12 ; buttons C or Z are pressed
trigger2 = var(7) = 6  ;Kakyoin.AI explictly tells you to use Custom Mode
var(6) = 5

[State -2, Randomizes which playmode to use]
type = VarRandom
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 7 && matchno = 1 ;Randomizes which Playmode to use, chosen mode will be used for the whole game.
trigger2 = var(7) = 8 && roundno = 1 ;Randomizes which Playmode to use, will always pick another mode every start of a match.
v = 6
range = 0,4
ignorehitpause = 1

; BUTTON LAYOUT SETTINGS
; These state controller batch cannot be optimized because of the pallete triggers.

[State -2, Asserts Catalyst aka. Crossover Button Layout]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base button layout on button selection
trigger1 = var(6) = 0 ;Crossover Playmode is activated 
trigger2 = var(7) = 1 ;Kakyoin.AI explictly tells you to use Crossover Mode
trigger3 = var(6) = 5 ;Custom Playmode is activated
trigger3 = var(7) = 6 ;Kakyoin.AI explictly tells you to use Custom Playmode
trigger3 = var(9) = 1 ;Kakyoin.AI explictly tells you to use Crossover Button Layout
var(8) = 0

[State -2, Asserts Original JoJo button layout]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(7) = 0 ;Kakyoin.AI tells you to base button layout on button selection
trigger1 = (var(6) = [1,4]) ;Normal/New Kakyoin JoJo's Venture or JoJo's Bizarre Adventure playmode is activated 
trigger2 = (var(7) = [2,5]) ;Kakyoin.AI explictly tells you to use Normal/New Kakyoin JoJo's Venture Mode/JoJo's Bizarre Adventure Mode
trigger3 = var(6) = 5 ;Custom Playmode is activated
trigger3 = var(7) = 6 ;Kakyoin.AI explictly tells you to use Custom Playmode
trigger3 = var(9) = 2 ;Custom Layout Option tells you to use Original (JV/JJBA) Button Layout
var(8) = 1

[State -2, Randomizes which button layout to use]
type = VarRandom
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
triggerall = var(6) = 5 ;Custom Play Mode is activated
triggerall = var(7) = 6 ;Kakyoin.AI explictly tells you to use Custom Playmode
trigger1 = var(9) = 3 && matchno = 1 ;Randomizes which Playmode to use, chosen mode will be used for the whole game.
trigger2 = var(9) = 4 && roundno = 1 ;Randomizes which Playmode to use, will always pick another mode every start of a match.
v = 8
range = 0,1
ignorehitpause = 1

; SUPER CHIME SETTINGS
; These state controller batch cannot be optimized because of the pallete triggers.

[State -2, Asserts JoJo's Bizarre Adventure Chime]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(6) = 0 || var(6) = 2 || var(6) = 4 ;Either Crossover or Normal/New Kakyoin JoJo's Bizarre Adventure mode is activated
trigger2 = var(6) = 5 ;Custom Play Mode is activated
trigger2 = var(13) = 1 ;Kakyoin.AI explictly tells you to use JJBA super chime
var(12) = 0

[State -2, Asserts JoJo's Venture Chime]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(6) = 1 || var(6) = 3 ;Normal/New Kakyoin JoJo's Venture Mode is activated
trigger2 = var(6) = 5 ;Custom Play Mode is activated
trigger2 = var(13) = 2 ;Kakyoin.AI explictly tells you to use JV super chime
var(12) = 1

[State -2, Randomizes which super chime to use]
type = VarRandom
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = var(6) = 5 ;Custom Play Mode is activated
triggerall = var(7) = 6 ;Kakyoin.AI explictly tells you to use Custom Playmode
trigger1 = var(13) = 3 && roundstate = 0 && matchno = 1 ;Randomizes which Playmode to use, chosen mode will be used for the whole game.
trigger2 = var(13) = 4 && roundstate = 0 && roundno = 1 ;Randomizes which Playmode to use, will always pick another mode every start of a match.
trigger3 = var(13) = 5 ;Randomizes which Playmode to use, will always pick another mode all the time.
v = 12
range = 0,1
ignorehitpause = 1

; ROLLING GETUP SETTINGS

[State -2, Asserts Rolling Getup function]
type = VarSet
trigger1 = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
trigger1 = roundstate = 0 ;Calculates only during the initialization of the match.
var(14) = ifelse(var(6) = 0 || (var(6) = 5 && var(15) = 1), 0, 1)

[State -2, Randomizes rolling getup ability to use]
type = VarRandom
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = var(6) = 5 ;Custom Play Mode is activated
triggerall = var(7) = 6 ;Kakyoin.AI explictly tells you to use Custom Playmode
trigger1 = var(15) = 3 && roundstate = 0 && matchno = 1 ;Randomizes which Playmode to use, chosen mode will be used for the whole game.
trigger2 = var(15) = 4 && roundstate = 0 && roundno = 1 ;Randomizes which Playmode to use, will always pick another mode every start of a match.
trigger3 = var(15) = 5 ;Randomizes which Playmode to use, will always pick another mode all the time.
v = 14
range = 0,1
ignorehitpause = 1

; ANIMATION QUALITY SETTINGS

[State -2, Asserts Enhanced Animation quality type]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(17) = 0 ; Default to mode selected
trigger1 = var(6) = 0 ; Crossover Mode
trigger2 = var(17) = 1 ; explictly selected enhanced
trigger2 = var(6) = 5 ; Custom Mode
var(16) = 0

[State -2, Asserts JoJo's Venture Animation quality type]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(17) = 0 ; Default to mode selected
trigger1 = var(6) = 1 || var(6) = 3 ; JV Original or JV New
trigger2 = var(17) = 2 ; explictly JV enhanced
trigger2 = var(6) = 5 ; Custom Mode
var(16) = 1

[State -2, Asserts JoJo's Venture Animation quality type]
type = VarSet
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(17) = 0 ; Default to mode selected
trigger1 = var(6) = 2 || var(6) = 4 ; JJBA Original or JJBA New
trigger2 = var(17) = 3 ; explictly JV enhanced
trigger2 = var(6) = 5 ; Custom Mode
var(16) = 2

[State -2, Randomizes animation quality]
type = VarRandom
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
triggerall = var(6) = 5 ;Custom Play Mode is activated
triggerall = var(7) = 6 ;Kakyoin.AI explictly tells you to use Custom Playmode
trigger1 = var(17) = 4 && roundstate = 0 && matchno = 1 ;Randomizes which Playmode to use, chosen mode will be used for the whole game.
trigger2 = var(17) = 5 && roundstate = 0 && roundno = 1 ;Randomizes which Playmode to use, will always pick another mode every start of a match.
trigger3 = var(17) = 6 ;Randomizes which Playmode to use, will always pick another mode all the time.
v = 16
range = 0,2
ignorehitpause = 1

; LANGUAGE

[State -2, Language type]
type = VarSet
trigger1 = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
trigger1 = roundstate = 0 ;Calculates only during the initialization of the match.
trigger1 = var(27) = [0,1]
var(26) = var(27)

[State -2, Randomizes Language Type]
type = VarRandom
triggerall = Name = "Noriaki Kakyoin" ;Prevents other characters from parsing this state during custom throws.
trigger1 = var(26) = 2 && roundstate = 0 && matchno = 1 ;Randomizes which Playmode to use, chosen mode will be used for the whole game.
trigger2 = var(26) = 3 && roundstate = 0 && roundno = 1 ;Randomizes which Playmode to use, will always pick another mode every start of a match.
trigger3 = var(26) = 4 ;Randomizes which Playmode to use, will always pick another mode all the time.
v = 26
range = 0,1
ignorehitpause = 1

