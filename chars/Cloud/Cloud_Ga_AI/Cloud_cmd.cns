;---------------------------------------------------------------------------
[Statedef -1]

[State -1, Tick Fix]
type = Null;CtrlSet
triggerall = !ctrl
trigger1 = (StateNo = 52 || StateNo = 101 || StateNo = 5120) && !AnimTime
trigger2 = (StateNo = [200,499]) && !AnimTime
trigger3 = StateNo = 810 && !AnimTime
trigger4 = (StateNo = 5001 || StateNo = 5011 || StateNo = 151 || StateNo = 153) && HitOver
trigger5 = (StateNo = [700,715]) && !AnimTime
trigger6 = (StateNo = [6080,6082]) && !AnimTime
value = 1
;--------------------------------------------------------------------
[State -1, OmniSlash]
type=ChangeState
value=3500
triggerall=!var(59) && RoundState=2 && StateType != A &&var(20)<=0&& power >= 3000&&command ="OmniSlash"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)
;--------------------------------------------------------------------
[State -1, Finishing Touch]
type=ChangeState
value=3400
triggerall=!var(59) && RoundState=2 && StateType != A &&var(20)<=0&& power >= 3000&&command ="FinishingTouch"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)
;----------------------------------------------------------------------
[State -1, Max Limit Break Braver]
type=ChangeState
value=3350
triggerall=!var(59) && RoundState=2 && StateType != A &&var(20) <= 60 && power >= 2000&&command ="MaxLimitBreakBraver"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Limit Break Braver]
type=ChangeState
value=3300
triggerall=!var(59) && RoundState=2 && stateno!= 3300 && StateType != A &&var(20) <= 60 && power >= 1000&&command ="LimitBreakBraver"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
