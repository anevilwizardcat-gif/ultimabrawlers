triggerall=!var(59) && RoundState=2 && StateType != A &&var(20) <= 60 && power >= 2000&&command ="MaxCrossSlash"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Cross Slash]
type=ChangeState
value=3200
triggerall=!var(59) && RoundState=2 && stateno!= 3200 && StateType != A &&var(20) <= 60 && power >= 1000&&command ="CrossSlash"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Max Limit Break Climhazard]
type=ChangeState
value=3150
triggerall=!var(59) && RoundState=2 && StateType != A &&var(20) <= 60 && power >= 2000&&command ="MaxLimitBreakClimhazard"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Limit Break Climhazard]
type=ChangeState
value=3100
triggerall=!var(59) && RoundState=2 && (stateno!= [3100,3101]) && StateType != A &&var(20) <= 60 && power >= 1000&&command ="LimitBreakClimhazard"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Max Meteor Rain]
type=ChangeState
value=3050
triggerall=!var(59) && RoundState=2 && StateType != A &&var(20) <= 60 && power >= 2000&&command ="MaxMeteorRain"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Max Air Meteor Rain]
type=ChangeState
value=3075
triggerall=!var(59) && RoundState=2 && StateType = A && Pos y<=-20 &&var(20) <= 60 && power >= 2000&&command ="MaxMeteorRain"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Meteor Rain]
type=ChangeState
value=3000
triggerall=!var(59) && RoundState=2 && stateno!= 3000 && !numhelper(3005) && StateType != A &&var(20) <= 60 && power >= 1000&&command ="MeteorRain"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;----------------------------------------------------------------------
[State -1, Air Meteor Rain]
type=ChangeState
value=3025
triggerall=!var(59) && RoundState=2 && stateno!= 3025 && !numhelper(3005) && StateType = A && Pos y<=-20 &&var(20) <= 60 && power >= 1000&&command ="MeteorRain"
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(6)|| var(7)
;======================================================================
[State -1, Climhazard]
type=ChangeState
value=Ifelse(command="ClimhazardEX"&&var(20) <= 60&&power>=500,1350,1300)
triggerall=!var(59) && RoundState=2 && StateType != A && ((command="Climhazard1"|command="Climhazard2"|command="Climhazard3")||(command="ClimhazardEX"&&power>=500&&var(20) <= 60))
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(5)
trigger3=(stateno = 450) && movecontact && (command="ClimhazardEX"&&power>=500&&var(20) <= 60)
;----------------------------------------------------------------------
[State -1, Blade Beam]
type=ChangeState
value=Ifelse(command="BladeBeamEX"&&var(20) <= 60&&power>=500,1050,1000)
triggerall=!var(59) && RoundState=2 && StateType != A && Ifelse(!var(20),!Numhelper(1005),Numhelper(1005)<5)
triggerall= ((command="BladeBeam1"|command="BladeBeam2"|command="BladeBeam3")||(command="BladeBeamEX"&&power>=500&&var(20) <= 60))
trigger1=ctrl || StateNo=40 || StateNo=52 || (StateNo=[100,101])
trigger2=var(5)
trigger3=(stateno = 450) && movecontact && (command="BladeBeamEX"&&power>=500&&var(20) <= 60)
;----------------------------------------------------------------------
