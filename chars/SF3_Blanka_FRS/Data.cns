[State 0] ;Scaling
type = varset
triggerall = movehit
triggerall = target,stateno != [2060,2065]
trigger1 = numenemy && stateno != [801,803] 
trigger1 = stateno != [1200,1227]
trigger2 = stateno = [801,803] 
trigger2 = stateno != 800
trigger2 = prevstateno != 801
fvar(2) = fvar(2)*(0.95**(enemynear(0),gethitvar(hitcount))) ;fvar([Var_Here)*([Multiplier]**(enemynear(0),gethitvar(hitcount)))
ignorehitpause = 1

[state 0] ;Scaling Limit
type = varset
fvar(2) = 0.1
trigger1 = fvar(2) <= 0.1
ignorehitpause = 1

[State 0] ;Reset Scaling
type = Varset
trigger1 = numenemy
trigger1 = (enemynear,movetype!=H)
trigger2 = !numenemy
fvar(2) = 1
ignorehitpause = 1

