type    = S
movetype = I
physics = N
ctrl = 0
velset = 0,0
anim = 8050

[State 1000, Spark]
type = Explod
trigger1 = !time
Anim = 6350
id = 6350
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)

[State 4110, DestroySelf]
type = DestroySelf
trigger1 = time=1

