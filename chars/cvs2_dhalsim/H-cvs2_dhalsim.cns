[State 900, 4]
type = ChangeState
triggerall = time > 1
trigger1 = time>23+var(1)*24 && (var(17)!=[1,6]) && root,numprojid(6300) && var(16)<3+var(1)
trigger2 = root,stateno!=3050
trigger3 = !root,numprojid(6300)&&((var(17)!=[1,6])||var(16)>2+var(1))
value = 6350

