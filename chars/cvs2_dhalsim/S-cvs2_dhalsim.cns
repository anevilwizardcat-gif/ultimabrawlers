movetype = I
physics = N
ctrl = 0
velset = 0,0
anim = 1300

[State 1100, VarSet]
type = VarSet
trigger1 = Time=0
var(1)=0

[State 3000]
type = varset
trigger1 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

[State 1100,Change]
type = ChangeState
trigger1 = ifelse((prevstateno=[200,999]),time=1,Time=0)
value = 1350

