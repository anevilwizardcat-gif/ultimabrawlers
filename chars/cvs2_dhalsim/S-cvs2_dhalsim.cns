damage    = ifelse(ceil((91+var(1)*7)*parent,fvar(7))<7,7,ceil((91+var(1)*7)*parent,fvar(7))),ifelse(ceil(ceil((91+var(1)*7)*parent,fvar(7))/8)<7,7,ceil(ceil((91+var(1)*7)*parent,fvar(7))/8))
animtype  = Hard
getpower = ifelse(root,var(16),4,8)*parent,var(5),2*parent,var(5)
givepower = 2*parent,var(6),2*parent,var(6)
guardflag = MA
hitflag = MAF
pausetime = 2,1
guard.pausetime = 2,1
sparkno = s7200+random%8
guard.sparkno = s7010
sparkxy = ifelse(P2bodydist X<10,-10,ceil(P2bodydist X)), 0
hitsound   = S1,15
guardsound = S0,0
ground.type = High
ground.slidetime = 17
guard.slidetime = 17
ground.hittime  = 17
guard.hittime  = 17
air.hittime = 17
ground.velocity = -4,-6
guard.velocity = -10.65
airguard.velocity = -4
air.animtype = Back
air.velocity = -4,-6
yaccel = .4
fall = 1
fall.recover = 0
air.recover = 0
forcestand=1
palfx.color = 96
palfx.add = 0,0,-256
palfx.mul = 144,32,0
palfx.time = 52+floor(-enemynear,pos Y/8)

[State 200,VarSet]
type = ParentVarSet
trigger1 = 1
var(40) = ifelse(P2bodydist X<10,-10,ceil(P2bodydist X))

[State 200,VarSet]
type = ParentVarSet
trigger1 = 1
var(41) = -floor(120*root,const(size.yscale))

[State 1000, 0]
type = EnvShake
trigger1 = root,projcontacttime(6200)=1
time = 12
ampl = 2
ignorehitpause = 1
persistent=0

[State 200,VarSet]
type = VarSet
trigger1 = root,projcontacttime(6200)=1
var(13) = 1

[State 6200,VarSet]
type = VarSet
trigger1 = time > 1 && !root,NumProjID(6200)
var(0) = 1

[State 900, 4]
type = ChangeState
triggerall = time > 1
trigger1 = time>12+var(1)*6
trigger2 = root,stateno!=1250
trigger3 = !root,NumProjID(6200)
value = 6250

;---------------------------------------------------------------------------
;ヨガブラスト(飛び道具・消滅)/Yoga Blast (Projectile)
[Statedef 6250]
type    = A
movetype = I
physics = N
ctrl = 0
velset = 0,0
anim = 8050

[State 4120, DestroySelf]
type = PlaySnd
trigger1 = !time && !var(13) && var(0)
value = 0,10

[State 1000, Spark]
type = Explod
trigger1 = !time
Anim = 6250
id = 6250
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)

[State 4120, DestroySelf]
type = DestroySelf
trigger1 = !time

