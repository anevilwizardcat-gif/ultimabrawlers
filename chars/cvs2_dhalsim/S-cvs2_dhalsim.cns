trigger1 = AnimTime=0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;ヨガファイア/Yoga Fire (Projectile)
[Statedef 6000]
type    = A
movetype = A
physics = N
ctrl = 0
velset = 0,0
anim = 6000
sprpriority = 4

[State 6000]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[state 6000]
type = PlaySND
trigger1 = time=0
value = 5,2
channle = 3

[state 6000]
type = velset
trigger1 = time
x = (3.0+var(1))*const(size.xscale)

[State 6000]
type = varset
trigger1 = time=0
var(1) = root,var(1)

[State 6000,VarSet]
type = varset
trigger1 = time>=1 && !(!root,var(18)||root,var(56))
var(18) = 1

[State 6000,VarSet]
type = varset
trigger1 = time>=1 && (!root,var(18)||root,var(56))
var(18) = 0

[state 6000]
type = varset
trigger1 = !root,numprojid(6000) && time>1
var(16) = 1
ignorehitpause=1

[State 6000,Projectile]
type = Projectile
trigger1 = time>0 && !var(16)
projanim = ifelse(var(18),8050,6010+(time>1))
projID = 6000
projshadow = -1
velocity = vel x, vel y
accel = 0, 0
projhits = 1
projmisstime = 0
projremovetime=1
projedgebound=130
projstagebound=130
sprpriority = 5
; HitDefs
attr = S, SP
damage    = ifelse(ceil((49+var(1)*7)*parent,fvar(7))<7,7,ceil((49+var(1)*7)*parent,fvar(7))),ifelse(ceil(ceil((49+var(1)*7)*parent,fvar(7))/8)<7,7,ceil(ceil((49+var(1)*7)*parent,fvar(7))/8))
animtype  = Hard
getpower = ifelse(root,var(16),4,8)*parent,var(5),2*parent,var(5)
givepower = 2*parent,var(6),2*parent,var(6)
guardflag = MA
hitflag = MAF
pausetime = 12,11
guard.pausetime = 12,11
sparkno = s7200+random%8
guard.sparkno = s7010
sparkxy = ifelse(P2bodydist X<10,-10,ceil(P2bodydist X)), 0
hitsound   = S1,15
guardsound = S0,0
ground.type = Low
ground.slidetime = 17
guard.slidetime = 17
ground.hittime  = 17
guard.hittime  = 17
air.hittime = 17
ground.velocity = ifelse(!var(1),-10.65/ifelse(root,var(21),2,1),-4),-6*(var(1)>0)
guard.velocity = -10.65/ifelse(root,var(21),2,1)
airguard.velocity = -4
air.animtype = Back
air.velocity = -4,-6
yaccel = .4
fall = var(1)>0
air.fall = 1
fall.recover = 0
air.recover = 0
forcestand=1
palfx.color = 96
palfx.add = 0,0,-256
palfx.mul = 144,32,0
palfx.time = ifelse(P2statetype!=A&&!var(1),28,46+floor(-enemynear,pos Y/8))

[State 6000,VarSet]
type = ParentVarSet
trigger1 = 1
var(40) = ifelse(P2bodydist X<10,-10,ceil(P2bodydist X))

[State 6000,VarSet]
type = ParentVarSet
trigger1 = 1
var(41) = -ceil(55*root,const(size.yscale))

[State 6000, DestroySelf]
type = DestroySelf
trigger1 = time && FrontEdgeDist <= -60

[State 6000]
type = ChangeState
triggerall = time > 1
trigger1 = !Root,NumProjID(6000)
value = 6050

[State 6000]
type = ChangeState
trigger1 = time > 88+var(1)*10
value = 6010

;---------------------------------------------------------------------------
;ヨガファイア/Yoga Fire (Projectile)
