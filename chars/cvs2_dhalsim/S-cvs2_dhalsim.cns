;ヨガテレポート/Yoga Teleport
[Statedef 1350]
type = U
movetype = I
physics = N
juggle = 15
poweradd = 4*var(5)
ctrl = 0
velset = 0,0
anim = 1300

[State 1100, VarSet]
type = VarSet
trigger1 = Time=0
var(2)=0

[State 1100, VarSet]
type = VarSet
trigger1 = Time=0 && statetype=A
var(2)=1

[State 1100, VarSet]
type = statetypeset
trigger1 = Time=0 && statetype!=A
statetype=A

[State 3000]
type = varset
trigger1 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

[state 1950]
type = NothitBy
trigger1 = !time;AnimElemTime(10)<0
value = SCA,AA,AT,AP
time = 62

;Yoga...
[state 1950]
type = PlaySND
trigger1 = AnimElem=1
value = 800,3
channel = 1

;フェードアウト
[state 1950]
type = Trans
trigger1 = AnimElemTime(7)<0
trans = AddAlpha
alpha = 256-time*28,0+time*28

;透明
[state 1950]
type = Trans
trigger1 = AnimElemTime(7)>=0 && AnimElemTime(21)<0
trans = AddAlpha
alpha = 0,256

[state 1950]
type = PlaySND
trigger1 = AnimElem=5
value = 5,0
channel = 2

[state 1950]
type = PosAdd
trigger1 = AnimElem=13
x = (ifelse(var(1)>1,240,120)*const(size.xscale))*ifelse(var(1)%2=1,-1,1)

;フェードイン
[state 1950]
type = Trans
trigger1 = AnimElemTime(19)>=0 && AnimElemTime(21)<0
trans = AddAlpha
alpha = 0+(time-51)*28,256-(time-51)*28

[state 1950]
type = PlaySND
trigger1 = AnimElem=20
value = 5,1
channel = 2

[state 1950]
type = Turn
trigger1 = AnimTime=0 &&P2dist X<=0 && var(2)

[state 1950]
type = ChangeState
trigger1 = AnimTime=0
value = 11+(var(2)>0)*39
ctrl = 1

