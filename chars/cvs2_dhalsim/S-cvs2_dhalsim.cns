[Statedef 1050]
type = S
movetype = A
physics = S
juggle = 15
poweradd = 4*var(5)
ctrl = 0
velset = 0,0
anim = 1000+var(1)*10

[State 3000]
type = varset
trigger1 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

;Yoga Fire!
[state 1950]
type = PlaySND
trigger1 = AnimElem=1
value = 1000,0
channel = 1

[state 1000]
type = Helper
trigger1 = AnimElem=5
stateno=6000
id = 6000
name = "fire"
