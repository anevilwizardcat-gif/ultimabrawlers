;ダイレクトライトニング隙
[Statedef 3050]
type = A
physics = N
ctrl = 0

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = Anim=3000
movetype=A

[State 1000,VelMul]
type = VelSet
trigger1 = Anim=3000 && vel Y>0
x = Vel X*.75
persistent=0

[State 420,PlaySnd]
type = PlaySnd
trigger1 = Anim=3000 && AnimElem = 3,=1
value = 2, 3

[State 1000,VelMul]
type = VelAdd
trigger1 = Anim=3000
y = .675

[State 1000,ChangeAnim]
type = ChangeAnim
trigger1 = Vel X && Vel Y>0 && Pos Y>=0
trigger2 = !Vel X && Anim=3000
value = 3050

[State 1000,VelMul]
type = VelSet
trigger1 = Anim=3050
x = 0
y = 0

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = Anim=3050
statetype=S
movetype=I
physics=S

[State 1000,VelMul]
type = PosSet
trigger1 = Anim=3050
y = 0

[State 52, PlaySnd]
type = PlaySnd
trigger1 = Anim=3050 && AnimElem=1
value = 52, 0

[State 100, Explod]
type = Explod
trigger1 = Anim=3050 && AnimElem=1
Anim = 7910
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
sprpriority = -2
scale = .5,.5

[State 200,Exit]
type = ChangeState
trigger1 = Anim=3050 && AnimTime=0
value = 11
ctrl = 1

