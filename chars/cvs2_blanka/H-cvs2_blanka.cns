;****************************************
;ダイレクトライトニングLV.1
;****************************************
[Statedef 3000]
type = S
movetype = A
physics = S
ctrl = 0
velset = 0,0
poweradd = -1000+(!var(22)&&var(59)=3 && (100*Life/const(data.life))<=30)*1000-(var(59)=1&&!var(21))*500
juggle = 15
anim=3000

[state 1320]
type = varset
trigger1 = time=0
var(1)=0

[State 3000]
type = varset
trigger1 = time=0
var(19)=0

[State 3000]
type = varset
trigger1 = (prevstateno=[1000,2099]) && time=0 && !var(21)
trigger2 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

[State 3500, AfterImage]
type = AfterImage
trigger1 = time=4 && (prevstateno!=[3000,3999]) && !var(56)
time = 999
length = 10
TimeGap  = 3
FrameGap = 4
palbright = 1,1,1
palContrast = 128, 128, 128
PalMul = .5,.5,.5
trans = add1

[State -2, super]
type = Helper
trigger1 = !NumHelper(7500) && Time=2
helpertype = normal
name = "super_effect"
id = 7500
facing = 1
pos = 20,-50
postype = P1
stateno = 7500+(var(59)=[3,5])*10
keyctrl = 0
pausemovetime = 9999
supermovetime = 9999
ownpal = 1
ignorehitpause = 1

[State 3500,NotHitby]
type = Varset
trigger1 = Time=0
fvar(11)=random%2

[State 3040,Pause]
type = Pause
trigger1 = time=4 && !fvar(11)
time = 52
movetime = 52

;強制停止時間のズレ
[State 3040,Pause]
type = Pause
trigger1 = time=4 && fvar(11)
time = 52-1
movetime = 52-1

[State 1600,NotHitBy]
type = NotHitBy
trigger1 = time=0
value = SCA
time = 56

[State 420,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 3000, 0
channel = 1

[State 420,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 3000, 1

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = time=0
statetype=A
physics=N

[State 1000, Spark]
type = Explod
trigger1 = AnimElem = 6 && !numExplod(6100)
Anim = 6100
id = 6100
pos = 0, -30
postype = p1
ownpal = 1
bindtime = -1
removetime = -1
sprpriority = 4
removeongethit = 1
scale = 1.75,1.75
persistent=0
ignorehitpause=0

[State 1000, Spark]
type = Explod
trigger1 = AnimElem=6,=0
trigger2 = AnimElem=16,=0
Anim = 6200+random%3*100
id = 6200
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
pausemovetime = ifelse(var(1)=2,3,ifelse(var(1)=1,1,0))
sprpriority = 2
scale = 1,1

[State 220,Hitdef]
type = HitDef
trigger1 = AnimElem=6
attr = A, HA
damage    = ifelse(ceil(192*fvar(7))<7,7,ceil(192*fvar(7))),ifelse(ceil(ceil(192*fvar(7))/8)<7,7,ceil(ceil(192*fvar(7))/8))
animtype = Hard
guardflag = M
hitflag = MAF
pausetime = floor(10/ifelse(var(56),2,1)),floor(9/ifelse(var(56),2,1))
sparkno = s7300+(random%8)
guard.sparkno = s7010
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),-45
hitsound = S1, 10
guardsound = S0, 0
ground.type = High
ground.slidetime = 15
ground.hittime  = 15
ground.velocity = -3.5,-7.5
guard.velocity = -9.5
air.velocity = -4.0,-3.5
air.cornerpush.veloff = 0
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = ifelse((fvar(23)-4)<0,0,-22.0)
fall = 1
air.fall = 1
yaccel = .5
fall.recover= 0
air.recover=0
getpower = 0
givepower = 2*var(6),2*var(6)
forcestand = 1
palfx.color = 0
palfx.time = 44
palfx.add = 104,104,172;80,40,80;30,30,50
palfx.mul = 128,128,192;180,180,255
priority = 7,Hit

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(40) = ifelse((Abs(P2bodydist X)-10)<20,-20,-10)

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(41) = -45

[State 1000, 0]
type = EnvShake
trigger1 = numtarget
trigger1 = movecontact=1 && target,time=0
time = 12
ampl = 4
ignorehitpause=1

[State 900,2]
type = PlayerPush
trigger1 = AnimElemTime(6)>=0 && P2statetype=L
value = 0

[State 200,VelSet]
type = VelSet
trigger1 = AnimElemTime(6)>=0 && !movecontact && !movereversed
x = 10.0;9.45

[State 200,VelSet]
type = VelSet
trigger1 = time= 78 || FrontEdgeBodyDist <10
x = 0

[State 200,VelSet]
type = VelSet
trigger1 = movecontact || movereversed
x = -3.2;ifelse(moveguarded,-2.2,-3.2)
y = -9.15;-10.35

[State 200,Exit]
type = ChangeState
trigger1 = time= 78 || movecontact || movereversed || FrontEdgeBodyDist <10
value = 3050


