;コモンステート
;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback" && (statetype!=A ||(statetype=A && P2Dist X>=0))
trigger2 = !inguarddist
trigger3 = command != "holdfwd" && P2Dist X<0 && Statetype=A
value = 140

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
[Statedef 130]
type    = S
physics = S

[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, Hi to Lo]
type = ChangeState
trigger1 = command = "holddown" && !fvar(38)
trigger2 = P2statetype!=A&&fvar(38)
value = 131

[State 131, Lo to Hi]
type = CtrlSet
trigger1 = fvar(38)
value = 0

[State 131, Lo to Hi]
type = CtrlSet
trigger1 = time>=(16+(random%5))&&fvar(38)
value = 1

[State 131, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"&&!fvar(38)
trigger2 = !inguarddist&&!fvar(38)
trigger3 = !inguarddist&&time>=12&&fvar(38)
value = 140

;---------------------------------------------------------------------------
