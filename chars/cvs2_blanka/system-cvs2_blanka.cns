value = 131

[State 131, Lo to Hi]
type = ChangeState
trigger1 = command != "holddown" && !fvar(38)
trigger2 = P2statetype=A&&enemynear,vel Y>=0&&fvar(38)
value = 130

[State 131, Lo to Hi]
type = CtrlSet
trigger1 = fvar(38)
value = 0

[State 131, Lo to Hi]
type = CtrlSet
trigger1 = time>=(16+(random%5))&&fvar(38)
value = 1

[State 131, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"&&!fvar(38)
trigger2 = !inguarddist&&!fvar(38)
trigger3 = !inguarddist&&time>=12&&fvar(38)
value = 140

