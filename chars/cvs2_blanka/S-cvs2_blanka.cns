;------------------------------------------------------------------------------------------
;****************************************
;弱エレクトリックサンダー
;****************************************
[Statedef 1000]
type    = S
movetype = A
physics = S
anim = 1000
juggle = 15
velset = 0,0
ctrl = 0
poweradd = ifelse((prevstateno!=[1000,1020]),4,0)*var(5)

[State 3000]
type = varset
trigger1 = time=0
var(19)=0

[State 3000]
type = varset
trigger1 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

[State 1010,varset]
type = varset
trigger1 = Time=0
var(46) = 0

[State 1010,varset]
type = varAdd
trigger1 = AnimTime=0 && Anim=1000
var(46) = 1

[State 1010, 3]
type = ChangeState
trigger1 = Anim=1000 && var(46)>=1 && AnimElemTime(3)>=0 && (command="z"||command="y")&&!fvar(38)
value = ifelse(command="z",1020,1010)

[State 1010, 3]
type = ChangeAnim
trigger1 = Anim=1000 && AnimElem=1 && (prevstateno=1010||prevstateno=1020)
value = 1000
elem = 3

[State 1010, 3]
type = ChangeAnim
trigger1 = Anim=1000 && AnimTime=0 && var(45)<1
value = 1050

[State 1010, 3]
type = ChangeAnim
trigger1 = Anim=1000 && AnimTime=0
value = 1000
elem=3

[State 1010, Voice]
type = PlaySnd
triggerall = Anim= 1000
trigger1 = AnimElem = 3
value = 1000, 0
loop = 1
channel = 30
persistent=0

[State 1010, Effect]
type = PlaySnd
triggerall = Anim=1000
trigger1 = AnimElem = 5,=0 && var(46)%4=0
value = 10, 2
channel = 1

[State 1010, Voice]
type = StopSnd
trigger1 = Anim=1050
channel = 1

[State 9500, helper]
type = RemoveExplod
triggerall = numexplod(6000)
trigger1 = Time=0
trigger2 = Anim=1050
id = 6000

[State 9500, helper]
type = Explod
trigger1 = AnimElem = 3 && !numexplod(6000)
id = 6000
anim = 6000
pos = 0, 0
postype = p1
ownpal = 1
bindtime = -1
removetime=-1
sprpriority = 4
ignorehitpause = 1
persistent = 0

[State 1010, 1]
type = Hitdef
triggerall = !var(18)||var(56)
trigger1 = AnimElem = 3
trigger2 = AnimElem = 5
attr = S, SA
hitflag = MAF
guardflag = M
animtype = Hard
priority = 4,Hit
damage    = ifelse(ceil(98*fvar(7))<7,7,ceil(98*fvar(7))), ifelse(ceil(ceil(98*fvar(7))/8)<7,7,ceil(ceil(98*fvar(7))/8))
pausetime = floor(11/ifelse(var(21),2,1)),floor(10/ifelse(var(21),2,1))
guard.pausetime = floor(13/ifelse(var(21),2,1)),floor(14/ifelse(var(21),2,1))
sparkno = s7200+(random%8)
guard.sparkno = s7010
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),-30
hitsound = S1, 10
guardsound = S0, 0
ground.type = Low
air.type = High
ground.slidetime = 18
ground.hittime = 18
air.hittime = 13
ground.velocity = ifelse(P2Dist X<=0,3.0,-3.0),-7.0
guard.velocity = ifelse(P2Dist X<=0,11.0,-11.0)
air.velocity = ifelse(P2Dist X<=0,3.0,-3.0),-7.0
yaccel = .45
fall = 1
air.fall = 1
fall.recover= 0
air.recover=0
air.cornerpush.veloff = 0
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = ifelse((fvar(23)-ifelse(var(21),1,ceil(14*1.0/2)))<0,0,-22.0)
getpower = ifelse(var(16),4,8)*var(5),2*var(5)
givepower = 2*var(6),2*var(6)
forcestand=1
palfx.color = 0
palfx.time = 44
palfx.add = 104,104,172;80,40,80;30,30,50
palfx.mul = 128,128,192;180,180,255

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(40) = ifelse((Abs(P2bodydist X)-10)<20,-20,-10)

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(41) = -50

[State 1000, 0]
type = EnvShake
trigger1 = numtarget
trigger1 = movecontact=1 && target,time=0
time = 8
ampl = 2
ignorehitpause = 1

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = Anim=1050
movetype = I

[State 1010, 3]
type = ChangeState
trigger1 = Anim=1050 && AnimTime = 0
value = 0
ctrl = 1

