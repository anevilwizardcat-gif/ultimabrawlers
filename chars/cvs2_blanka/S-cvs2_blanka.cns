[Statedef 1100]
type = S
movetype =A 
physics = S
juggle = 15
ctrl = 0
velset = 0,0
anim = 1100
poweradd = 4*var(5)

[State 3000]
type = varset
trigger1 = time=0
var(1)=0

[State 3000]
type = varset
trigger1 = time=0
var(19)=0

[State 3000]
type = varset
trigger1 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

[State 420,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 10, 2
channel = 1

[State 420,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3,=1
value = 2, 3

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = time=0
statetype=A
physics=N

[State 220,Hitdef]
type = HitDef
trigger1 = AnimElem=3
attr = A, SA
damage    = ifelse(ceil(84*fvar(7))<7,7,ceil(84*fvar(7))),ifelse(ceil(ceil(84*fvar(7))/8)<7,7,ceil(ceil(84*fvar(7))/8))
animtype = Hard
guardflag = MA
hitflag = MAF
pausetime = ceil(10-((var(21)>0)*10)/2),ceil(9-((var(21)>0)*9)/2)
sparkno = s7200+(random%8)
guard.sparkno = s7010
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),-45
hitsound = S1, 2
guardsound = S0, 0
ground.type = High
ground.slidetime = 15
ground.hittime  = 15
ground.velocity = -11.0
guard.velocity = -8.5
air.velocity = -5.0,-6.0
air.cornerpush.veloff = 0
ground.cornerpush.veloff = -22.0
guard.cornerpush.veloff = ifelse((fvar(23)-ifelse(var(21),1,ceil(12*1.0/2)))<0,0,-22.0)
yaccel = .5
fall.recover= 0
air.recover=0
getpower = ifelse(var(16),4,8)*var(5),2*var(5)
givepower = 2*var(6),2*var(6)
forcestand=1
air.fall = 1
priority = 5,Hit
palfx.color = ifelse(fvar(1),60,255)
palfx.mul = ifelse(fvar(1),255,128),ifelse(fvar(1),255,128),ifelse(fvar(1),255,128)
palfx.time = ifelse(fvar(1),ifelse(P2statetype=A,40,24),ifelse(var(14),10,0))
palfx.sinadd = 120,120,120,ifelse(fvar(1),3,0)
palfx.add = ifelse(fvar(1),0,255),ifelse(fvar(1),0,255),ifelse(fvar(1),0,255)

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(40) = ifelse((Abs(P2bodydist X)-10)<20,-20,-10)

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(41) = -45

[State 1000, 0]
type = EnvShake
trigger1 = numtarget
trigger1 = movecontact=1 && target,time=0
time = 8
ampl = 2
ignorehitpause=1

[State 900,2]
type = PlayerPush
trigger1 = AnimElemTime(2)>=0 && P2statetype=L
value = 0

[State 200,VelSet]
type = VelSet
trigger1 = AnimElemTime(2)>=0 && !movecontact && !movereversed
x = 6.0

[State 200,VelSet]
type = VelSet
trigger1 = time=22 || FrontEdgeBodyDist <10
x = 0

[State 200,VelSet]
type = VelSet
trigger1 = movecontact || movereversed
x = ifelse(moveguarded,-2.2,-3.2)
y = -10.35

[State 200,Exit]
type = ChangeState
trigger1 = time=22 || movecontact || movereversed || FrontEdgeBodyDist <10
value = 1150
