;電撃エフェクト
[Statedef 6000]
type = A
movetype = I
anim = 6000+ifelse(root,stateno=1020,20,ifelse(root,stateno=1010,10,0))

[State 6000,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 6000, SprPriority]
type = SprPriority
trigger1 = 1
value = 2

[State 6000, BindtoParent]
type = BindtoParent
trigger1 = 1
facing = 1
pos = 0,0
time=1

[State 6000, SprPriority]
type = varset
trigger1 = 1
var(1) = AnimElemNo(0)

[State 6000, SprPriority]
type = ChangeAnim
trigger1 = Anim!=(6000+ifelse(root,stateno=1020,20,ifelse(root,stateno=1010,10,0)))
value = 6000+ifelse(root,stateno=1020,20,ifelse(root,stateno=1010,10,0))
elem = var(1)

[State 6000, DestroySelf]
type = DestroySelf
trigger1 = parent,stateno!=[1000,1050]
trigger2 = parent,Anim=1050


