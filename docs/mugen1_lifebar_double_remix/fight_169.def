;==================================================================================================
; MUGEN1 LIFEBAR DOUBLE REMIX by Phantom.of.the.Server
;==================================================================================================

[Info]
name = "MUGEN1 Lifebar Double Remix"
author = "Phantom.of.the.Server"; A lot of the work done by Elecbyte and the Ikemen GO team
versiondate = 2025
ikemenversion = 1.0
mugenversion = 1.1; Just in case. Not an actual Mugen lifebar
localcoord = 1280, 720


;==================================================================================================
;Directories are checked in this order:
;1. current directory fight.def is in
;2. data/
;3. your MUGEN directory

[Files]
;Lifebar files
sff = fight.sff
font1 = font/geowords48.def
font2 = font/geonumbers48.def
font3 = font/geonames16.def

; Uncomment one line to select the announcer
snd = nocturnis.snd
;snd = ericbot.snd
;snd = ariabot.snd

;Common effect files
fightfx.sff = fightfx.sff
fightfx.air = fightfx.air
common.snd = common.snd

;Extra common effects .def files
;fx1 =

;Common effect configuration
[FightFx]
scale = 4


;==================================================================================================
[Lifebar]
mid.shift = 0                ;Ikemen feature: makes the shift element also affect mid element (default: 0)
mid.freeze = 1               ;Ikemen feature: controls mid element freezing during gethit/combo (default: 1)
mid.delay = 15               ;Ikemen feature: frames before mid element starts decreasing (default: 30)
mid.mult = 1.0               ;Ikemen feature: moving relation between mid value and life (default: 1.0)
mid.steps = 8                ;Ikemen feature: mid value decreasing steps (default: 8)

;Player 1
p1.pos = 590, 32
p1.bg0.anim = 10
p1.bg0.offset = -6, 6
p1.bg1.spr = 11, 0
;p1.red.spr = 13, 0
;p1.red.palfx.color = 0
;p1.red.offset = -6, 6
p1.mid.anim = 12
p1.mid.offset = -6, 6
p1.front.spr = 13, 0
p1.front.offset = -6, 6
p1.shift.spr = 13, 1
p1.shift.offset = -6, 6
p1.range.x = -6, -433

;Player 2
p2.pos = 690, 32
p2.bg0.anim = 10
p2.bg0.offset = 6, 6
p2.bg0.facing = -1
p2.bg1.spr = 11, 0
p2.bg1.facing = -1
;p2.red.spr = 13, 0
;p2.red.palfx.color = 0
;p2.red.offset = 6, 6
;p2.red.facing = -1
