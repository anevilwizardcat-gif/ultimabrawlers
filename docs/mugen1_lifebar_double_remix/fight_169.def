[Time]
pos = 640, 70
counter.offset = 0, 0
counter.font = 2, 0, 0, 255, 0, 0       ; 0-5 seconds
counter6.font = 2, 0, 0, 255, 224, 0	; 6-10 seconds
counter11.font = 2, 0, 0                ; 11+ seconds
framespercount = 60


;==================================================================================================
[Combo]
team1.pos = 30, 260          ;Coords to show
team1.start.x = -240         ;Starting x-coords
team1.counter.layerno = 2
team1.counter.font = 2, 3, 1, 255, 255, 255
team1.counter.shake = 1      ;Set to 1 to shake count on hit
team1.counter.time = 8       ;Ikemen feature: length of the counter shake
team1.counter.mult = 0.06    ;Ikemen feature: counter shake intensity multiplier
team1.text.layerno = 2
; Ikemen feature (text format %i = combo count, %d = combo damage, %p = combo damage percentage)
team1.text.text = "HITS %p%" ;You can use %i to show count in the text, eg "%i Hit!"
team1.text.font = 1, 4, 1, 96, 96, 255
team1.text.scale = 0.66, 0.66
team1.text.offset = 12, 0    ;Offset of text
team1.displaytime = 90       ;Time to show text
team1.showspeed = 4          ;Ikemen feature: text showing up speed (1 = instant) (distance / showspeed)
team1.hidespeed = 4          ;Ikemen feature: text hiding speed (the larger value, the faster speed) (linear)

team2.pos = 1250, 260
team2.start.x = 1520
team2.counter.layerno = 2
team2.counter.font = 2, 1, -1, 255, 255, 255
team2.counter.shake = 1
team2.counter.time = 8
team2.counter.mult = 0.06
team2.text.layerno = 2
team2.text.text = "HITS %p%"
team2.text.font = 1, 4, -1, 255, 96, 96
team2.text.scale = 0.66, 0.66
team2.text.offset = 12, 0
team2.displaytime = 90
team2.showspeed = 4
team2.hidespeed = 4

; Ikemen feature (format combo damage percentage presentation)
format.decimal.places = 0
format.decimal.separator = .


;==================================================================================================
; Ikemen feature
[Action]
team1.pos = 30, 277       ;Coords to show
team1.max = 4             ;Maximum number of simultaneous messages
team1.spacing = 0, 32     ;Spacing between each message
