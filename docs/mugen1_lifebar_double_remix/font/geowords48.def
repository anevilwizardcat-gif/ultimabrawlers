; Enter 48 - 48 point font
; 24bit sprite font
; This font contains the full ANSI character set

[FNT v2]
fntversion = 2,00                ; FNT v2 version number.  Don't change this
name = "Geometos Words 48"       ; Name of this font
author = "Phantom.of.the.Server" ; Source font by Deepak Dogra

[Def]
Type = bitmap      ; This is a bitmap font
BankType = none    ; I made this up. This is not a valid value for it
Size = 32, 48      ; Size of font: width, height.  Width is used for spaces
Spacing = 4, 16    ; Spacing between font glyphs: width, height
Offset = 0, 0      ; Drawing offset: x, y
File = geowords48.sff ; Filename of the sff containing the glyphs.  Use sff v2 only

; Note: All units are in pixels
; Text rendered with bitmap fonts may be in ASCII only
; See files in work/font for information on creating the sff
