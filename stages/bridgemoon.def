;--------------------------------------------------------
[Info]
;Name of the stage.
name = "Cairo Bridge"
; Author : Kitsune Sniper
; Co-Author: Orochi Herman
; Webpage: http://rotb.mgbr.net
; Original Game : Jojo's Bizarre Adventure
; Original Copyright : Capcom
; Posted on January 1, 2003
; Updated: February 6, 2005

;
; UPDATES:
;
; * Changed name to match blue color counterpart.
; * Fixed Sprite error in the 4'oclock part of the stage.
; * Matched cityscape height with the original
; * Completely abandoned accuracy from JoJo's Bizarre
;   adventure due to an impossible stage implementation.
; * Added fancy parralax, deltas, and updated graphics.
; * WInMUGEN compliance.
; * Added realism to the stage.
; * Expanded stage.
; * Added height.
; * And others.

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -450
boundright = 450
boundhigh = -80
boundlow = 0
verticalfollow = .3
floortension = 0
tension = 50
zoomin = 1.0
zoomout = 0.85

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -70
p1starty = 0
p1startz = 0
p1facing = 1

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1

;--- Common ---
leftbound  = -1000
rightbound =  1000
topbound  =  0
botbound  =  0

;--------------------------------------------------------
[Scaling]
topz     = 0
botz     = 50
topscale = 1
botscale = 1.2

;--------------------------------------------------------
[Bound]
screenleft = 15
screenright = 15

;--------------------------------------------------------
[StageInfo]
zoffset = 225
autoturn = 1
resetBG = 1

;--------------------------------------------------------
[Shadow]
color = 128,128,128
reflect = 0
yscale = .1
;--------------------------------------------------------
[Music]
bgmusic = jotarotheme.mp3
bgvolume = 300

;-------------------------------------
[BGdef]
spr = stages/bridgemoon.sff
debugbg = 1

