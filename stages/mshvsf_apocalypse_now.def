;--------------------------------------------------------
[Info]
name = "Apocalypse Now! (MSHvSF)"
author = "XsLaught"
; E-mail: xslaught@hotmail.com

;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -224
boundright = 224
boundhigh = -224
boundlow = 0
verticalfollow = 1
floortension = 60		; Artmoney checked
tension = 64			; (384 - 256) / 2 = 64
; 256 = distance between p1 and p2

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
 ;p1startx is typically -70 and p2startx is 70.
 ;p1starty and p1startz should be 0.
p1startx = -70         ; Starting x coordinates
						; (320/384) * (256/2) = 106.66666666666666666666666666667
p1starty = 0            ; Starting y coordinates
p1startz = 28           ; Stage identifier
p1facing = 1            ; Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = -28			; Stage identifier
p2facing = -1

;--- Common ---
leftbound  = -1000		; Left bound (x-movement)
rightbound =  1000		; Right bound
topbound  =  0    		; Top bound (z-movement)
botbound  =  0    		; Bottom bound

;--------------------------------------------------------
[Scaling]
topz     = 0			; Top z-coordinate for scaling
botz     = 50			; Bottom z-coordinate for scaling
topscale = 1			; Scale to use at top
botscale = 1.2			; Scale to use at bottom

;--------------------------------------------------------
[Bound]
screenleft = 21    		; Artmoneyed
screenright = 21   		; Artmoneyed

;--------------------------------------------------------
[StageInfo]
zoffset = 217			; 240 - 23
zoffsetlink = 1
autoturn = 1
resetBG = 1
hires = 0

;--------------------------------------------------------
[Shadow]
intensity = 128
color = 32, 32, 32
yscale = 0.4
fade.range = -400,-100

;--------------------------------------------------------
[Reflection]
intensity = 0

;--------------------------------------------------------
[Music]
bgmusic = magneto.mp3
bgvolume = 255

