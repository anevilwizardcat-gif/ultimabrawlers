[FNT v2]
; FNT v2 version number.  Don't change this.
fntversion = 2,00
name = "Ultima Combo Counter"
author = "ultimabrawlers"

[Def]
; This is a truetype font (true-color tint -> clean gold->red + rainbow).
Type = truetype
; Size of font: width, height. Only height is used for truetype fonts.
Size = 40,48
; Spacing between font glyphs. Only height is used for truetype fonts.
Spacing = 1,1
; Drawing offset: x, y.
Offset = 0,0
; Filename of the font to load (relative to this .def, like Open_Sans.def).
; To match the default arcade look later: replace this ttf with Jersey10.ttf
; (keep the same filename) -- nothing else changes.
File = ub_combo/ub_combo.ttf
; Preferred blending mode: 0 - none, 1 - blended.
Blend = 1
