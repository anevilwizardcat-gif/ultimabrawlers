p2.teammenu.value.icon.offset = -80,1
p2.teammenu.value.icon.spr = 190,0
p2.teammenu.value.empty.icon.offset = -80,1
p2.teammenu.value.empty.icon.spr = 191,0
p2.teammenu.value.spacing = -12,0
