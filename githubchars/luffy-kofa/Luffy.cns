; Win 1
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[state 181, No Life Bar]
type = assertspecial
trigger1 = Time >= 0
flag = NoBarDisplay

[State not hit]
type = NotHitBy
trigger1 = 1
value = SCA

[State 191, 5]
type = playsnd
trigger1 = animelem = 1
value = s191,0+random%2


[state width]
type = width
trigger1 = 1
edge = 0, const(size.ground.back) + const(size.ground.front) + 15


[state round not over]
type = assertspecial
trigger1 = time < 220
flag = roundnotover

