[State 800, 1] ;Normal
type = HitDef
Trigger1 = Time = 0
attr = A, HT          ;Attributes: Standing, Normal Throw
hitflag = AF          ;Affect only airbourne opponents
priority = 7, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
sprpriority = 1       ;Draw in front of p2
p1facing = 1 ;Turn if holding forwards
p2facing = 1          ;Force p2 to face player
p1stateno = 3001     ;On success, player changes to state 810
p2stateno = 3003       ;If hit, p2 changes to state 820 in player's cns
fall = 1              ;Force p2 into falling down
hitsound = s800,0
numhits = 0
id = 3000

