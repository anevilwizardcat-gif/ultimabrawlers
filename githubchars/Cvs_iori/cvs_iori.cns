;---------------------------------------------------------------------------
; 炎系ヒットエフェクト
[State 3001, Super]
type = Helper
trigger1 = MoveHit && (StateNo = 1100 || StateNo = 1110 || StateNo = 1120 || StateNo = 4500)
trigger2 = StateNo = 3105 && AnimElem = 8,=4
trigger3 = StateNo = 3115 && AnimElem = 16
trigger4 = StateNo = 3125 && AnimElem = 30
trigger5 = NumTarget(3300) && MoveHit
trigger6 = ProjHitTime(1000) = 1
trigger7 = ProjHitTime(3000) = 1
trigger8 = NumHelper
trigger8 = Helper,MoveHit
triggerall = !NumHelper(8330)
id = 8330
name = "Fire"
pos = 0,0
postype = P2
stateno = 8300
helpertype = normal
keyctrl = 0
ownpal = 1
persistent = 0
ignorehitpause = 1

[State 3001, Super]
type = Helper
triggerall = NumTarget(3000)
trigger1 = ProjHitTime(1000) = 1
triggerall = !NumHelper(3060)
id = 3060
name = "Fire"
pos = 0,0
postype = P2
stateno = 3060
helpertype = normal
keyctrl = 0
ownpal = 1
