trigger3 = stateno = 111 && Time = 1
trigger4 = stateno = 1101 && Time = 1
trigger5 = stateno = 1303 && Time = 1
trigger6 = stateno = 3301 && Time = 1
trigger7 = stateno = 3311 && Time = 1
trigger8 = stateno = 3321 && Time = 1
anim = 8030
scale = .5,.5
sprpriority = -1
ownpal = 1
pausemovetime = -1
Supermovetime = -1

