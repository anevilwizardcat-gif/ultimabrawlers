;혼다 CNS 설정파일
;가고일의 것!!!!!

;Var(1) - 승리포즈 결정
;Var(2) - 그로기 시스템
;Var(3) - 가드 크러시 시스템
;Var(4) - 제로카운터 카운트다운 
;Var(5) - 익스플로드 유무 
;Var(6) - 카운터 히트 시스템
;Var(7) - 슈퍼박치기
;Var(8) - 은행던지기
;Var(9) - G-groove
;Var(10) - 아수라 섬공
;Var(11) - 도발
;Var(12) - 페이싱
;Var(13) - 퍼스트 어택
;Var(14) - 킥 잡기

[Data]
life = 1080
attack = 108
defence = 105
fall.defence_up = 50
liedown.time = 63
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 200
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1         
yscale = 1         
ground.back = 41     
ground.front = 37   
air.back = 17       
air.front = 30      
height = 25      
attack.dist = 160   
proj.attack.dist = 90
proj.doscale = 0     
head.pos = 14, -70   
mid.pos = 6, -37    
shadowoffset = 0    
draw.offset = 0,0

[Velocity]
walk.fwd  = 1.9      
walk.back = -1.7     
run.fwd  = 4.6, -3.8   
run.back = -4.5,-3.8 
jump.neu = 0,-8.5;-8.0 
jump.back = -2.55,-8.4   
jump.fwd = 2.6,-8.4     
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1      
airjump.neu = 0,-8.1      
airjump.back = -2.55     
airjump.fwd = 2.5         

[Movement]
airjump.num = 0     
airjump.height = 35 
yaccel = .50         
stand.friction = .85  
crouch.friction = .82

;---------------------------------------------------------------------------
; 전방 대시
[Statedef 100]
type    = A
physics = A
ctrl = 0
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)

[State 100, 2]
type = CtrlSet
trigger1 = Time = 2
value = 1

[State 100, 3] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 4] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 5]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

;---------------------------------------------------------------------------
; 후방 대시
