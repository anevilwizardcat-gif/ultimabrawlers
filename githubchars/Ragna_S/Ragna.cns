;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
v = 49    ;fv = 10
value = 0
;ignorehitpause =
;persistent =

[state 190]
type = varset
trigger1 = time = 0
v = 2
value = floor(pos X)

[state 190]
type = varset
trigger1 = time = 0
v = 3
value = floor(P2bodydist x <= 30)  ;30

[State 190, VarRandom]
type = VarRandom
triggerall = numenemy = 1
trigger1 = p2name != "Jin" && Authorname = "Speedy9199"
trigger1 = p2name != "Rachel" && Authorname = "Speedy9199"
trigger1 = p2name != "Noel" && Authorname = "Speedy9199"
trigger1 = p2name != "Hakumen" && Authorname = "Speedy9199"
trigger1 = Time = 0
v = 0
range = 1,2
;ignorehitpause =
;persistent =

[State 190, VarRandom]
type = VarRandom
triggerall = numenemy >= 2
trigger1 = Time = 0
v = 0
range = 1,2
;ignorehitpause =
;persistent =

[state 190, choose var];starts round with a random groove.
type = VarRandom
trigger1 = time = 0
v = 59
range = 0,3

[State 190, 4] ;Change to stand state
type = ChangeState
triggerall = numenemy = 1
trigger1 = p2name != "Jin" && Authorname = "Speedy9199"
trigger1 = p2name != "Rachel" && Authorname = "Speedy9199"
trigger1 = p2name != "Noel" && Authorname = "Speedy9199"
trigger1 = p2name != "Hakumen" && Authorname = "Speedy9199"
trigger1 = Time = 0
value = 190 + var(0)

[State 190, 4] ;Change to stand state
type = ChangeState
triggerall = numenemy >= 2
trigger1 = Time = 0
value = 190 + var(0)

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = numpartner >= 1  
trigger1 = Time = 0
value = 191 + random%2;+ var(0)

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = numenemy = 1 ;&& numpartner = 0
trigger1 = p2name = "Jin" && Authorname = "Speedy9199"
trigger1 = time = 0
value = 10000

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = numenemy = 1 ;&& numpartner = 0
trigger1 = p2name = "Rachel" && Authorname = "Speedy9199"
trigger1 = time = 0
value = 10010

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = numenemy = 1 ;&& numpartner = 0
trigger1 = p2name = "Noel" && Authorname = "Speedy9199"
trigger1 = time = 0
value = 10020

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = numenemy = 1 ;&& numpartner = 0
trigger1 = p2name = "Hakumen" && Authorname = "Speedy9199"
trigger1 = time = 0
value = 10030


