;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State 230, PlaySnd]
type = PlaySnd
triggerall = !win
triggerall = !lose
triggerall = p2movetype = H
trigger1 = movehit = 1 && Enemy,gethitvar(hitcount) = 3
value = 7000,0
volume = 255
persistent = 0
;ignorehitpause = 1

[State 230, PlaySnd]
type = PlaySnd
triggerall = !win
triggerall = !lose
triggerall = p2movetype = H
trigger1 = movehit = 1 && Enemy,gethitvar(hitcount) = 6
value = 7000,1
volume = 255
persistent = 0
;ignorehitpause = 1

[State 230, PlaySnd]
type = PlaySnd
triggerall = !win
triggerall = !lose
triggerall = p2movetype = H
trigger1 = movehit = 1 && Enemy,gethitvar(hitcount) = 10
value = 7000,2
volume = 255
persistent = 0
;ignorehitpause = 1

[State 5000, 1 Changestate]
type = ChangeState
triggerall = !alive
triggerall = pos y >= 0
triggerall = stateno = [5000,5001]
trigger1 = enemynear,Hitdefattr = SCA,NA
value = 9998
ignorehitpause = 1

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, HitOverride]
type = HitOverride
triggerall = PalNo = 7
triggerall = stateno != 120
trigger1 = StateNo = [0,20]
attr = SCA,NA        ;SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
slot = 0
stateno = 7000
time = 1
forceair = 1
;ignorehitpause =
;persistent =

[State -3, VarAdd]
type = Varadd
triggerall = (GetHitVar(HitShakeTime) = 5)
trigger1 = (StateNo = 150) || (StateNo = 151) || (StateNo = 152)
var(6) = 1
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (GetHitVar(HitShakeTime) = 10)
trigger1 = (StateNo = 150) || (StateNo = 151) || (StateNo = 152)
var(6) = 2
ignorehitpause = 1

[State -3, VarAdd]
type = Varadd
triggerall = (GetHitVar(HitShakeTime) = 15)
trigger1 = (StateNo = 150) || (StateNo = 151) || (StateNo = 152)
var(6) = 3
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (Var(6) > 0) && (!Time) && (StateNo = 5000) && (Alive)
trigger1 = (Anim = 5000) || (Anim = 5001) || (Anim = 5010) || (Anim = 5011)
var(6) = -3
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (Var(6) > 0) && (!Time) && (StateNo = 5010) && (Alive)
trigger1 = (Anim = 5020) || (Anim = 5021)
var(6) = -3
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
triggerall = (Var(6) > 0) && (!Time) && (StateNo = 5000) && (Alive)
trigger1 = (Anim = 5002) || (Anim = 5012)
var(6) = -6
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
trigger1 = (Var(6) > 0) && (!Time) && (StateNo = 5010) && (Alive) && (Anim = 5022)
var(6) = -6
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
trigger1 = (Var(6) > 0) && (!Time) && (StateNo = 5100) && (Alive)
var(6) = -9
ignorehitpause = 1

[State -3, VarAdd]
type = VarAdd
trigger1 = (Var(6) > 0) && ((GameTime%5) = 0) && (MoveType != H) && (StateNo != [150,153])
var(6) = -1
ignorehitpause = 1

[State -3, ChangeState]
type = ChangeState
triggerall = statetype = S
trigger1 = var(6) >= 30
value = 8001
ctrl = 0
ignorehitpause = 1

[State -3, ChangeState]
type = ChangeState
triggerall = statetype = C
trigger1 = var(6) >= 30
value = 8011
ctrl = 0
ignorehitpause = 1

[State -3, ChangeState]
type = ChangeState
triggerall = statetype = A
trigger1 = var(6) >= 30
value = 8021
ctrl = 0
ignorehitpause = 1



 
