;
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "Dhalsim"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Dhalsim_A"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 04,14,2002     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Felicity"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 6,3,4,2        ;ＣＰＵで出てきた時のカラーパレットの順番

;-----------------------------------------------------------------------------

[Files]
Cmd     = sys/Dhalsim_A.cmd       ;コマンドファイルの登録
Cns     = st/Dhalsim_A.cns       ;コンスタンツファイルの登録
St     = st/Dhalsim_A_NA.st       ;ステートファイルの登録・最大１１個まで増やせます
St0		= st/Dhalsim_A_SA.st  
St1		= st/Dhalsim_A_SC.st
St2		= st/Dhalsim_A_TH.st
St3		= st/Dhalsim_A_SY.st
St4		= st/Dhalsim_A_-2.st
St5		= st/Dhalsim_A_-3.st  
St6		= st/Dhalsim_A_HL.st 
StCommon= st/Dhalsim_A_CO.st  ;コモンステートファイルの登録
Sprite  = sys/Dhalsim_A.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = sys/Dhalsim_A.air       ;アニメーションファイルの登録
Sound   = sys/Dhalsim_A.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

Pal1 = act/Dhalsim_A01.act  ;Ａボタンで決定した色が使えます
Pal2 = act/Dhalsim_A02.act  ;Ｂ
Pal3 = act/Dhalsim_A03.act;Ｃ
Pal4 = act/Dhalsim_A04.act ;Ｘ
Pal5 = act/Dhalsim_A05.act  ;Ｙ
;Pal6 =   ;Ｚ
;Pal7 =   ;Ｓ押しながらＡボタンで決定した色が使えます
;Pal8 =   ;Ｓ押しながらＢ
;Pal9 =           ;Ｓ押しながらＣ
;Pal10=           ;Ｓ押しながらＸ
;Pal11=           ;Ｓ押しながらＹ
;Pal12=           ;Ｓ押しながらＺ


[Arcade]
Intro.Storyboard = intro.def   ;オープニングのファイルを登録します
Ending.Storyboard = ending.def ;エンディングのファイルを登録します

