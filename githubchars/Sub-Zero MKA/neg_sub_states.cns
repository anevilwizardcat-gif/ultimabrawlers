;----------------------
;blocking related
;----------------------

[State -2, no block]
type = AssertSpecial
trigger1 = p2stateno = 6172 ;subs wakeup ice
trigger2 = p2stateno = 6202 ;subs ice shaker
trigger3 = p2stateno = 99446 ;subs harakiri / scorpions harakiri
trigger4 = p2stateno = 99440 ;subs double harakiri
trigger5 = p2stateno = 99441 ;scorpions double harakiri
trigger6 = p2stateno = 336644 ;players die state off screen
trigger7 = stateno = 7005 ;parry
trigger8 = p2stateno = 1944 ;sub zeros polarblast super
trigger9 = p2stateno = 45469 ;scorpions ground fire super
trigger10 = p2stateno = 1943 ;scorpions spectre mode
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard




[state -2 ]
type = assertspecial
triggerall = Time < 300
triggerall = stateno = 5150
trigger1 = NumExplod(10035) = 1
flag = roundnotover







