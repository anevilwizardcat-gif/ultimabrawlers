;-----------------------------------------------------------------------------------------
;explode reminders
;-----------------------------------------------------------------------------------------
;NumExplod(780)     =   place holder for ice mode
;NumExplod(784)     =   place holder for no block after parry
;NumExplod(1780)    =   place holder for fatality logo
;NumExplod(4631)    =   danger! word animation
;NumExplod(10024)   =   black sprite for blackout fatality
;NumExplod(10034)   =   place holder for the double harakiri draw
;NumExplod(10035)   =   place holder for regular harakiri
;-----------------------------------------------------------------------------------------












;-----------------------------------------------------------------------------------------
;-states bitch
;-----------------------------------------------------------------------------------------


[Statedef -2]

[state -2 ]
type = poweradd
trigger1=movehit=1
value=200

[state -2];no block 
type = assertspecial
trigger1 = 1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard


[state -2];no block after parry
type = assertspecial
trigger1 = numexplod(1349)=1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[state -2, bb];breaker buster set
type = varset
trigger1 = stateno = 5900
var (55) = 1















[state -2];sidestep sound ground
type = playsnd
trigger1 = var(46) = 2
trigger1 = p2movetype = A
trigger1 = p2statetype =S
trigger1 = movetype !=H
trigger1 = p2bodydist x = [0,101]
trigger1 = stateno = 10 || stateno = 11 || stateno = 12 || stateno = 105 || stateno = 6168 || anim = 21 && stateno = 20
value = S32, 21
persistent = 0
channel = 4

[state -2];sidestep sound crouch
type = playsnd
trigger1 = var(46) = 2
trigger1 = p2movetype = A
trigger1 = p2statetype =C
trigger1 = movetype !=H
trigger1 = p2bodydist x = [0,101]
trigger1 = stateno = 40|| stateno = 50 || stateno = 105
value = S32, 21
persistent = 0
channel = 4

[state -2];fucking stop it
type = stopsnd
trigger1 = movetype = H
trigger1 = var(46) = 2
channel = 4



