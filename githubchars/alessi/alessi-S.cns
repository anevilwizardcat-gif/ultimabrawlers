type = S
movetype = A
physics = S
poweradd= 0
anim = 1000
ctrl = 0
velset = 0,0

[State 1006, Turn]
type = Turn
trigger1 = Var(35) = 1 && Time = 0 
trigger1 = Facing = enemy,Facing

[State 1006, varset(15)]
type = varset
trigger1 = 1
var(15) = 180

[State 1006, Helper]
type = Helper
trigger1 = !NumHelper(1010) && AnimElem = 4
ID = 1010
pos = IfElse(FrontEdgeDist >= 215,215,IfElse(FrontEdgeDist <= 60,60,(FrontEdgeDist))),-80
postype = p1
stateno = 1010
