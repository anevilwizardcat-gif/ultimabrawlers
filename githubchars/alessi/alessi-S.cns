ground.hittime  = 10
ground.velocity = -6.5
air.velocity = -6,-4
ground.cornerpush.veloff = 0
air.fall = 1
fall.recovertime = 20
guard.kill = 0

[State 1010, HitDef]
type = HitDef
trigger1 = parent,anim = 1001 && parent,animelem = 2 && Hitcount < 13 && (parent,Var(24) = 0 || parent,Var(33) = 1)
trigger1 = Hitcount = 1 || Hitcount = 3 || Hitcount = 5 || Hitcount = 7 || Hitcount = 9 || Hitcount = 11 || Hitcount = 13
attr = S, SP
damage = 14,7
animtype = Heavy
getpower = 0
givepower = 7,0
