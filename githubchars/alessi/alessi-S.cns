air.fall = 1
fall.recovertime = 20
guard.kill = 0

[State 1010, VarAdd(3)]
type = VarAdd
trigger1 = MoveHit
persistent = 0
var(3) = 1

[State 1010, ChangeAnim]
type = ChangeAnim
trigger1 = anim != 1010 && (Pos X < fvar(1) || Pos X > fvar(2) || Pos Y < fvar(3) || Pos Y > enemynear,Pos Y)
value = 1010

[State 1010, ChangeAnim]
type = ChangeAnim
trigger1 = anim != 1020 && (Pos X >= fvar(1) && Pos X <= fvar(2) && Pos Y >= fvar(3) && Pos Y <= enemynear,Pos Y)
value = 1020

[State 1010, ChangeState]
type = ChangeState
trigger1 = parent,StateNo = 1002 || parent,movetype = H || HitCount >= 13
value = 1020

;--------------------------------照準消滅
[Statedef 1020]
type = S
movetype = A
physics = N
anim = 1
velset = 0,0
ctrl = 0
sprpriority = 2

[State 1020, varset(F4)]
type = varset
trigger1 = Time = 0
fvar(4) = 1

[State 1020, varadd(F4)]
type = varadd
trigger1 = 1
fvar(4) = -.05

[State 1020, Explod]
type = Explod
trigger1 = Time = 0
anim = (1040+var(1)+var(2))
id = 1030
pos = 0,0
postype = P1
scale = 1,1
sprpriority = 2
removetime = -2
bindtime = -1
facing = 1

[State 1020, ModifyExplod]
type = ModifyExplod
trigger1 = fvar(4) > 0
ID = 1030
scale = (fvar(4)),(fvar(4))

[State 1020, DestroySelf]
type = DestroySelf
trigger1 = !NumHelper(1030) && Time > 20

