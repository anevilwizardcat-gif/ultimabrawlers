ground.slidetime = 10
ground.hittime  = 10
ground.velocity = -6.5
air.velocity = -6,-4
ground.cornerpush.veloff = 0
air.fall = 1
fall.recovertime = 20
P2StateNo = 5000+((P2stateNo =[19000,19989]))*14500
guard.kill = 0

[State 1010, HitDef]
type = HitDef
trigger1 = parent,anim = 1001 && parent,animelem = 2 && Hitcount < 13 && (parent,Var(24) = 0 || parent,Var(33) = 1)
trigger1 = Hitcount = 0 || Hitcount = 2 || Hitcount = 4 || Hitcount = 6 || Hitcount = 8 || Hitcount = 10 || Hitcount = 12
attr = S, SP
damage = 14,7
animtype = Heavy
getpower = 0
givepower = 7,0
hitflag = MAF
guardflag = MA
