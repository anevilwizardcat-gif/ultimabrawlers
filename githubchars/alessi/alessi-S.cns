
;=====================================================================
; Definition of the Special Arts
;=====================================================================

;---------------------------------------------------------------------
; 蜂の巣だッ！
;------------------------本体動作・弱
[Statedef 1000]
type = S
movetype = A
physics = S
poweradd= 0
anim = 1000
ctrl = 0
velset = 0,0

[State 1000, Turn]
type = Turn
trigger1 = Var(35) = 1 && Time = 0 
trigger1 = Facing = enemy,Facing

[State 1000, varset(15)]
type = varset
trigger1 = 1
var(15) = 180

[State 1000, Helper]
type = Helper
trigger1 = !NumHelper(1010) && AnimElem = 4
ID = 1010
pos = (IfElse(FrontEdgeDist >= 90,90,IfElse(FrontEdgeDist <= 60,60,(FrontEdgeDist)))),-80
postype = p1
stateno = 1010
helpertype = Normal
name = "Gunsight"
keyctrl = 0
ownpal = 1

[State 1000, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 1001
ctrl = 0

;------------------------本体動作・中
[Statedef 1005]
type = S
movetype = A
physics = S
poweradd= 0
anim = 1000
ctrl = 0
velset = 0,0

[State 1000, Turn]
type = Turn
trigger1 = Var(35) = 1 && Time = 0 
trigger1 = Facing = enemy,Facing

[State 1005, varset(15)]
type = varset
trigger1 = 1
var(15) = 180

[State 1005, Helper]
type = Helper
trigger1 = !NumHelper(1010) && AnimElem = 4
ID = 1010
pos = (IfElse(FrontEdgeDist >= 125,125,IfElse(FrontEdgeDist <= 60,60,(FrontEdgeDist)))),-80
postype = p1
stateno = 1010
helpertype = Normal
name = "Gunsight"
keyctrl = 0
ownpal = 1

[State 1005, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 1001
ctrl = 0

;------------------------本体動作・強
