;------------------------構え～発砲動作
[Statedef 1001]
type = S
movetype = A
physics = S
ctrl = 0
velset = 0,0

[State 1001, varadd(15)]
type = varadd
trigger1 = Time > 0
var(15) = -1

[State 1001, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = 1001
elem = 6

[State 1001, ChangeAnim]
type = ChangeAnim
triggerall = Command = "x" || Command = "y" || Command = "z"
trigger1 = anim = 1001 && AnimElemNo(0) >= 4
value = 1001

[State 1001, ChangeState]
type = ChangeState
trigger1 = Command = "a" || var(15) <= 0 || helper(1010),StateNo != 1010
value = 1002
ctrl = 0

;------------------------終了動作
[Statedef 1002]
type = S
movetype = I
physics = S
anim = 1002
ctrl = 0
velset = 0,0

[State 1002, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0 + var(35)*6010
ctrl = 1 - var(35)

;---------------------------------------------------------------------
; 蜂の巣だッ！
;------------------------照準
[Statedef 1010]
type = S
movetype = A
physics = N
anim = 1010
velset = 0,0
ctrl = 0
sprpriority = 2

[State 1010, varset(1)]
type = varset
trigger1 = 1
var(1) = IfElse(anim = 1010,(animelemno(0)),0)

[State 1010, varset(2)]
type = varset
trigger1 = 1
var(2) = IfElse(anim = 1020,((animelemno(0))+20),0)

[State 1010, varset(3)]
type = VarSet
trigger1 = Time = 0
var(3) = 0

[State 1010, varset(F1)]
type = varset
trigger1 = enemynear,Pos X < parent,Pos X
fvar(1) = ((enemynear,Pos X)-(IfElse((enemynear,statetype != A),(enemynear,const(Size.ground.back)),(enemynear,const(Size.air.back)))))

[State 1010, varset(F2)]
type = varset
trigger1 = enemynear,Pos X < parent,Pos X
fvar(2) = ((enemynear,Pos X)+(IfElse((enemynear,statetype != A),(enemynear,const(Size.ground.front)),(enemynear,const(Size.air.front)))))

[State 1010, varset(F1)]
type = varset
trigger1 = enemynear,Pos X > parent,Pos X
fvar(1) = ((enemynear,Pos X)-(IfElse((enemynear,statetype != A),(enemynear,const(Size.ground.front)),(enemynear,const(Size.air.front)))))

[State 1010, varset(F2)]
type = varset
trigger1 = enemynear,Pos X > parent,Pos X
fvar(2) = ((enemynear,Pos X)+(IfElse((enemynear,statetype != A),(enemynear,const(Size.ground.back)),(enemynear,const(Size.air.back)))))

[State 1010, varset(F3)]
type = varset
trigger1 = 1
fvar(3) = ((enemynear,Pos Y)+(enemynear,const(Size.head.pos.Y))-10)

[State 1010, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 1010, Posadd]
type = Posadd
trigger1 = parent,Command = "U" || parent,Command = "D" || parent,Command = "F" || parent,Command = "B"
trigger2 = parent,Command = "UF" || parent,Command = "DF" || parent,Command = "UB" || parent,Command = "DB"
x = IfElse((parent,Command = "F" || parent,Command = "DF" || parent,Command = "UF"),3,IfElse(((parent,Command = "B" || parent,Command = "DB" || parent,Command = "UB") && ParentDist X < -60),-3,0))
y = IfElse((parent,Command = "U" || parent,Command = "UF" || parent,Command = "UB"),-3,IfElse(((parent,Command = "D" || parent,Command = "DF" || parent,Command = "DB") && Pos Y < -3),3,0))

[State 1010, Posadd]
type = Posadd
trigger1 = parent,Command != "U" || parent,Command != "D" || parent,Command != "F" || parent,Command != "B"
trigger1 = parent,Command != "UF" || parent,Command != "DF" || parent,Command != "UB" || parent,Command != "DB"
x = 0
y = 0

[State 1010, Explod]
type = Explod
trigger1 = parent,anim = 1001 && parent,animelem = 2
anim = 1030
id = 1020
pos = 0,0
postype = P1
sprpriority = 2
removetime = -2
bindtime = 1
facing = 1

[State 1010, PlaySnd]
type = PlaySnd
trigger1 = parent,anim = 1001 && parent,animelem = 2
value = 1,3

[State 1010, StateTypeSet]
type = StateTypeSet
trigger1 = parent,anim = 1001 && parent,animelem = 2
movetype = A

[State 1010, StateTypeSet]
type = StateTypeSet
trigger1 = parent,anim = 1001 && parent,animelemno(0) >= 3
movetype = I

[State 1010, HitDef]
type = HitDef
trigger1 = parent,anim = 1001 && parent,animelem = 2 && Hitcount < 13 && parent,Var(24) != 0 && parent,Var(33) = 0
trigger1 = Hitcount = 0 || Hitcount = 2 || Hitcount = 4 || Hitcount = 6 || Hitcount = 8 || Hitcount = 10 || Hitcount = 12
attr = S, SP
damage = 14,7
animtype = Heavy
getpower = 0
givepower = 7,0
hitflag = MAF
guardflag = MA
pausetime = 0,10
sparkno = S2010
guard.sparkno = S2050
sparkxy = 0,0
hitsound = S3, 3
guardsound = S4, 0
ground.type = High
ground.slidetime = 10
ground.hittime  = 10
ground.velocity = -6.5
air.velocity = -6,-4
ground.cornerpush.veloff = 0
air.fall = 1
fall.recovertime = 20
P2StateNo = 5005+((P2stateNo =[19000,19989]))*14495
guard.kill = 0

[State 1010, HitDef]
type = HitDef
trigger1 = parent,anim = 1001 && parent,animelem = 2 && Hitcount < 13 && parent,Var(24) != 0 && parent,Var(33) = 0
trigger1 = Hitcount = 1 || Hitcount = 3 || Hitcount = 5 || Hitcount = 7 || Hitcount = 9 || Hitcount = 11 || Hitcount = 13
attr = S, SP
damage = 14,7
animtype = Heavy
getpower = 0
givepower = 7,0
hitflag = MAF
guardflag = MA
