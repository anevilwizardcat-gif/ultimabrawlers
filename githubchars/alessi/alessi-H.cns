
;=====================================================================
; Definition of the Super Arts
;=====================================================================

;---------------------------------------------------------------------
; ウシウシウシッ！
;------------------------ 超必殺技演出
[Statedef 3000]
type = S
movetype = A
physics = S
anim = 3000
velset = 0, 0
ctrl = 0
poweradd = -1000

[State 3000, SuperPause]
type = SuperPause
trigger1 = Time = 16
pos = 40, -45
anim = S7007
sound = S1,4
movetime = 33
time = 33
darken = 0

[State 3000, AssertSpecial]
type = AssertSpecial
trigger1 = Time = [16,47]
flag = NoBarDisplay
flag2 = NoBG
flag3 = NoFG
ignorehitpause = 1

[State 3000, Explod]
type = Explod
trigger1 = AnimElem = 5
anim = 7001
id = 7001
ownpal = 1
bindtime = -1
sprpriority = -2
supermove = 1
postype = back

[State 3000, Explod]
type = Explod
trigger1 = AnimElem = 5
anim = 7000
ownpal = 1
bindtime = -1
sprpriority = -1
supermove = 1
postype = back
scale = 1.0,1.08

[State 3000, VarSet(13)]
type = VarSet
trigger1 =  Time = 0
var(13) = 0

[State 3000, muteki]
type = NotHitBy
trigger1 = Time < 50
value = SCA

[State 3000, Helper]
type = Helper
trigger1 = !NumHelper(3050) && AnimElem = 6
ID = 3050
pos = 0,0
postype = p1
stateno = 3050
helpertype = Normal
keyctrl = 0
ownpal = 1

[State 3000, Explod]
type = Explod
trigger1 = AnimElem = 6,=2
anim = 7010
id = 7010
pos = 0,0
ownpal = 1
bindtime = -1
sprpriority = 5
supermove = 1
postype = P1

[State 3000, ChangeAnim]
type = ChangeAnim
trigger1 = Numhelper(3050)
trigger1 = helper(3050),HitPauseTime != 0
trigger2 = Numhelper(3050)
trigger2 = helper(3050),HitPauseTime != 0
value = anim
elem = AnimElemNo(0)

[State 3000, End]
type = ChangeState
trigger1 = !NumHelper(3050) && AnimElemNo(0) > 6
value = 0
ctrl = 1

