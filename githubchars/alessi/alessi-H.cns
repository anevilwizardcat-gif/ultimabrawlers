;------------------------ ダッシュ
[Statedef 6010]
type    = S
movetype = I
physics = N
ctrl = 0

[State 6010, ChangeAnim]    
type = ChangeAnim
trigger1 = anim != 6010
value = 6010

[State 6010, VelSet]
type = VelSet
trigger1 = fVar(7) > 1
x = 6

[State 6010, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

