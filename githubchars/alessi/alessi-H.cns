;------------------------ ヒット
[Statedef 3130]
type = S
movetype = A
physics = S
velset = 0, 0
poweradd = 0
sprpriority = 1

[State 3130, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = 3110
elem = var(30)

[State 3130, PlaySnd]
type = PlaySnd
trigger1 = Time = 3
value = 0,18
channel = 0

[State 3130, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 2
value = 3130

[State 3130, Helper]
type = Helper
trigger1 = !NumHelper(3135) && Time = 3
ID = 3135
pos = 0,0
postype = p1
stateno = 3135
helpertype = Normal
keyctrl = 0
ownpal = 1

[State 3130, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 3130, TargetBind]
type = TargetBind
trigger1 = Time = 0
pos = 70, 0

[State 3130, BindtoTarget]
type = BindtoTarget
trigger1 = Time = 1
pos = 74, 0

[State 3130, BindtoTarget]
type = BindtoTarget
trigger1 = Time = 2
pos = 70, 0

[State 3130, TargetLifeAdd]
type = TargetLifeAdd
triggerall = NumHelper(3135)
trigger1 = Helper(3135),AnimElem = 2,=2  || Helper(3135),AnimElem = 10,=2 || Helper(3135),AnimElem = 15,=2 || Helper(3135),AnimElem = 18,=2
trigger2 = Helper(3135),AnimElem = 26,=2 || Helper(3135),AnimElem = 31,=2 || Helper(3135),AnimElem = 36,=2 || Helper(3135),AnimElem = 41,=2 
trigger3 = Helper(3135),AnimElem = 50,=2 || Helper(3135),AnimElem = 55,=2 || Helper(3135),AnimElem = 66,=2 || Helper(3135),AnimElem = 73,=2 
value = -21
kill = 0+(Helper(3135),AnimElem = 73,=2)

[State 3130, VarSet(22)]
type = VarSet
triggerall = NumTarget
trigger1 = Target,Authorname= "H”" && Target,P1Name = "alessi"
trigger2 = Target,Authorname= "bad darkness" && Target,P1Name = "khan"
trigger3 = Target,Authorname= "bad darkness" && Target,P1Name = "Rubber Soul"
trigger4 = Target,Authorname= "bad darkness" && Target,P1Name = "Midler"
trigger5 = Target,Authorname= "bad darkness" && Target,P1Name = "J.P.Polnareff"
trigger6 = Target,Authorname= "Warusaki3" && Target,P1Name = "blackpolnareff"
persistent = 0
var(22) = 2

[State 3130, VarSet(22)]
type = VarSet
trigger1 = NumTarget
trigger1 = Target,Authorname= "ANMC" && Target,P1Name = "Dio Brendo"
persistent = 0
var(22) = 3

[State 3130, VarSet(29)]
type = VarSet
trigger1 = NumTarget
trigger1 = Target,Authorname= "ANMC" && Target,P1Name = "Dio Brendo"
persistent = 0
var(29) = Target,var(15)

[State 3130, VarAdd(23)]
type = VarSet
trigger1 = AnimTime = 0
persistent = 0
var(23) = 450

[State 3130, TargetState]
type = TargetState
trigger1 = AnimTime = 0
value = ifelse((Var(33) = 1 || Target,Life <= 0),5095,18998)

[State 3130, RemoveExplod]
type = RemoveExplod
trigger1 = AnimTime = 0
id = 3160

[State 3130, End]
type = ChangeState
trigger1 = AnimTime = 0 
value = 11000-var(33)*11000
ctrl = 0+var(33)

