;-------------------------------------------------------------------------------
; 立ち弱攻撃
[Statedef 205]
type = S
movetype = A
physics = N
anim = 205
ctrl = 0
sprpriority = 3
persistent = 0

[State 205, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2,=1
value = 2, 0

[State 205, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 205, BindToParent]
type = BindtoParent
trigger1 = 1
facing = 1
pos = (Parent,var(37) + IfElse((Parent,prevstateno = 100),0,(Parent,var(13)*1.3))),0
Time = -1

[State 205, ParentVarset]
type = ParentVarset
trigger1 = Time = 0 || enemy,statetype = A
fv = 1
value = 0

[State 205, ParentVarSet]
type = ParentVarSet
trigger1 = movecontact && HitPauseTime = 0 && P2statetype != A
fv = 1
value = 4.4
persistent = 0

[State 205, ParentVarAdd]
type = ParentVarAdd
trigger1 = MoveHit
persistent = 0
var(16) = 1

[State 205, HitDef]
type = HitDef
trigger1 = Time = 0 && parent,Var(24) != 0 && parent,Var(33) = 0
attr = S, NP
animtype  = light
damage    = 42
getpower = 28
givepower = 14,0
guardflag = M
hitflag = M
pausetime = 10,10
sparkno = S2000
guard.sparkno = S2050
sparkxy = 0,-35
hitsound = S3, 3
guardsound = S4, 0
ground.type = Low
ground.slidetime = 10
ground.hittime  = 10
ground.velocity = -6.5
P2StateNo = 5005+((P2stateNo =[19000,19989]))*14495

[State 205, HitDef]
type = HitDef
trigger1 = Time = 0 && (parent,Var(24) = 0 || parent,Var(33) = 1)
attr = S, NP
animtype  = light
damage    = 42
getpower = 28
givepower = 14,0
guardflag = M
hitflag = M
pausetime = 10,10
sparkno = S2000
guard.sparkno = S2050
sparkxy = 0,-35
hitsound = S3, 3
guardsound = S4, 0
ground.type = Low
ground.slidetime = 10
ground.hittime  = 10
ground.velocity = -6.5

[State 810, HitBy]
type = HitBy
trigger1 = 1
value = SCA, NA, SA, HA, NP, SP, HP

[State -2, 4000] 
type = HitOverride
trigger1 = 1
slot = 0
stateno = 9250
attr = SCA, NA, SA, HA, NP, SP, HP
time = -1

[State 205, DestroySelf]
type = DestroySelf
trigger1 = AnimTime = 0 || parent,stateno != 201

