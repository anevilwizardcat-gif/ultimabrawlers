[Statedef 9251]
type    = S
movetype= H
physics = N

[State 9251, BindToParent]
type = BindToParent
trigger1 = 1
pos = (Parent,var(37)+(Parent,var(13)*1.3)),(0-(parent,Pos Y))
facing = 1

[State 9251, HitVelSet]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 9251, ChangeAnim]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 1

[State 9251, StateTypeSet]
type = StateTypeSet
trigger1 = Time = 0 && Parent,StateType = A
statetype = A

[State 9251, StateTypeSet]
type = StateTypeSet
trigger1 = Time = 0 && Parent,StateType = C
statetype = C

[State 9251, StateTypeSet]
