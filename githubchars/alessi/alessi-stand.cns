;-------------------------------------------------------------------------------
; スタンド
;--------------------------------スタンド・頭部分
[Statedef 9100]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0
anim = 9101
sprpriority = -1

[State 9100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 9100, ChangeAnim]
type = ChangeAnim
trigger1 = parent,StateType != A 
trigger1 = parent,StateNo = [120,155] 
trigger2 = parent,stateNo =[18000,19999]
trigger3 = parent,stateNo = 6000
trigger4 = parent,stateNo = 4350
value = 1

[State 9100, ChangeAnim]
type = ChangeAnim
trigger1 = parent,StateNo != [120,155] 
trigger1 = parent,stateNo !=[18000,19999] 
trigger1 = parent,stateNo != 6000
trigger1 = parent,stateNo != 4350
value = 9101

[State 9100, BindToParent]
type = BindToParent
trigger1 = 1
pos = parent,var(13),(0-(parent,Pos Y))
facing = 1

[State 9100, ChangeState]
type = DestroySelf
trigger1 = parent,MoveType != H && parent,StateNo != 9000 && parent,StateNo != 9001 && parent,var(11) = 0
trigger2 = parent,MoveType != H && (parent,StateNo = 810 || parent,StateNo = 811 || parent,StateNo = 1240 || parent,StateNo = [3000,3199])
trigger3 = parent,MoveType = H && parent,StateNo = 8100
trigger4 = parent,MoveType = H && parent,var(11) = 0 && stateno != [150,155]

