trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 9251, VelSet]
type = VelSet
trigger1 = HitOver
x = 0

[State 9251, DestroySelf]
type = DestroySelf
trigger1 = HitOver || Parent,StateNo = [8100,8102]

