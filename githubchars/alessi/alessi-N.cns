;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 15000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 15000, LifeAdd]
type = LifeAdd
trigger1 = Var(36)
value = -Var(36)

[State 15000, VarSet]
type = VarSet
trigger1 = Var(36)
v = 36
value = 0

[State 15000, posadd]
type = posadd
trigger1 = 1
x = ifelse(Time % 2,1,-1)

[State 15000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = helper(9200),GetHitVar(animtype) != [3,5]
value = ifelse((helper(9200),GetHitVar(groundtype) = 1),5000,5010) + helper(9200),GetHitVar(animtype)

[State 15000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = helper(9200),GetHitVar(animtype) = [3,5]
value = 5030

[State 15000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (helper(9200),GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + helper(9200),GetHitVar(animtype)))
value = 5047 + helper(9200),GetHitVar(animtype) ;5051 - 4 + type

[State 15000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 15000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = helper(9200),GetHitVar(yvel) != 0 && helper(9200),GetHitVar(fall)
trigger2 = helper(9200),Pos Y != 0
trigger3 = !Alive
type = a

[State 15000, 6]
type = ChangeState
trigger1 = Alive
trigger1 = helper(9200),HitShakeOver
trigger1 = helper(9200),GetHitVar(yvel) = 0
value = 15001 ;HITG_SLIDE

[State 15000, 7]
type = ChangeState
trigger1 = helper(9200),HitShakeOver
trigger2 = helper(9200),HitShakeOver
trigger2 = !Alive
value = 15030

[State 15000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 15000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 15000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

