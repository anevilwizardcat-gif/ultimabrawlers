
;=====================================================================
;  CNS File For "alessi"	                              Made By H"
;          
;=====================================================================

;---------------------------------------------------------------------
; 変数表
;	Var(1)	: 
;	Var(2)	: 
;	Var(3)	: 
;	Var(4)	: 
;	Var(5)	: 
;	Var(6)	: 
;	Var(7)	: 
;	Var(8) : 
;	Var(10): 
;	Var(11): モード切り替え用（0:本体モード　1:スタンドモード）
;	Var(12): 「影伸ばし」ボタン押しっぱなしフラグ
;	Var(13): 「影伸ばし」スケール設定用
;	Var(14): 空中スタンド発動時の制御フラグ
;	Var(15): 「蜂の巣だッ！」時間カウンタ
;	Var(16): ヒット数カウント
;	Var(17): 「カッサバイてやるッ！」押しっぱなし判定1
;	Var(18): 「カッサバイてやるッ！」押し時間カウンタ
;	Var(19): 「カッサバイてやるッ！」押しっぱなし判定2
;	Var(20): 空中ヒットポーズ処理
;	Var(21): 「ガキんちょがッ！」弱中強判定
;	Var(22): 「ガキんちょがッ！」対応伽羅判別
;	Var(23): 「ガキんちょがッ！」HIT判別
;	Var(24): モード切り替え用（0:通常モード　1,2:強気モード）
;	Var(25)	: 小or中ジャンプフラグ
;	Var(26)	: 大ジャンプフラグ
;	Var(27) : 大ジャンプ中のレバー入力管理
;	Var(28) : 大ジャンプフラグ２
;	Var(29) : 子供化処理用
;	Var(30) : 「絶望ォォォだねッ！」アニメ継続フラグ
;	Var(31) : 「ウシウシウシッ！」連打数カウンタ
;	Var(32) : スタンドクラッシュアニメ番号格納
;	Var(33) : 子供化技封印（1:封印 0:可能）
;	Var(34) : 削り無効化判定
;	Var(35) : タンデム判定
;	Var(36) : スタンドダメージ値
;	Var(37) : スタンドX軸位置
;
;
;	fVar(1) : コーナープッシュ処理
;	fVar(2) : コンボ補正
;	fVar(3) : X軸速度計測
;	fVar(4) : Y軸速度計測
;	fVar(5) : 「ガキんちょがッ！」スケール設定1
;	fVar(6) : 「ガキんちょがッ！」スケール設定2
;	fVar(7) : スタンドゲージ量
;	fVar(8) : スタンドクラッシュ用
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000			; 体力ゲージ、上限値（デフォルト：1000）
power = 9000			; パワーゲージ
attack = 100			; 攻撃力（％）
defence = 100			; 防御力（％）
fall.defence_up = 50		; 空中コンボ修正率（％）
liedown.time = 18		; ダウン時間
airjuggle = 15		; 空中コンボ
sparkno = 2			; 初期ヒットスパーク番号
guard.sparkno = 40		; 初期ガードスパーク番号
KO.echo = 1			; ＫＯボイスエコー（0:OFF、1:ON）
volume = 255			; キャラボイスボリューム値
;IntPersistIndex = 38

[Size]
xscale = 1			; 水平サイズ倍率
yscale = 1			; 垂直サイズ倍率
ground.back = 15		; キャラ幅（地上、後ろ側）
ground.front = 30		; キャラ幅（地上、前側）
air.back = 15			; キャラ幅（空中、後ろ側）
air.front = 15		; キャラ幅（空中、前側）
z.width = 10			; キャラ幅（ｚ軸）
height = 60			; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4		;Default attack width: back, front
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = 25,-65		; 頭部座標
mid.pos = 0,-45		; 体中心部座標
shadowoffset = 0		; キャラの影・オフセット値

[Velocity]
walk.fwd  = 2.2		; 前進速度
walk.back = -2.2		; 後退速度
run.fwd  = 12, 0		; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -6.3		; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-9		; 垂直ジャンプ速度
jump.back = -4.14		; 後方ジャンプ速度
jump.fwd = 4.14		; 前方ジャンプ速度
runjump.back = -5.5,-8	; 後方ジャンプ速度（ダッシュ中）
runjump.fwd = 5.5,-8 	; 前方ジャンプ速度（ダッシュ中）
airjump.neu = 0,0		; 空中垂直ジャンプ速度
airjump.back = 0,0		; 空中後方ジャンプ速度
airjump.fwd = 0,0		; 空中前方ジャンプ速度

[Movement]
airjump.num = 0		; 空中ジャンプ回数
airjump.height = 35		; 空中ジャンプ最低高度
yaccel = .47			; キャラ重力加速度
stand.friction = .85		; 摩擦係数（立ち状態）
crouch.friction = .82	; 摩擦係数（しゃがみ状態）

;===============================================================================
; Definition of the Basic Action
;===============================================================================

;---------------------------------------------------------------------------
; ダッシュ
;------------------------ 開始
[Statedef 100]
type = S
movetype = I
physics = N
ctrl = 0

[State 100, ChangeAnim]    
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Var(24)=0,10100,100)

[State 100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, velset]
type = velset
trigger1 = AnimElem = 2 && Var(24)=0
x = const(velocity.run.fwd.x)

[State 100, velset]
type = velset
trigger1 = AnimElem >= 2 && Var(24)!=0
x = 6

[State 1200,VelMul]
type = VelMul
trigger1 = AnimElemNo(0) >= 2 && Var(24)=0
x = .92

[State 100, ChangeState]
type = ChangeState
trigger1 = Command = "holdup" && AnimElemNo(0) >= 2
value = 40

[State 100, ChangeState]
type = ChangeState
triggerall = Var(24)=0
trigger1 = Command != "holdfwd" && AnimElemNo(0) >= 3
trigger2 = Command = "holdfwd" && AnimTime = 0
value = 101

[State 100, ChangeState]
type = ChangeState
triggerall = Var(24)!=0
trigger1 = command != "holdfwd"
value = 0
ctrl = 1

;------------------------ 停止
[Statedef 101]
type = S
movetype = I
physics = S
anim = 101
velset = 0, 0
ctrl = 0

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;-------------------------------------------------------------------------------
; バックダッシュ
[Statedef 105]
type    = S
physics = N
ctrl = 0

[State 105, ChangeAnim]    
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Var(24)=0,105,10105)

[State 105, VelSet]
type = VelSet
trigger1 = AnimElemNo(0) >= 2 && Var(24)=0
x = const(velocity.run.back.x)

[State 105, VelSet]
type = VelSet
trigger1 = AnimElemNo(0) = 2 && Var(24)!=0
x = -8

[State 105, ChangeState]
type = ChangeState
trigger1 = Command = "holdup" && AnimElemNo(0) >= 2
value = 40

[State 105, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 105, VelMul]
type = VelMul
trigger1 = AnimElemNo(0) >= 2 && Var(24)!=0
x = .92

[State 105, ChangeState]
type = ChangeState
triggerall = Var(24)!=0
trigger1 = Command != "holdback" && AnimElemNo(0) >= 3
trigger2 = Command = "holdback" && AnimTime = 0
value = 106

[State 105, ChangeState]
type = ChangeState
triggerall = Var(24)=0
trigger1 = command != "holdback"
value = 0
ctrl = 1

;------------------------ 停止
[Statedef 106]
type = S
movetype = I
physics = S
anim = 10106
velset = 0, 0
ctrl = 0

[State 106, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;===============================================================================
; Definition of the Win/Lose/Intro Pause
;===============================================================================

;-------------------------------------------------------------------------------
; 時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 5300
velset = 0,0

[State 170, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 170, AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,180]
flag = RoundNotOver

;-------------------------------------------------------------------------------
; 時間切れ引き分け
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA

[State 175, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 175, ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 170

;-------------------------------------------------------------------------------
; 勝利
[Statedef 180]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 180, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = 0,ifelse(Random <= 250,17,13)
channel = 0

[State 180, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 180, AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,180]
flag = RoundNotOver

;---------------------------------------------------------------------------
; プレイントロ
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 191

;-------------------------------------------------------------------------------
; イントロ
[Statedef 191]
type = S
anim = 191

[State 191, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA

[State 191, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = 0,8
channel = 3

[State 191, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = nobardisplay

[State 191, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;-------------------------------------------------------------------------------
; 挑発
[Statedef 195]
type = S
movetype = I
physics = S
ctrl = 0

[State 195, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = 0,ifelse(Var(24)=0,8,9)
channel = 0

[State 195, VelSet]
type = VelSet
trigger1 = prevstateno != 6010
x = 0
y = 0

[State 195, Velmul]
type = Velmul
trigger1 = 1
x = .92

[State 195, ChangeAnim]    
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Var(24)=0,191,10195)

[State 195, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

