;-------------------------------------------------------------------------------
; 立ち弱攻撃
[Statedef 200]
type    = S
movetype= A
physics = N
ctrl = 0
poweradd = 0

[State 200, Turn]
type = Turn
trigger1 = Var(35) = 1 && Time = 0 
trigger1 = Facing = enemy,Facing

[State 200, ChangeAnim]    
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Var(24)=0,(200+var(35)),10200)

[State 200, VelSet]
type = VelSet
trigger1 = prevstateno != 100 && prevstateno != 6010
x = 0
y = 0

[State 200, Explod]
type = Explod
trigger1 = prevstateno = 100 && Var(11) = 0 && Time = 0
anim = 7015
postype = P1
pos = -10,0
ownpal = 1
bindtime = 1
sprpriority = 3
supermove = 1

[State 200, Velmul]
type = Velmul
trigger1 = 1
x = .90

[State 200, HitDef]
type = HitDef
trigger1 = Time = 0 && Var(24) != 0 && Var(33) = 0
attr = S, NA
animtype  = light
damage    = 28
getpower = 28
givepower = 21,0
guardflag = M
hitflag = MAF
pausetime = 10,10
sparkno = S2000
guard.sparkno = S2050
sparkxy = 10,-65
hitsound = S3, 0
guardsound = S4, 0
ground.type = High
ground.slidetime = 11
ground.hittime  = 11
ground.velocity = -6.5
air.velocity = -3,-(4*FVar(2))
air.cornerpush.veloff = 0
yaccel = .35
P2StateNo = 5005+((P2stateNo =[19000,19989]))*14495

[State 200, HitDef]
type = HitDef
trigger1 = Time = 0 && (Var(24) = 0 || Var(33) = 1)
attr = S, NA
animtype  = light
damage    = 28
getpower = 28
givepower = 21,0
guardflag = M
hitflag = MAF
pausetime = 10,10
sparkno = S2000
guard.sparkno = S2050
sparkxy = 10,-65
hitsound = S3, 0
guardsound = S4, 0
ground.type = High
ground.slidetime = 11
ground.hittime  = 11
ground.velocity = -6.5
air.velocity = -3,-(4*FVar(2))
air.cornerpush.veloff = 0
yaccel = .35

[State 200, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0 + var(35)*6010
ctrl = 1 - var(35)

