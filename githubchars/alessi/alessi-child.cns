; 立ち
[Statedef 19000]
type = S
movetype= I
physics = S
sprpriority = 0
VelSet = 0,0
ctrl = 0

[State 19000, Muteki]
type = NotHitBy
trigger1 = enemy,Var(23) <= 0
value = SCA
time = 1
ignorehitpause = 1

[State 19000, Turn]
type = Turn
trigger1 = P2dist X < -5

[State 19000,Varset(15)]
type = VarSet
trigger1 = enemy,Var(22) = 3
var(15) = 3
ignorehitpause = 1

[State 19202, PlaySnd]
type = PlaySnd
triggerall = AnimElem = 4 && Alive
trigger1 = Authorname= "bad darkness" && P1Name = "Rubber Soul"
value = 10000, 1
channel = 0
persistent = 0

[State 19000, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 19000, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 19002 && enemy,Var(22)=2
value = 19002

[State 19000, ChangeAnim2]
type = ChangeAnim2
trigger1 = Anim != (19000 + enemy,Var(22)) && enemy,Var(22)!=2 
value = 19000 + enemy,Var(22)

[State 19000, VelSet]
type = VelSet
trigger1 = Time = 0
y = 0

[State 19000, VelSet] 
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 19000, ChangeState]
type = ChangeState
trigger1 = enemy,Var(23) = 0 && Pos Y = 0
value = 19990
ctrl = 0

[State 19000, ChangeState]
type = ChangeState
trigger1 = enemy,Var(23) > 38 && (command = "holdfwd" || command = "holdback" || command = "holdup" || command = "holddown")
value = IfElse(command = "holdup",19040,IfElse(command = "holddown",19030,19020))
ctrl = 0

[State 19000, ChangeState]
type = ChangeState
trigger1 = enemy,Var(23) > 38 && (command = "x" || command = "y" || command = "z")
value = 19200 + enemy,Var(22)
ctrl = 0

