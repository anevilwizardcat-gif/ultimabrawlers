[statedef -3]
; AI AND CUSTOM PLAY MODE SETTINGS
; PLAY MODE SETTINGS; 
;
; HERE ARE THE VALUES THAT MAY BE USED.
; VARIABLE 7 [var(7)] CHARACTER PLAY MODE
; 0 = Base Playmode Selection on Button Selection in the Character Select Screen.
; 1 = Always use the default Crossover playmode.
; 2 = Always use JoJo's Venture style playmode.
; 3 = Always use JoJo's Bizarre Adventure style playmode.
; 4 = Always use New Kakyoin, JV Mode.
; 5 = Always use New Kakyoin, JJBA Mode
; 6 = Always use Customized playmode settings as asserted in this file.
; 7 = Randomize, becomes your permanent selection for the whole game
; 8 = Randomize, changes every match set
;
; The default value is always 0. If you made changes to the customized playmode selection,
; those gameplay modifications are available through the custom playmode.
;
; FORCE PLAY MODE SELECTION
[state haha]
type = varset
trigger1 = roundstate = 0
trigger1 = p1name = "noriaki kakyoin"
var(7) = 0
; VARIABLE 9 [var(9)] CHARACTER BUTTON LAYOUT MODE
; 0 = Determined by Playmode used. (Not applicable to Custom Mode)
; 1 = Always Catalyst 6-button Layout
; 2 = Always Original 4-button Layout
; 3 = Randomize, becomes your permanent selection for the whole game
; 4 = Randomize, changes every match set
;
; The Default value is always 0. If you modified the value, the changes can be seen only in Custom Mode.
; A value of 0 will sometimes be read as Crossover Button Layout.
;
; FORCE BUTTON LAYOUT SELECTION
[state haha]
type = varset
trigger1 = roundstate = 0
trigger1 = p1name = "noriaki kakyoin"
trigger1 = var(6) = 3
var(9) = 1

; VARIABLE 13 [var(13)] SUPER SOUND CHIME & ETC SELECTION
; 0 = Determined by Playmode used. (Not applicable to Custom Mode)
; 1 = Always JoJo's Bizarre Adventure 
; 2 = Always JoJo's Venture
; 3 = Randomize, becomes your permanent selection for the whole game
; 4 = Randomize, changes every match set
; 5 = Randomize, changes everytime
;
; The Default value is always 0. If you modified the value, the changes can be seen only in Custom Mode.
; Affected values include the KO chime found only in JJBA, super screens, tandem attack screen, and
; super portrait animation.
;
; FORCE SUPER CHIME SELECTION
[state haha]
type = varset
trigger1 = roundstate = 0
trigger1 = p1name = "noriaki kakyoin"
trigger1 = var(6) = 3
var(13) = 2;5

; VARIABLE 15 [var(15)] ROLLING GETUP SELECTION
; 0 = Determined by Playmode used. (Not applicable to Custom Mode)
; 1 = Enabled 
; 2 = Disabled
; 3 = Randomize, becomes your permanent selection for the whole game
; 4 = Randomize, changes every match set
; 5 = Randomize, changes everytime
;
; The Default value is always 0. If you modified the value, the changes can be seen only in Custom Mode.
; If left at 0 in Custom Mode, it defaults to Enabled.
; 
; FORCE SUPER CHIME SELECTION
[state haha]
type = varset
trigger1 = roundstate = 0
trigger1 = p1name = "noriaki kakyoin"
trigger1 = var(6) = 3
var(15) = 1

; VARIABLE 17 [var(17)] ANIMATION TYPE SELECTION
; 0 = Determined by Playmode used. (Not applicable to Custom Mode)
; 1 = Enhanced
; 2 = Original JoJo's Venture
; 3 = Original JoJo's Bizarre Adventure
; 4 = Randomize, becomes your permanent selection for the whole game
; 5 = Randomize, changes every match set
; 6 = Randomize, changes everytime
;
; The Default value is always 0. If you modified the value, the changes can be seen only in Custom Mode.
; If left at 0 in Custom Mode, it defaults to Enhanced.
; 
; FORCE ANIMATION TYPE
[state haha]
type = varset
trigger1 = roundstate = 0
trigger1 = p1name = "noriaki kakyoin"
trigger1 = var(6) = 3
var(17) = 1

; Var(27) = Screen Language (SFX, win)
;		   0 = English
;		   1 = Japanese
;		   2 = Randomize, becomes your permanent selection for the whole game
;		   3 = Randomize, changes every match set
;		   4 = Randomize, changes all the time
; NOTE: Will affect globally, regardless of modes
[state haha]
type = varset
trigger1 = roundstate = 0
trigger1 = p1name = "noriaki kakyoin"
;trigger1 = var(6) = 3
var(27) = 0
