; Stand Getting Hit and Disappearing
[Statedef 5055]
type    = U
movetype= H
physics = U
juggle  = 3
ctrl = 0
;anim = 258
velset = 0,0

[State heh]
type = ChangeAnim
trigger1 = Time <= GetHitVar(hitshaketime)
value = 5055
ignorehitpause = 1

[State that Prevent The World from activating]
type = ParentVarSet
trigger1 = 1
v = 35
value = GetHitVar(damage)

[State that Prevent The World from activating]
type = ParentVarSet
trigger1 = 1
v = 7
value = 1

[State immediate]
type = AfterImageTime
trigger1 = Time = 0
value = 0

[State 210, VelSet]
type = PlaySnd
trigger1 = AnimElem = 2
value = s0,38
supermove = 1

[State 3000,1]
type = DestroySelf
trigger1 = AnimElemNo(1) = 7
trigger1 = GetHitVar(hittime) <= 0
ignorehitpause = 1

[State that Prevent The World from activating]
type = ParentVarSet
trigger1 = AnimTime = 0
v = 7
value = 0