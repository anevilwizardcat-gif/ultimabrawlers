;STAND SHP
[Statedef 22501]
type    = S
movetype= I
physics = N
ctrl = 0
anim = ((parent, anim) * 100) + 1
velset = 0,0,0
sprpriority = (parent, var(1))

[state haha]
type = varset
trigger1 = time = 0
sysvar(0) = (parent, sysvar(0))

[State leh]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[state haha]
type = bindtoparent
trigger1 = 1
pos = 0,0
value = 1
ignorehitpause = 1

[State hm]
type = changeanim
trigger1 = 1
;trigger1 = parent, animelemno(0) = 5 && parent, movecontact = [1,5]
;trigger2 = (parent, animelemno(0) = [12,13]) && parent, movecontact = [1,10]
value = ((parent, anim) * 100) + 1
elem = parent, var(10) ;ifelse((parent, animelemno(0)) != animelemno(0), (parent, animelemno(0) - 1), animelemno(0))
ignorehitpause = 1

[state haha]
type = destroyself
trigger1 = parent, animtime = 0
trigger2 = root, numhelper(sysvar(0)) = 0
;trigger3 = root, numhelper(315) = 0
;trigger4 = root, numhelper(325) = 0
;trigger5 = root, numhelper(355) = 0
;trigger6 = root, numhelper(415) = 0
;trigger7 = root, numhelper(425) = 0
;trigger8 = root, numhelper(455) = 0
ignorehitpause = 1

