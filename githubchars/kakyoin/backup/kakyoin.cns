;---------------------------------------------------------------------------
; Taunt
[Statedef 160]
type = S
ctrl = 0
velset = 0,0

[State heh]
type = ChangeAnim
trigger1 = time = var(16) && Anim != (90 + var(3))
value = 90 + var(3)

[State heh]
type = PlaySnd
triggerall = time = var(16)
trigger1 = Command != "hold_x"
trigger1 = Command != "hold_y"
trigger1 = Command != "hold_z"
value = IfElse(random >= 500, 1, 2), 2
channel = 0

[State heh]
type = PlaySnd
triggerall = time = var(16)
trigger1 = Command = "hold_x"
trigger2 = Command = "hold_y"
trigger3 = Command = "hold_z"
value = 1, 3
channel = 0

[State 170, 1]
type = ChangeState
trigger1 = Time = 70
value = 0
ctrl = 1

