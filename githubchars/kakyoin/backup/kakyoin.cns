; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State haha]
type = PowerAdd
trigger1 = Time = 0
value = 1000

[State 190, 1]
type = ChangeState
trigger1 = P2Name = "Rubber Soul" || P4Name = "Rubber Soul"
trigger2 = P2Name = "American Idiot" || P4Name = "American Idiot"
value = 195

[State 190, 1]
type = ChangeState
trigger1 = P2Name = "Shadow Dio" || P4Name = "Shadow Dio"
trigger2 = P2Name = "Dio Brando" || P4Name = "Dio Brando"
trigger3 = P2Name = "Dio By ANMC" || P4Name = "Dio By ANMC"
trigger4 = P2Name = "Dio" || P4Name = "Dio"
value = 196

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191 + IfElse(random <= 400, 1, IfElse(random >= 401, 4, 0))

;---------------------------------------------------------------------------
; INTRO
[Statedef 191]
type = S
physics = S
ctrl = 0
anim = 3

[state haha]
type = varset
trigger1 = time = 0
sysvar(1) = 0

[state haha]
type = varset
trigger1 = time = 0
sysvar(1) = 3

[state haha]
type = varset
trigger1 = time = 0
sysvar(0) = (random >= 500)
persistent = 0

[State Randomizer]
type = VarRandom
trigger1 = 1
v = 2
range = 1, 3

[State Animation 1, Chosen the same ani]
type = ChangeAnim
trigger1 = (Anim = [1,3]) && AnimTime = 0
value = var(2)

[State 191, 1] ;Intro not yet over
type = AssertSpecial
trigger1 = 1
flag = intro

[State haha]
type = VarRandom
trigger1 = 1
v = 3
range = 0,3

[State haha]
type = VarRandom
trigger1 = 1
v = 1
range = 0,1

[State heh]
type = ChangeAnim
triggerall = roundstate = 1
trigger1 = sysvar(0) = 0 && Time >= 60
value = 90 + var(3)
persistent = 0

[state haha]
type = ChangeAnim
triggerall = roundstate = 1
trigger1 = sysvar(0) = 1 && sysvar(4) >= 30 ;(enemy, anim = 0 || p2stateno = 0)
value = 90 + var(3)
persistent = 0

[state haha]
type = varadd
trigger1 = anim = [1,3]
sysvar(1) = 1

[state haha]
type = varset
trigger1 = (enemy, anim = 0 || p2stateno = 0)
trigger2 = (enemy, animtime > 0) && enemy, animelemtime((enemy, animelemno(0))) >= 40
trigger3 = p2name = "noriaki kakyoin" && enemy, authorname = "Orochi Herman"
trigger3 = enemy, sysvar(0) = 1 && sysvar(0) = 1
trigger4 = ishometeam
sysvar(3) = 1

[state haha]
type = varadd
trigger1 = sysvar(3) = 1
sysvar(4) = 1

[State hehe]
type = PlaySnd
triggerall = var(1) = 0
trigger1 = sysvar(0) = 0 && time = 60
trigger2 = sysvar(0) = 1 && sysvar(4) = 30 
value = s1,16 + (random >= 500)
channel = 0

[State hehe]
type = PlaySnd
triggerall = var(1) = 1
trigger1 = sysvar(0) = 0 && time = 60
trigger2 = sysvar(0) = 1 && sysvar(4) = 30 
value = s2 - (random >= 500),2
channel = 0

[State 191, 3]
type = ChangeState
triggerall = var(1) = 0
trigger1 = sysvar(1) = 0 && Time >= 70 
trigger1 = sysvar(0) = 1 && sysvar(4) >= 40
value = 0

[State 191, 3]
type = ChangeState
triggerall = var(1) = 1
trigger1 = sysvar(0) = 0 && Time >= 90 ;+ sysvar(1)
trigger2 = sysvar(0) = 1 && sysvar(4) >= 60
value = 0
anim = 0

