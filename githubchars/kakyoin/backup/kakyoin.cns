var(18) = 0
ignorehitpause = 1

[State 200, 1]
type = PlaySnd
trigger1 = AnimElem = 1
value = s0, 6

[State 200, 3]
type = HitDef
trigger1 = AnimElem = 1              ;Time to activate controller
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage    = 27                   ;Damage that move inflicts
guardflag = M                   ;Flags on how move is to be guarded against
animtype = Light
pausetime = 8,8                ;Time attacker pauses, time opponent shakes
sparkno = 0
sparkxy = 20,-80                  ;X-offset for the "hit spark" rel. to p2,
hitsound = s0 + (10 * (RoundState = 3 && WinKO)),0                   ;Sound to play on hit
guardsound = s0,21                 ;Sound to play on guard
ground.type = Low                ;Type (refer to testp.h)
ground.slidetime = 12             ;Time that the victim slides back
