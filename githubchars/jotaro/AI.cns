;---------------------------------------------------------------------------
;AI用待機
[Statedef 99900]
type = S
physics = S
sprpriority = !var(49)
ctrl = 0
velset = 0,0

[State 99900, 1]
type = Turn
trigger1 = P2Dist X < 0

[State 0, 1]
type = ChangeAnim
triggerall = var(0) != -1
triggerall = var(0) != 2
trigger1 = Anim != 0+var(49) && Anim != 5+var(49)
trigger2 = Anim = 5+var(49) && AnimTime = 0 ;Turn anim over
value = 0+var(49)

[State 99900, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 99900, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 99900, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 99900, 4]
type = ChangeState
trigger1 = IsHelper(10000)
value = 10000

[State 99900, 4]
type = ChangeState
trigger1 = IsHelper(20000)
value = 20000

;待機終了条件(タンデム飛び越え待機中)
[State 99900, 5]
type = CtrlSet
triggerall = var(8) = 3
triggerall = fvar(37) = 2 || fvar(37) = 5 || fvar(37) = 8
triggerall = numhelper(10000)
triggerall = facing = helper(10000),facing
trigger1 = p2bodydist x > 160
trigger2 = p2statetype = A
trigger3 = numhelper(33333) && numhelper(22222)
trigger3 = (helper(22222),p2bodydist x < 50 && facing = 1) || (helper(33333),p2bodydist x < 50 && facing = -1)
trigger4 = numhelper(10000)
trigger4 = helper(10000),var(4) >= 2
value = 1

;待機終了条件(プッツンオラ移行用タンデム待機中)
[State 99900, 5]
type = CtrlSet
triggerall = var(8) = 3
triggerall = fvar(37) = 13
trigger1 = p2bodydist x > 160
trigger2 = p2statetype = A
value = 1

;待機終了条件(プッツンオラ×３タンデム待機中)
[State 99900, 5]
type = CtrlSet
triggerall = var(8) = 3
triggerall = fvar(37) = 10
trigger1 = p2bodydist x > 35
value = 1

;待機終了条件(画面端プッツンオラコンボ待機中)
[State 99900, 5]
type = CtrlSet
triggerall = numhelper(10000)
triggerall = helper(10000),stateno = 13000
triggerall = numhelper(33333) && numhelper(22222)
triggerall = (helper(22222),p2bodydist x < 50 && facing = 1) || (helper(33333),p2bodydist x < 50 && facing = -1)
triggerall = enemynear,backedgedist <= 0+10 || enemynear,frontedgebodydist <= 0+10
trigger1 = p2statetype = A
trigger2 = helper(10000),animelemtime(50) >= 0
trigger3 = p2bodydist x > 190
value = 1

;待機終了条件(フィンガーコンボ待機中)
[State 99900, 5]
type = CtrlSet
triggerall = numhelper(10000)
triggerall = helper(10000),stateno = 11200
trigger1 = roundstate != 2
trigger2 = p2statetype = L
trigger3 = p2statetype = A
trigger4 = p2movetype != H && (helper(10000),anim != 11201 || helper(10000),animelemtime(3) > 0)
trigger5 = p2dist x < 0
value = 1

;待機終了条件(オラオラコンボ待機中)
[State 99900, 5]
type = CtrlSet
triggerall = numhelper(10000)
triggerall = helper(10000),stateno = 11000
trigger1 = roundstate != 2
trigger2 = p2statetype = L
trigger3 = p2statetype = A
trigger4 = p2movetype != H
trigger5 = p2dist x < 0
trigger6 = p2bodydist x > 160
value = 1

;待機終了条件(共通)
[State 99900, 5]
type = CtrlSet
triggerall = numhelper(10000)
triggerall = helper(10000),stateno != 11200 || roundstate != 2
triggerall = fvar(37) != 14 || roundstate != 2
trigger1 = roundstate != 2
trigger2 = p2movetype != H
trigger3 = p2statetype = L
trigger4 = p2dist x < 0
value = 1

