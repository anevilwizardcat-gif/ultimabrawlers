; Taunt
; CNS difficulty: easy
[Statedef 195]
type = S
ctrl = 0
velset = 0,0
poweradd = 300
sprpriority = 2

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = life > 500
value = 195

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = life <= 500
value = 196

[State 0, PlaySnd]
type = PlaySnd
trigger1 = life > 500
trigger1 = animelem = 2
value = S195,10
volume = 1000
persistent = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = life > 500
trigger1 = animelem = 2
value = S195,10
volume = 1000
persistent = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = life <= 500
trigger1 = animelem = 1
value = S195,11
volume = 1000
persistent = 0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = life <= 500
trigger1 = animelem = 1
value = S195,11
volume = 1000
persistent = 0

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

