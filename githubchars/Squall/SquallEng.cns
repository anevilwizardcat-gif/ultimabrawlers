; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1000			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = -1
guard.sparkno = -1
KO.echo = 0			;1 to enable echo on KO
volume = 1000			;Volume offset (negative for softer)
IntPersistIndex = 50	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = 1			;Horizontal scaling factor.
yscale = 1			;Vertical scaling factor.
ground.back = 16		;Player width (back, ground)
ground.front = 22		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = 10, -93	;Approximate position of head
mid.pos = 20, -55		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4		;Walk forward
walk.back = -2.2		;Walk backward
run.fwd  = 5.2, 0		;Run forward (x, y)
run.back = -4.5,-3.8	;Hop backward (x, y)
jump.neu = 0,-8.0		;Neutral jumping velocity (x, y)
jump.back = -3		;Jump back Speed (x, y)
jump.fwd = 3		;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1;Running jump speeds (opt)
runjump.fwd = 4.5,-8.1	;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 120	;Minimum distance from ground before you can air jump (opt)
yaccel = .44		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "As long as you don't get your hopes up, you can take anything... You feel less pain."
victory2 = "Give me a break... "
victory3 = "I'll be all right, Matron. 'Cause I'm not alone."
victory4 = "I'm not having anyone talk about me in past tense! "
victory5 = "...Whatever."

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
velset = 0,0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(life>500,170,171)

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = anim = 170
trigger1 = time <= 91
flag = roundnotover

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = anim = 171
trigger1 = time <= 101
flag = roundnotover

[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 170
trigger1 = AnimElem = 2
value = S170,11
volume = 1000

[State 0, PlaySnd]
type = PlaySnd
trigger1 = anim = 171
trigger1 = AnimElem = 4
value = S170,12
volume = 1000

[State 0, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Life > 600
trigger1 = Time = 0
value = 181

[State 180, 1]
type = ChangeState
trigger1 = Life = [300,600]
trigger1 = Time = 0
value = 182

[State 180, 1]
type = ChangeState
trigger1 = Life < 300
trigger1 = Time = 0
value = 183

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = time <= 111
flag = roundnotover

[State 0, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3
value = S180,10
volume = 1000

[State 0, PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

