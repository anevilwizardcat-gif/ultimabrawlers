type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 0, CtrlSet]
type = CtrlSet
triggerall =  AILevel >0
trigger1 = time > 60 || p2bodydist x < 40||p2movetype=A
value = 1
[State 100, 4]
type = ChangeState
triggerall = AILevel>0
trigger1 = time > 60 || p2bodydist x < 40
value = 101


[State 100, 4]
type = ChangeState
triggerall = AILevel=0
trigger1 = command != "holdfwd"
value = 101


