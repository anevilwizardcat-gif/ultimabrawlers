name = "helper1"
id = 6001
pos = 0,0
postype = p1
stateno = 6001
helpertype = normal
ownpal = 1
keyctrl = 1

[State 182, Voice]
type = playsnd
trigger1 =!time && MatchOver
value = 182,0
channel = 8

[State 182, AssertSpecial]
type = AssertSpecial
trigger1 = time = 3000 && MatchOver 
flag = roundnotover
flag2 = nomusic
