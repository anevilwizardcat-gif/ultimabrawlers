;Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, InvisForFatal]
type = AssertSpecial
flag = Invisible
trigger1 = Var(40) = 1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 1 && Anim != 2
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4]
type = Varset
trigger1 = Var(13) != 0
trigger1 = time >= 8
v = 13
value = 0

[State 0, 5]
type = PosSet
trigger1 = 1
trigger1 = var(4) = 0
y = 0

