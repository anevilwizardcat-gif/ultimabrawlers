;---------------------------------------------------------------------------
; Walk
[Statedef 21]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 0, 0]
type = Turn
trigger1 = p2dist x < 0

[State 21, 1]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno != 21
trigger1 = (random < 500 && frontedgebodydist >= 90) || backedgedist < 90
trigger1 = p2bodydist x >= 3
trigger2 = prevstateno != 21 || time > 0
trigger2 = vel x > 0
x = const(velocity.walk.fwd.x)

[State 21, 2]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno != 21
trigger1 = vel x != const(velocity.walk.fwd.x)
trigger2 = prevstateno != 21 || time > 0
trigger2 = vel x < 0
x = const(velocity.walk.back.x)

[State 21, 2]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno = 21
x = ifelse(vel x > 0, const(velocity.walk.back.x), const(velocity.walk.fwd.x))

[State 21, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 21, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 21, 5]
type = CtrlSet
trigger1 = inguarddist
value = 1

[State 21, stop]
type = ChangeState
trigger1 = (random < 20 || frontedgebodydist <= 10 || p2bodydist x < 3) && anim = 20
trigger1 = time >= 20 || frontedgebodydist <= 1 || p2bodydist x < 3
trigger2 = (random < 20 || backedgedist <= 10) && anim = 21
trigger2 = time >= 20 || backedgedist <= 1
trigger3 = roundstate != 2
value=0
ctrl=1

;---------------------------------------------------------------------------
; Walk(for counter
[Statedef 22]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 0, 0]
type = Turn
trigger1 = p2dist x < 0

[State 22, 1]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno != 22
trigger1 = (random < 500 && frontedgebodydist >= 90) || backedgedist < 90
trigger1 = p2bodydist x >= 3
trigger2 = prevstateno != 22 || time > 0
trigger2 = vel x > 0
x = const(velocity.walk.fwd.x)

[State 22, 2]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno != 22
trigger1 = vel x != const(velocity.walk.fwd.x)
trigger2 = prevstateno != 22 || time > 0
trigger2 = vel x < 0
x = const(velocity.walk.back.x)

[State 22, 2]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno = 22
x = ifelse(vel x > 0, const(velocity.walk.back.x), const(velocity.walk.fwd.x))

[State 22, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 22, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 22, stop]
type = ChangeState
trigger1 = vel x >= 0 && frontedgebodydist <= 1 && anim = 20
trigger2 = vel x <= 0 && backedgedist <= 1 && anim = 21
trigger3 = roundstate != 2
trigger4 = numhelper(33333)
trigger4 = helper(33333),var(28) >= 180 || (helper(33333),var(28) = 120 && random < 300) || (helper(33333),var(28) = 60 && random < 100)
trigger4 = !helper(33333),var(26)
value=0
ctrl=1

;---------------------------------------------------------------------------
; Walk(for throw
[Statedef 23]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 0, 0]
type = Turn
trigger1 = p2dist x < 0

[State 23, 1]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 23, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 23, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 23, 5]
type = CtrlSet
trigger1 = inguarddist
trigger2 = time >= 60
value = 1

[State 23, stop]
type = ChangeState
trigger1 = anim = 20
trigger1 = frontedgebodydist <= 1 || (p2bodydist x < 3 && (p2movetype != H || p2statetype = A))
trigger2 = anim = 21
trigger2 = backedgedist <= 1
trigger3 = p2dist x < 0
trigger4 = roundstate != 2
value=0
ctrl=1

