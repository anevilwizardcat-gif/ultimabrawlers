; Stand
[Statedef 99900]
type = S
physics = S
sprpriority = 0
ctrl = 0

[State 0, 0]
type = Turn
trigger1 = p2dist x < 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5  && Anim != 1
trigger2 = Anim = 5 && AnimTime = 0
trigger3 = Anim = 1 && AnimTime = 0
value = 0

[State 0, 1]
type = ChangeAnim
trigger1 = prevstateno = 191
trigger1 = time = 0
persistent=0
value = 0
elem = 24

[State 0, 1]
type = ChangeAnim
triggerall = time = 0
triggerall = stateno = 99900
trigger1 = prevstateno = [200,209]
trigger2 = prevstateno = [2000,2999]
trigger3 = prevstateno = 3050 || prevstateno = 410 || prevstateno = 107
persistent=0
value = 1

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 0, 5]
type = CtrlSet
trigger1 = roundstate != 2
trigger2 = !enemynear,hitfall && p2stateno != 5210
trigger3 = p2statetype = L
value = 1

