;---------------------------------------------------------------------------
; Walk(for aerial adjust
[Statedef 25]
type    = S
physics = S
sprpriority = 0
ctrl = 0

[State 0, 0]
type = Turn
trigger1 = p2dist x < 0

[State -1, landtimevar];t=(-v0+√(v0^2-2a(x0-x)))/a
type = VarSet
trigger1= 1
fvar(36)= (-enemynear,vel y+(enemynear,vel y**2-2*enemynear,const(movement.yaccel)*ifelse(enemynear,pos y+100>0,0,enemynear,pos y+100))**.5)/enemynear,const(movement.yaccel)

[State 25, 1]
type = VelSet
trigger1 = time = 0
trigger1 = p2bodydist y < -90
trigger1 = p2dist x >= 0
trigger1 = (facing != enemynear,facing && enemynear,vel x > 0) || (facing = enemynear,facing && enemynear,vel x < 0)
trigger1 = p2dist x-enemynear,vel x*(1-(facing=enemynear,facing)*2)*fvar(36)-const(velocity.walk.fwd.x)*fvar(36) < 0
trigger2 = vel x > 0
x = const(velocity.walk.fwd.x)

[State 25, 2]
type = VelSet
trigger1 = time = 0
trigger1 = vel x <= 0
trigger2 = vel x < 0
x = const(velocity.walk.back.x)

[State 25, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 25, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 25, stop]
type = ChangeState
trigger1 = anim = 20 && p2dist x < 0
trigger2 = anim = 21 && p2bodydist x >= 10
value=99900
ctrl=0

[State 25, stop]
type = ChangeState
trigger1 = p2dist x < 0
trigger2 = roundstate != 2
trigger3 = p2movetype != H
trigger4 = p2statetype = L
value=0
ctrl=1

;---------------------------------------------------------------------------
;ジャンプ開始
[Statedef 41]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0

[State 41, HitBy]
type = HitBy
trigger1 = 1
value = SCA, NA,SA,HA,NP,SP,HP


[State 41, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = ceil(fvar(30))

[State 41, 4];ハイジャンプ判定
type = VarSet
triggerall = Time = 0
trigger1 = (PrevStateNo = 100 || PrevStateNo = 101) && sysvar(1) = 1
var(3) = 1

[State 41, 6]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = !Var(3)
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 41, 7]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(3)
x = ifelse(!sysvar(1), 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))

[State 41, 8]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = !Var(4)
y = ifelse(Var(3) && !SysVar(1), const(velocity.jump.y)*1.15, const(velocity.jump.y))

[State 41, 9]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(4)
y = ifelse(Var(3) && !SysVar(1), const(velocity.jump.y)*1.15*.75, const(velocity.jump.y)*.75)

[State 41, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

