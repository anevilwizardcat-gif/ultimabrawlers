;=====================<PSI-BLAST>==========================
[StateDef 1000]
type = S
physics = S
moveType = A
anim = 1000
ctrl = 0
velset = 0,0
sprPriority = 1
poweradd = 84 * !var(20)
faceP2 = 1

[State 1000, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))

[State 1000, Button Detect (AI)]
type = VarSet
triggerall = !Time && AILevel
trigger1 = !(EnemyNear, StateType = A) && !(EnemyNear, StateNo = 40)
trigger2 = (EnemyNear, MoveType = H || MoveContact) && !(EnemyNear, StateType = A)
trigger3 = (EnemyNear, StateNo = 1000) && (EnemyNear, NumHelper) && EnemyNear, MoveType = A
var(10) = 1

[State 1000, Button Detect (AI)]
type = VarSet
triggerall = !Time && AILevel
trigger1 = EnemyNear, StateType = A && P2BodyDist x >= 60 && !(EnemyNear, HitFall) && !(EnemyNear, StateType = L)
trigger1 = !(EnemyNear, MoveType = H) && !MoveContact
var(10) = 2

[State 1000, Voice]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1000,3
channel = 0

[State 1000, Psi-Blast Snd]
type = PlaySnd
trigger1 = AnimElem = 3
value = 1, 6
channel = 2

[State 1000, Psi-Blast FX]
type = Explod
trigger1 = !NumExplod(1001)
trigger1 = AnimElem = 4
anim = 1001
ID = 1001
pos = 25, -82
postype = P1
sprpriority = 3
scale = .5,.5
ignorehitpause = 1
bindtime = 16
pausemovetime = 65535
supermovetime = 65535
ownpal = 1
removeongethit = 1

[State 1000, Width: Player]
type = Width
trigger1 = AnimElemTime(5) < 0
player = 30,0

[State 1000, Projectile]
type = Helper
trigger1 = AnimElem = 4
helperType = Normal
stateNo = 1010
ID = 1010
name = "Butterfly"
posType = P1
pos = 36,-80
size.xScale = 0.625
size.yScale = 0.625
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1

[State 1000, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

