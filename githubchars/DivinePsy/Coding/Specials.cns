type = U
physics = N
moveType = I
anim = 1400
ctrl = 0
velset = 0,0
sprPriority = 2
poweradd = 30 * !var(20)

[State 1500, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "a" || command = "rlsa"), 0, ifElse((command = "b" || command = "rlsb"), 1, 2))

[State 1500, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse(P2Dist x > 160, 2, ifElse(P2Dist x > 110, 1, 0))

[State 1510, No Corner Push]
type = VarSet
trigger1 = AnimElemTime(6) < 0
fvar(5) = 0

[State 1500, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1000,5
channel = 0

[State 1500, Snd FX]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1000, 1
channel = 1

[State 1500, Muteki]
type = Nothitby
trigger1 = AnimElemTime(9) < 0
time = 1
value = SCA

[State 1500, PosSet: Teleportation]
type = Posset
trigger1 = AnimElem = 5
x = Ifelse(var(10)=0,-200,Ifelse(var(10)=1,0,200))

[State 1500, Transparency]
type = Trans
trigger1 = AnimElemTime(2) >= 0
trigger1 = AnimElemTime(4) < 0
trans = addalpha
alpha = 256-((time-6)*42),(time-6)*42

[State 1500, Transparency]
type = trans
trigger1 = AnimElemTime(6) >= 0
trigger1 = AnimElemTime(8) < 0
trans = addalpha
alpha = (time-24)*42,256-((time-24)*42)

[State 1500, StateType: Standing]
type = StateTypeSet
trigger1 = AnimElemTime(6) >= 0
stateType = S
physics = S

[State 1500, Turn]
type = Turn
trigger1 = AnimElem = 5
trigger1 = p2dist x < -5

[State 1500, Control]
type = CtrlSet
trigger1 = AnimElemTime(9) = 0
value = 1

[State 1500, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

;Air Variant
[StateDef 1510]
type = U
physics = N
moveType = I
anim = 1410
ctrl = 0
velset = 0,0
sprPriority = 2
poweradd = 30 * !var(20)

[State 1510, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))

[State 1510, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse(P2Dist x > 160, 2, ifElse(P2Dist x > 110, 1, 0))

[State 1510, No Corner Push]
type = VarSet
trigger1 = AnimElemTime(6) < 0
fvar(5) = 0

[State 1510, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1000,5
channel = 0

[State 1510, Snd FX]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1000, 1
channel = 1

[State 1510, Muteki]
type = Nothitby
trigger1 = AnimElemTime(9) < 0
time = 1
value = SCA

[State 1510, PosSet: Teleportation]
type = Posset
trigger1 = AnimElem = 5
x = Ifelse(var(10)=0,-200,Ifelse(var(10)=1,0,200))
y = -120

[State 1510, Transparency]
type = Trans
trigger1 = AnimElemTime(2) >= 0
trigger1 = AnimElemTime(4) < 0
trans = addalpha
alpha = 256-((time-6)*42),(time-6)*42

[State 1510, Transparency]
type = trans
trigger1 = AnimElemTime(6) >= 0
trigger1 = AnimElemTime(8) < 0
trans = addalpha
alpha = (time-24)*42,256-((time-24)*42)

[State 1510, StateType: Air, no physics]
type = StateTypeSet
trigger1 = AnimElemTime(6) >= 0
stateType = A
physics = N

[State 1510, Gravity]
type = VelAdd
trigger1 = AnimElemTime(10) >= 0
y = .58

[State 1510, Turn]
type = Turn
trigger1 = AnimElem = 5
trigger1 = p2dist x < -5

[State 1510, Control]
type = CtrlSet
trigger1 = AnimElemTime(9) = 0
value = 1

[State 1510, End]
type = ChangeState
trigger1 = pos y > -vel y
value = 52

;=====================<PSI-DRILL(AIR)>==========================
[Statedef 1520]
type = A
movetype = A
physics = N
ctrl = 0
anim = 1420
velset = 0,0
poweradd = 70 * !var(20)
sprpriority = 2

[State 1520, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 0,1
channel = 0

[State 1520, Energy Snd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1,7

[State 1520, Energy Knife FX]
type = Explod
trigger1 = !NumExplod(1525)
trigger1 = AnimElem = 3
anim = 1425
ID = 1525
pos = 41, -46
postype = P1
sprpriority = 4
scale = 0.3,0.4
ignorehitpause = 1
bindtime = -1
removetime = -1
ownpal = 1
removeongethit = 1

[State 1520, Width: Edge]
type = Width
trigger1 = 1
edge = 15,0

[State 1520, HitDef]
type = HitDef
trigger1 = !var(16) && var(15) < 1
trigger1 = !Time
attr = A, SA
damage = ceil(ifElse(fvar(11) * 84 < 7, 7, fvar(11) * 84)), 8
priority = 4, hit
animtype = Hard
getpower = 70 * !var(20), 30 * !var(20)
givepower = 35, 35
guardflag = HA
hitflag = MAF
hitsound = s2,10
guardsound = s130,0
pausetime = 10, 10
guard.pausetime = 10, 10
sparkNo = -1 + 0 * (var(33) := 8016)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 77), var(36) := -13
ground.type = High
air.animType = Back
fall.animType = Back
air.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime  = 18
airguard.ctrlTime = 16
ground.velocity = -5,-7
air.velocity = -5,-7
airguard.velocity = -7, -1
guard.velocity = -10
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .58
fall = 1
fall.recover = 0
envshake.time = 14
envshake.ampl = 4
envShake.freq = 120
forcestand = 1
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48

[State 1520, Velocity]
type = VelSet
trigger1 = AnimElem = 3
x = 7
y = 7

[State 1520, End]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 1521

