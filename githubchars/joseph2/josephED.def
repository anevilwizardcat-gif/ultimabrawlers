
[SceneDef]
spr = josephED.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------------------------------------------
;------------------------------------------------------------------------
[Scene 0]
; Fade
fadein.time = 100        ;現れるまでの時間（layer0.starttime　の時間、含む）
fadein.col = 0,0,0    ;フェイドイン時のカラー設定Use 255,255,255 for white-fade

; Screen color
clearcolor = 0,0,0

; Overlay Anims (from 0 to 9);描かれるアニメの設定
layerall.pos = 0,0   ;全てのLayerでの基本となる位置。所謂初期値。
layer0.anim =  0       ;アニメーションするNo設定
layer0.offset = 0,0;24,168    ;位置の指定
layer0.starttime = 0  ;表示させる時間(0の場合は勿論"最初から"の意味)

layer1.anim =  1         ;文字とか
layer1.offset = 24,168
layer1.starttime = 250
bgm = josephED.mp3
bgm.loop = 0

; Total time       ;このシーンをトータルで表示させておく時間の設定
end.time = 5220     ;全体での終了する時間

fadeout.time = 50         ;消えるまで時間
fadeout.col = 0,0,0   ;フェイドアウト時のカラー設定

