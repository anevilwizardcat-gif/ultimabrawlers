Trigger1 = Time = 0
Persistent = 0
var(26) = 75  ;★[AI]連続ジャストガード率。0でなし、100で確実

[State 9901, Guard Cancel Level]
Type = VarSet
Trigger1 = Time = 0
Persistent = 0
var(27) = 40  ;★[AI]ガードキャンセル率。0でしない、100で高確率

[State 9901, Inifinity Loop Level(Master only)]
Type = VarSet
Trigger1 = Time = 0
Persistent = 0
var(28) = 0  ;★[AI]永久ループ使用設定（マスターのみ）。0でしない、1で劣勢時のみ、2で隙あらば狙う

[State 9901, Initialize]
Type = VarSet
Trigger1 = var(1) = 0
var(4) = 0  ;連続検知カウント

[State 9901, Initialize]
Type = VarSet
Trigger1 = Time > 0
var(1) = 0

[State 9901, Initialize]
Type = VarSet
Trigger1 = Time > 0
var(5) = 0

[State 9901, Initialize]
Type = VarSet
Trigger1 = Time > 0
fvar(1) = 0

[State 9901, Initialize]
Type = VarSet
Trigger1 = Time > 0
var(51) = 8  ;飛び道具検知の間隔距離

[State 9901, Initialize]
Type = VarSet
Trigger1 = Time > 0
var(52) = 30  ;飛び道具検知試行回数（片側）

[State 9901, Initialize]
Type = VarSet
Trigger1 = Time > 0
var(50) = var(52) * 2  ;飛び道具検知試行回数（両側合計）

[State 9901, NearestTarget]  ;とりあえず1Pをターゲットに
Type = VarSet
Trigger1 = Time > 0
var(30) = 0

[State 9901, NearestTarget]  ;ただし、1Pが倒れて2Pが生きてる場合、2Pをターゲットに
Type = VarSet
Trigger1 = Time > 0
Trigger1 = NumEnemy > 1
Trigger1 = Enemy(0),Alive = 0
Trigger1 = Enemy(1),Alive = 1
var(30) = 1

[State 9901, NearestTarget]  ;2Pが生きていて1Pよりも近ければ2Pをターゲットに
Type = VarSet
TriggerAll = Time > 0
Trigger1 = NumEnemy > 1
Trigger1 = Enemy(1),Alive = 1
Trigger1 = Abs(Enemy(0),Pos X - Pos X) > Abs(Enemy(1),Pos X - Pos X)
var(30) = 1

;▽数F後の敵のおおまかな位置を予測計算する
[State 9901, CalcEnemyLoc_5X]
Type = VarSet
Trigger1 = Time > 0
fvar(10) = Abs(IfElse(Parent,StateType != A, Parent,Pos X, (Parent,Pos X + Parent,Vel X * 5 * Parent,Facing)) - (Enemy(var(30)),Pos X + Enemy(var(30)),Vel X * 5 * Enemy(var(30)),Facing))

[State 9901, CalcEnemyLoc_5Y]
Type = VarSet
Trigger1 = Time > 0
fvar(11) = IfElse(Parent,StateType != A, Parent,Pos Y, (Parent,Pos Y + Parent,Vel Y * 5) + (0.5 * Parent,Const(Movement.YAccel) * 5 ** 2 * (5 / 4)))

[State 9901, CalcEnemyLoc_5Y]
Type = VarSet
Trigger1 = Time > 0
fvar(11) = fvar(11) + ((Enemy(var(30)),Pos Y + Enemy(var(30)),Vel Y * 5) + (0.5 * Enemy(var(30)),Const(Movement.YAccel) * 5 ** 2 * (5 / 4)))

[State 9901, CalcEnemyLoc_10X]
Type = VarSet
Trigger1 = Time > 0
fvar(12) = Abs(IfElse(Parent,StateType != A, Parent,Pos X, (Parent,Pos X + Parent,Vel X * 10 * Parent,Facing)) - (Enemy(var(30)),Pos X + Enemy(var(30)),Vel X * 10 * Enemy(var(30)),Facing))

[State 9901, CalcEnemyLoc_10Y]
Type = VarSet
Trigger1 = Time > 0
fvar(13) = IfElse(Parent,StateType != A, Parent,Pos Y, (Parent,Pos Y + Parent,Vel Y * 10) + (0.5 * Parent,Const(Movement.YAccel) * 10 ** 2 * (10 / 9)))

[State 9901, CalcEnemyLoc_10Y]
Type = VarSet
Trigger1 = Time > 0
fvar(13) = fvar(13) + ((Enemy(var(30)),Pos Y + Enemy(var(30)),Vel Y * 10) + (0.5 * Enemy(var(30)),Const(Movement.YAccel) * 10 ** 2 * (10 / 9)))

[State 9901, CalcEnemyLoc_15X]
Type = VarSet
Trigger1 = Time > 0
fvar(14) = Abs(IfElse(Parent,StateType != A, Parent,Pos X, (Parent,Pos X + Parent,Vel X * 15 * Parent,Facing)) - (Enemy(var(30)),Pos X + Enemy(var(30)),Vel X * 15 * Enemy(var(30)),Facing))

[State 9901, CalcEnemyLoc_15Y]
Type = VarSet
Trigger1 = Time > 0
fvar(15) = IfElse(Parent,StateType != A, Parent,Pos Y, (Parent,Pos Y + Parent,Vel Y * 15) + (0.5 * Parent,Const(Movement.YAccel) * 15 ** 2 * (15 / 14)))

[State 9901, CalcEnemyLoc_15Y]
Type = VarSet
Trigger1 = Time > 0
fvar(15) = fvar(15) + ((Enemy(var(30)),Pos Y + Enemy(var(30)),Vel Y * 15) + (0.5 * Enemy(var(30)),Const(Movement.YAccel) * 15 ** 2 * (15 / 14)))

[State 9901, CalcEnemyLoc_basing]
Type = VarSet
Trigger1 = Parent,StateType != A
Trigger1 = fvar(11) > 0
fvar(11) = 0

[State 9901, CalcEnemyLoc_basing]
Type = VarSet
Trigger1 = Parent,StateType != A
Trigger1 = fvar(13) > 0
fvar(13) = 0

[State 9901, CalcEnemyLoc_basing]
Type = VarSet
Trigger1 = Parent,StateType != A
Trigger1 = fvar(15) > 0
fvar(15) = 0

