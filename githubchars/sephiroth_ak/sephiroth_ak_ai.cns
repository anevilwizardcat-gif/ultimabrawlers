;AI補助ヘルパー生成
[State -3, CreateHelper]
Type = Helper
TriggerAll = var(59) = 1
Trigger1 = RoundState = 2
Trigger1 = NumHelper(1) = 0
HelperType = Normal
Name = "AIHelper"
ID = 1
Pos = 0, 0
PosType = p1
Facing = 1
StateNo = 9901
KeyCtrl = 0
OwnPal = 1


;AI停止
[State -3, AI]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = RoundState >= 3
var(59) = 2

;AI再開
[State -3, AI]
Type = VarSet
TriggerAll = var(59) = 2
Trigger1 = RoundState = 2
var(59) = 1

;初期化
[State -3, Initialize]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = 1
var(57) = 0

[State -3, Initialize]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = 1
var(58) = 0

[State -3, CancelableFlag1]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = 1
var(1) = 0

[State -3, CancelableFlag2]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = Ctrl = 1
Trigger2 = StateNo < 2000
Trigger2 = MoveContact > 0
Trigger2 = MoveContact <= 10
var(1) = 1

[State -3, CancelableFlag3_SuperCancel]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = (var(10) = 1) || (var(10) = 9)
Trigger1 = StateNo = [2000, 2999]
Trigger1 = StateNo != [2050, 2051]
Trigger1 = MoveContact = [1, 10]
var(1) = 2

[State -3, CancelableFlag4_GuardCancel]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = (var(10) = 2) || (var(10) = 9)
Trigger1 = StateNo = [150, 155]
Trigger1 = var(44) > 0
var(1) = 3

[State -3, CancelableFlag5_HyperCancel]
Type = VarSet
TriggerAll = var(59) = 1
TriggerAll = var(10) = 9
Trigger1 = (StateNo = [3000, 3999]) | (StateNo = 2051)
Trigger1 = MoveContact = [1, 10]
Trigger2 = StateNo = 2050
Trigger2 = AnimElemTime(10) > 0
Trigger3 = StateNo = [3002, 3003]
var(1) = 4

[State -3, JudgeTarget]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = (P2StateType != L)
var(57) = 2

[State -3, JudgeTarget]
Type = VarSet
TriggerAll = var(59) = 1
Trigger1 = var(57) = 2
Trigger1 = NumHelper(1) > 0
Trigger1 = Enemy(Helper(1),var(30)),HitFall != 1
var(57) = 1

[State -3, Temporary]
Type = VarSet
Trigger1 = NumHelper(1) > 0
fvar(11) = Random % (100 - Helper(1),var(21) + 1) / 100.0  ;fvar(11) : 0～1.0

;AIの不正確レベルにより、敵との距離を誤認させる
[State -3, Temporary P2Dist X]
Type = VarSet
Trigger1 = NumHelper(1) > 0
fvar(3) = (P2Dist X * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))

;AIの不正確レベルにより、敵との距離を誤認させる
[State -3, Temporary P2Dist Y]
Type = VarSet
Trigger1 = NumHelper(1) > 0
fvar(4) = (P2Dist Y * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))

;AIの攻撃性レベル
[State -3, Temporary Aggressive Level]
Type = VarSet
Trigger1 = NumHelper(1) > 0
fvar(14) = Helper(1),var(22) / 100.0

;AIのコンボ正確性レベル
[State -3, Temporary Combo Accuracy Level]
Type = VarSet
Trigger1 = NumHelper(1) > 0
fvar(15) = Helper(1),var(23) / 100.0

;AIの牽制率レベル
[State -3, Temporary Combo Accuracy Level]
Type = VarSet
Trigger1 = NumHelper(1) > 0
fvar(16) = Helper(1),var(24) / 100.0

;AIの牽制抑制
[State -3, Temporary Combo Accuracy Level]
Type = VarSet
Trigger1 = NumHelper(1) > 0
Trigger1 = Helper(1),var(24) > 0
Trigger1 = (GameTime % (100 / Helper(1),var(24)) / 2) > 0
fvar(16) = 0

;▼間合い調整
[State -3, Forward]
Type = VarSet
var(58) = 22
TriggerAll = var(59) = 1
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
TriggerAll = !((StateNo = 100) && (Time < 12))
Trigger1 = Ctrl = 1
Trigger1 = P2BodyDist X > (160 * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))

[State -3, Back]
Type = VarSet
var(58) = 23
TriggerAll = var(59) = 1
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
Trigger1 = Ctrl = 1
Trigger1 = P2BodyDist X < (80 * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))
Trigger1 = BackEdgeDist > 10
Trigger1 = P2MoveType != H  ;相手がのけぞり中は退かぬ

[State -3, Run]
Type = VarSet
var(58) = 100
TriggerAll = var(59) = 1
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
Trigger1 = Ctrl = 1
Trigger1 = P2BodyDist X > (200 * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))
Trigger1 = (Random % 100) < 20

[State -3, Run-Continue]
Type = VarSet
var(58) = 100
TriggerAll = var(59) = 1
Trigger1 = StateNo = 100
Trigger1 = P2BodyDist X > (150 * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))

[State -3, Run-Stop]
Type = VarSet
var(58) = IfElse((Random % 100) < 10, 0, 100)
TriggerAll = var(59) = 1
Trigger1 = (StateNo = 100) && (Time >= 6)
Trigger1 = P2BodyDist X > (120 * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))

[State -3, BackStep]
Type = VarSet
var(58) = 105
TriggerAll = var(59) = 1
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
TriggerAll = Ctrl = 1
TriggerAll = P2BodyDist X < (50 * (1.0 + 0.4 * fvar(11) * IfElse((Random % 100) = 0, -1, 1)))
TriggerAll = BackEdgeDist > 30
Trigger1 = P2MoveType != H  ;相手がのけぞり中は退かぬ
Trigger1 = (Random % 100) < 20
Trigger2 = P2StateType = L  ;ただし相手が倒れてるなら近づきすぎは禁物
Trigger2 = (Random % 100) < 40


;▼マテリア
[State -3, Materia_Initialize]
Type = VarSet
Trigger1 = Ctrl = 1
var(55) = 0

[State -3, Materia_Armor]
Type = null;VarSet
var(55) = 4
TriggerAll = var(59) = 1
TriggerAll = var(10) != 4
TriggerAll = var(55) = 0
TriggerAll = var(17) <= 0
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
TriggerAll = var(57) = 1
TriggerAll = Ctrl = 1
TriggerAll = (var(10) = 0) || ((GameTime % 120) = 0)
TriggerAll = (fvar(3) = [60, 320]) || ((P2MoveType = H) && (fvar(3) = [40, 320]))
;▽HPが十分にある時
Trigger1 = Life >= 500
Trigger1 = (Random % 100) < 10
;▽その他
Trigger2 = (Random % 100) < 5

[State -3, Materia_Escape]
Type = null;VarSet
var(55) = 5
TriggerAll = var(59) = 1
TriggerAll = var(10) != 5
TriggerAll = var(55) = 0
TriggerAll = var(17) <= 0
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
TriggerAll = var(57) = 1
TriggerAll = Ctrl = 1
TriggerAll = (var(10) = 0) || ((GameTime % 120) = 0)
TriggerAll = (fvar(3) = [60, 320]) || ((P2MoveType = H) && (fvar(3) = [40, 320]))
;▽HPが低い時
Trigger1 = Life < 250
Trigger1 = (Random % 100) < 30
;▽その他
Trigger2 = (Random % 100) < 10

[State -3, Materia_Attack]
Type = VarSet
var(55) = 1
TriggerAll = var(59) = 1
TriggerAll = var(10) != 1
TriggerAll = var(10) != 9
TriggerAll = var(55) = 0
TriggerAll = var(17) <= 0
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
TriggerAll = var(57) = 1
TriggerAll = Ctrl = 1
TriggerAll = (var(10) = 0) || ((GameTime % 120) = 0)
TriggerAll = (fvar(3) = [60, 320]) || ((P2MoveType = H) && (fvar(3) = [40, 320]))
;▽ゲージが溜まってる時
Trigger1 = Power >= 1500
Trigger1 = (Random % 100) < (50.0 * (Life / Const(Data.Life)))
;▽HPが優位な時
Trigger2 = NumHelper(1) > 0
Trigger2 = (Life - Enemy(Helper(1),var(30)),Life) >= 150
Trigger2 = (Random % 100) < (50.0 * (Life / Const(Data.Life)))
;▽その他
Trigger3 = (Random % 100) < 100

[State -3, Materia_Defence]
Type = VarSet
var(55) = 2
TriggerAll = var(59) = 1
TriggerAll = var(10) != 2
TriggerAll = var(10) != 9
TriggerAll = var(55) = 0
TriggerAll = var(17) <= 0
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
TriggerAll = var(57) = 1
TriggerAll = Ctrl = 1
TriggerAll = (var(10) = 0) || ((GameTime % 120) = 0)
TriggerAll = (fvar(3) = [60, 320]) || ((P2MoveType = H) && (fvar(3) = [40, 320]))
;▽ゲージがない時
Trigger1 = Power < 1000
Trigger1 = (Random % 100) < 20
;▽HPが劣位な時
Trigger2 = NumHelper(1) > 0
Trigger2 = ((Life - Enemy(Helper(1),var(30)),Life) <= 150) || ((Life / Const(Data.Life)) < 0.4)
Trigger2 = (Random % 100) < 30
;▽HPが劣位な時２
Trigger3 = NumHelper(1) > 0
Trigger3 = ((Life - Enemy(Helper(1),var(30)),Life) <= 300) || ((Life / Const(Data.Life)) < 0.2)
Trigger3 = (Random % 100) < 70
;▽メテオ待ち
Trigger4 = NumHelper(3360) > 0
Trigger4 = (Random % 100) < 20
;▽その他
Trigger5 = (Random % 100) < 10

[State -3, Materia_Regene]
Type = null;VarSet
var(55) = 3
TriggerAll = var(59) = 1
TriggerAll = var(10) != 3
TriggerAll = var(55) = 0
TriggerAll = var(17) <= 0
TriggerAll = StateType != A
TriggerAll = Pos Y = 0
TriggerAll = var(57) = 1
TriggerAll = Ctrl = 1
TriggerAll = (var(10) = 0) || ((GameTime % 120) = 0)
TriggerAll = (fvar(3) = [60, 320]) || ((P2MoveType = H) && (fvar(3) = [40, 320]))
;▽HPが減っている時
Trigger1 = Life < 800
Trigger1 = (Random % 100) < 25

[State -3, Materia]
Type = VarSet
TriggerAll = Ctrl = 1
Trigger1 = var(55) > 0
var(58) = 2900

[State -3, Materia_Escape_Invoke]
Type = VarSet
var(58) = 3600
TriggerAll = var(59) = 1
TriggerAll = var(10) = 9
TriggerAll = var(17) <= 0
;▽ダメージ時
Trigger1 = P2MoveType = A
Trigger1 = (StateNo = [5000, 5170]) && (Time = 1)
Trigger1 = (Random % 100) < 80
;▽ガード時
Trigger2 = P2MoveType = A
Trigger2 = (StateNo = [120, 159]) && (Time = 1)
Trigger2 = (GetHitVar(HitShakeTime) + GetHitVar(HitTime)) >= 20  ;比較的長めの硬直
Trigger2 = (Random % 100) < 20


