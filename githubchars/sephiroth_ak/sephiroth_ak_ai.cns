Type = VarSet
TriggerAll = var(31) = 0
Trigger1 = var(10) = [120, 155]
Trigger1 = Parent,StateNo != [120, 155]
Trigger1 = Parent,StateType = C
Trigger1 = Parent,MoveType = H
var(31) = Parent,P2StateNo

[State 9901, Memory_MiddleAttack2]
