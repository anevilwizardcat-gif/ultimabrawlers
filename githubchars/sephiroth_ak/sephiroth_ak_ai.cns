;▼AI補助ヘルパー
;var(1) 1でProjectile検知、2でHelper検知、3でHelper検知判定中
;var(2) 前回の位置記憶カウント
;var(3) 到着までのおおよそのカウント
;var(4) 連続検知カウント
;var(5) 飛び道具のおおよその幅（GuardDistの幅）
;var(10) 直前の親のStateNo
;var(20) ぶっぱ率（0でなし、100で多め）
;var(21) レンジ正確性（0で適当、100で正確）
;var(22) 攻撃性
;var(23) コンボ正確性（0で適当、100で正確）
;var(24) 牽制率（0でなし、100で多め）
;var(25) 初段ジャストガード率（0でなし、100で確実）
;var(26) 連続ジャストガード率（0でなし、100で確実）
;var(27) ガードキャンセル率（0でなし、100で高確率）
;var(28) 永久ループ使用設定[マスターのみ] 0:なし 1:劣勢時のみ 2:常時
;var(30) 近い相手のID(0 or 1) Enemy(*)で使用
;var(31-33) 中段攻撃記憶用
;var(50) ループ制御
;var(51) 1ループでの判定範囲
;var(52) ループ制御（後ろ方向）
;fvar(1) 飛び道具の大まかなX方向の距離
;fvar(2) 前回の記憶位置(X)
;fvar(3) 飛び道具の大まかな速度(X)
;fvar(4) 飛び道具の平均速度(X)
;fvar(10) 相手の位置予測(5F後 X)
;fvar(11) 相手の位置予測(5F後 Y)
;fvar(12) 相手の位置予測(10F後 X)
;fvar(13) 相手の位置予測(10F後 Y)
;fvar(14) 相手の位置予測(15F後 X)
;fvar(15) 相手の位置予測(15F後 Y)
[Statedef 9900]
Type = A
MoveType = I
Physics = N
Juggle = 0
Ctrl = 0
Anim = 9900
PowerAdd = 0

[State 9900, NoShadow]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow

[State 9900, 1]
Type = NotHitBy
Trigger1 = Time >= 0
Value = SCA
Time = 99

[State 9900, Pos]
Type = PosSet
Trigger1 = 1
X = Parent,Pos X + ((var(52) - var(50)) * var(51) * Parent,Facing)  ;自分の後ろから前へ少しずつ移動しながら判定を繰り返す
Y = Parent,Pos Y

;▽Projectile検知
[State 9900, DetectProjectile]
Type = VarSet
TriggerAll = Enemy(var(30)),NumProj > 0
Trigger1 = InGuardDist
var(1) = 1

[State 9900, GetDist]
Type = VarSet
TriggerAll = Enemy(var(30)),NumProj > 0
Trigger1 = InGuardDist
fvar(1) = (var(52) - var(50)) * var(51)

;▽Helper検知
[State 9900, DetectHelper]
Type = VarSet
TriggerAll = InGuardDist
TriggerAll = var(1) != 1
Trigger1 = (Enemy(var(30)),HitDefAttr = SCA, NA, SA, HA) = 0
var(1) = 2

[State 9900, GetDist]
Type = VarSet
TriggerAll = InGuardDist
TriggerAll = var(1) != 1
Trigger1 = (Enemy(var(30)),HitDefAttr = SCA, NA, SA, HA) = 0
fvar(1) = (var(52) - var(50)) * var(51)

[State 9900, DetectHelper]
Type = VarSet
Trigger1 = var(1) = 2
Trigger1 = var(4) < 3
var(1) = 3  ;連続検知フレームが3F未満ならHelper判定を先送りにする（本体の攻撃による誤検知を防ぐため）

[State 9900, DetectWidth_Near]
Type = VarSet
Trigger1 = var(1) > 0
Trigger1 = var(5) = 0
var(5) = Floor(fvar(1))  ;最初に検知した場所を記憶する

[State 9900, Loop]
Type = VarAdd
Trigger1 = var(50) > -var(52)
var(50) = -1

[State 9900, Loop]
Type = ChangeState
Trigger1 = var(50) > -var(52)
Value = 9900

;↑ここまでループ

[State 9900, Reset]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = var(1) = 0
var(2) = 0

[State 9900, Reset]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = var(1) = 0
fvar(2) = 0

[State 9900, Reset]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = var(1) = 0
fvar(4) = 0

[State 9900, DetectWidth]
Type = VarSet
Trigger1 = var(1) != 0
var(5) = Floor(fvar(1) - var(5))

[State 9900, GetSpeed]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = var(1) != 0
Trigger1 = fvar(1) != fvar(2)  ;前回の位置と違う
fvar(3) = (fvar(2) - fvar(1)) / (GameTime - var(2))

[State 9900, GetSpeed]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = var(1) != 0
Trigger1 = fvar(1) != fvar(2)  ;前回の位置と違う
fvar(4) = IfElse(fvar(4) <= 0, fvar(3), (fvar(3) + fvar(4)) / 2.0)  ;前回の速度との平均を取る

[State 9900, Helper?]
Type = VarSet
TriggerAll = var(1) = 2
TriggerAll = Enemy(var(30)),Vel X != 0
TriggerAll = Enemy(var(30)),StateNo >= 200  ;基本ステートの場合は無視
Trigger1 = Abs(fvar(4) / Enemy(var(30)),Vel X) = [0.8, 1.2]  ;攻撃判定と敵がほぼ同速なら飛び道具ではないと判定
var(1) = -1

[State 9900, Helper?]
Type = VarSet
Trigger1 = var(1) = 2
Trigger1 = fvar(4) < 0.1  ;攻撃判定が動いていないなら飛び道具ではないと判定
var(1) = -1

[State 9900, NoMove?]
Type = VarSet
Trigger1 = var(1) != 0
Trigger1 = fvar(1) = fvar(2)
Trigger1 = GameTime - var(2) >= 10  ;10F以上動いていないようなら飛び道具ではないと判定
var(1) = -1

[State 9900, Helper?]
Type = null;VarSet
Trigger1 = var(1) = 2
Trigger1 = Abs((fvar(1) + var(5)) - P2Dist X) < 50  ;攻撃判定が相手に近すぎるなら飛び道具ではないと判定
var(1) = -1

[State 9900, CountToReach]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = fvar(1) != 0
Trigger1 = fvar(4) > 0
var(3) = Floor(fvar(1) / fvar(4))  ;*0.8はGuardDistがかなり長めに設定されていることを想定

[State 9900, Initialize]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = fvar(1) != 0
Trigger1 = fvar(1) != fvar(2)
var(2) = GameTime

[State 9900, Initialize]
Type = VarSet
Trigger1 = var(50) <= 0
Trigger1 = fvar(1) != 0
Trigger1 = fvar(1) != fvar(2)
fvar(2) = fvar(1)

[State 9900, Sequential]
Type = VarAdd
Trigger1 = var(1) > 0
var(4) = 1

[State 9900, Finish]
Type = ChangeState
Trigger1 = var(50) <= 0
Value = 9901


[Statedef 9901]
Type = A
MoveType = I
Physics = N
Juggle = 0
Ctrl = 0
Anim = 9900
PowerAdd = 0

[State 9901, Sudden Level]
