;AI行動記述ファイル

;溜め技など一部の行動は他のcnsファイルに記述していることがあります。
;var(59)で検索すればヒットするはず。
;また、設定可能な箇所には★をつけてあるので検索してお好みにどうぞ。


;▼AI用前進
[Statedef 22]
Type = S
MoveType = I
Physics = S
Juggle = 0
VelSet = Const(Velocity.Walk.Fwd.X), 0
Ctrl = 1
PowerAdd = 0

[State 22, Anim]
Type = ChangeAnim
Trigger1 = Anim != 20
Value = 20

[State 22, Loop]
Type = ChangeAnim
Trigger1 = AnimTime = 0
Value = 20

;▼AI用後退
[Statedef 23]
Type = S
MoveType = I
Physics = S
Juggle = 0
VelSet = Const(Velocity.Walk.Back.X), 0
Ctrl = 1
PowerAdd = 0

[State 23, Anim]
Type = ChangeAnim
Trigger1 = Anim != 21
Value = 21

[State 23, Loop]
Type = ChangeAnim
Trigger1 = AnimTime = 0
Value = 21

;-----------------

[Statedef -3]

;★常時AIスイッチ
[State -3, AI_Switch]
Type = VarSet
Trigger1 = var(59) <= 0
var(59) = 0  ;★ここを1にすると常時AI起動

[State -3, JudgeState]  ;-1にもあるけど、AI用にここでも定義
Type = VarSet
Trigger1 = 1
var(3) = GameTime  ;以降、var(3) != GameTime ならステートを奪われている

[State -3, Start_AI]
Type = VarSet
TriggerAll = var(59) = 0
TriggerAll = RoundState = [1,2]
Trigger1 = Command = "AI_0"
Trigger2 = Command = "AI_1"
Trigger3 = Command = "AI_2"
Trigger4 = Command = "AI_3"
Trigger5 = Command = "AI_4"
var(59) = 1

