;---------------------------------------------------------------------------
;=====================================================
;■■常時判定ステート■■

;▼
[Statedef -2]

[State -2, MasterMateria]
Type = VarSet
Trigger1 = var(10) != 9
Trigger1 = PalNo >= 7
var(10) = 9

;▽マテリア関係
[State -2, MateriaHelper]
Type = Helper
Trigger1 = NumHelper(2910) < 1
Trigger1 = RoundState = 2
IgnoreHitPause = 1
Persistent = 0
HelperType = Normal
Name = "MateriaManager"
ID = 2910
Pos = 8, -10
PosType = left
Facing = 1
StateNo = 2910
KeyCtrl = 0
OwnPal = 1
SuperMoveTime = 0
PauseMoveTime = 0

[State -2, AttackReset]
Type = AttackMulSet
Trigger1 = 1
Value = 1.0

[State -2, DefenceReset]
Type = DefenceMulSet
Trigger1 = 1
Value = 1.0

[State -2, Materia_Attack]
Type = AttackMulSet
Trigger1 = var(10) = 1
Trigger2 = var(10) = 9
Value = 1.2

[State -2, Materia_Attack]
Type = DefenceMulSet
Trigger1 = var(10) = 1
Value = 1.1

[State -2, Materia_Defence]
Type = AttackMulSet
Trigger1 = var(10) = 2
Value = 0.9

[State -2, Materia_Defence]
Type = DefenceMulSet
Trigger1 = var(10) = 2
Trigger2 = var(10) = 9
Value = 0.8

[State -2, Materia_Regenerate]
Type = LifeAdd
TriggerAll = Life > 0
Trigger1 = var(10) = 3
Trigger1 = (GameTime % 60) = 0
Trigger2 = var(10) = 9
Trigger2 = (GameTime % 60) = 0
Value = 6

[State -2, Materia_MpRegenerate]
Type = PowerAdd
TriggerAll = Life > 0
Trigger1 = var(10) = 9
Trigger1 = (GameTime % 12) = 0
Value = 15

[State -2, Materia_Armor]
Type = VarSet
TriggerAll = StateNo != 8700
Trigger1 = 1
var(18) = StateNo

[State -2, Materia_Armor]
Type = VarSet
TriggerAll = StateNo != 8700
Trigger1 = 1
var(19) = AnimElemNo(0)

▽ヒットエフェクト関係
[State -2, InitializeHitEffectSize]
Type = VarSet
Trigger1 = var(3) = 0
Trigger1 = RoundState = 2
fvar(20) = (fvar(21) := 1.0)

[State -2, HitEffectHelper]
Type = VarSet
Trigger1 = var(3) = 0
Trigger1 = RoundState = 2
var(3) = 1

▽ダメージ補正
[State -2, DamageCorrect]
Type = VarSet
TriggerAll = var(44) <= 0
Trigger1 = P2MoveType != H
fvar(1) = 1

[State -2, DamageCorrect_UnderLimit]
Type = VarSet
Trigger1 = fvar(1) < 0.1
fvar(1) = 0.1

[State -2, DamageCorrectSuper]
Type = VarSet
Trigger1 = 1
fvar(2) = 1.0 - ((1.0 - fvar(1)) * 0.75)  ;超必はコンボ補正適用率75％

;▽暗転処理
[State -2, SuperDark]
Type = BGPalFX
IgnoreHitPause = 1
Trigger1 = var(16) < 256
Time = 1
Mul = var(16), var(16), var(16)
Color = 256

[State -2, SuperDark]
Type = VarSet
IgnoreHitPause = 1
Trigger1 = var(16) < 256
var(16) = var(16) + 16

[State -2, SuperDark]
Type = VarSet
IgnoreHitPause = 1
Trigger1 = var(16) > 256
var(16) = 256

[State -2, Display]
Type = DisplayToClipboard
Trigger1 = 1
Text = "AI:%d Correct:%f S_Correct:%f  Life:%d"
Params = var(59), fvar(1), fvar(2), var(46)
IgnoreHitPause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

[State -2, Display]
Type = null;AppendToClipboard
Trigger1 = 1
Trigger1 = NumHelper(1) > 0
Text = "  EnemyID:%d  5X:%f  5Y:%f  hitdef:%d"
Params = Enemy(Helper(1),var(30)),ID, Helper(1),fvar(10), Helper(1),fvar(11), Enemy(var(30)),HitDefAttr != SCA, NA, SA, HA
IgnoreHitPause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

[State -2, Display]
Type = AppendToClipboard
Trigger1 = 1
Trigger1 = NumHelper(1) > 0
Text = "  flag:%d  dist:%f  speed:%f  reach:%d  width:%d"
Params = Helper(1),var(1), Helper(1),fvar(1), Helper(1),fvar(4), Helper(1),var(3), Helper(1),var(5)
IgnoreHitPause = 1
SuperMoveTime = 9999
PauseMoveTime = 9999

[State -2, ReverseDirection]
Type = Turn
Trigger1 = P2Dist X < 0
Trigger1 = StateType != A
Trigger1 = StateNo != 100
Trigger1 = Ctrl = 1


;▽ジャストガード関連
[State -2, JustGuard]
Type = PalFX
IgnoreHitPause = 1
Trigger1 = var(44) = 100
Time = 6
Add = 0, 0, 128
Mul = 200, 200, 200
Color = 256

[State -2, JustGuard_Gauge]
Type = PowerAdd
IgnoreHitPause = 1
Trigger1 = var(44) = 100
Trigger1 = PrevStateNo != [150, 155]  ;単発ガード
Value = IfElse(var(10) = 2, 80, IfElse(var(10) = 1, 15, 30))

[State -2, JustGuard_Gauge]
Type = PowerAdd
IgnoreHitPause = 1
Trigger1 = var(44) = 100
Trigger1 = PrevStateNo = [150, 155]  ;連続ガード
Value = IfElse(var(10) = 2, 20, IfElse(var(10) = 1, 5, 10))

[State -2, JustGuard_Recover]
Type = LifeAdd
IgnoreHitPause = 1
TriggerAll = (var(10) = 2) || (var(10) = 9)
Trigger1 = var(44) = 100
Trigger1 = PrevStateNo != [150, 155]  ;単発ガード
Value = 10

[State -2, JustGuard_Recover]
Type = LifeAdd
IgnoreHitPause = 1
TriggerAll = (var(10) = 2) || (var(10) = 9)
Trigger1 = var(44) = 100
Trigger1 = PrevStateNo = [150, 155]  ;連続ガード
Value = 3

[State -2, JustGuard]
Type = Pause
IgnoreHitPause = 1
Trigger1 = var(44) = 100
Time = 3
MoveTime = 0

[State -2, JustGuard_Start]
Type = VarSet
IgnoreHitPause = 1
Trigger1 = var(44) = 100
var(44) = 24

[State -2, JustGuard_Decrease]
Type = VarAdd
IgnoreHitPause = 1
Trigger1 = var(44) > 0
Trigger1 = StateNo = [120, 155]
var(44) = -1

[State -2, JustGuard_Off]
Type = VarSet
IgnoreHitPause = 1
TriggerAll = var(44) > 0
Trigger1 = Ctrl = 1
var(44) = 0


;▽ヒットスパーク

[State -2, HitSpark1]  ;相手1P用
Type = Explod
IgnoreHitPause = 1
TriggerAll = var(50) > 0
TriggerAll = NumEnemy > 0
TriggerAll = Enemy(0),Time = 0
TriggerAll = Enemy(0),StateNo = 5000 || Enemy(0),StateNo = 5010 || Enemy(0),StateNo = 5020 || Enemy(0),StateNo = 5070 || Enemy(0),StateNo = 5080
TriggerAll = Enemy(0),StateNo != [120, 155]
Trigger1 = MoveContact = 1
Trigger2 = Enemy(0),Movetype = H
Trigger3 = (((Enemy(0),StateNo != [5000, 5199])) && (Enemy(0),Movetype = H))
Anim = var(50)
PosType = Left
Pos = Ceil(Enemy(0),ScreenPos X) + var(51), Ceil(IfElse(var(49) = 0, ScreenPos Y, Enemy(0),ScreenPos Y)) + var(52)
Random = 0, 0
Facing = Facing * IfElse(var(54) = 0, 1, -1)
VFacing = IfElse(var(53) = 0, 1, -1)
Scale = Const(Size.XScale) * fvar(20), Const(Size.YScale) * fvar(21)
OnTop = 1
RemoveTime = -2
OwnPal = 1
BindTime = 1
PauseMoveTime = 9999
SuperMoveTime = 9999

[State -2, HitSpark2]  ;相手2P用
Type = Explod
IgnoreHitPause = 1
TriggerAll = var(50) > 0
TriggerAll = NumEnemy > 1
TriggerAll = Enemy(1),Time = 0
TriggerAll = Enemy(1),StateNo = 5000 || Enemy(1),StateNo = 5010 || Enemy(1),StateNo = 5020 || Enemy(1),StateNo = 5070 || Enemy(1),StateNo = 5080
TriggerAll = Enemy(1),StateNo != [120, 155]
Trigger1 = MoveContact = 1
Trigger2 = Enemy(1),Movetype = H
Trigger3 = (((Enemy(1),StateNo != [5000, 5199])) && (Enemy(1),Movetype = H))
Anim = var(50)
PosType = Left
Pos = Ceil(Enemy(1),ScreenPos X) + var(51), Ceil(IfElse(var(49) = 0, ScreenPos Y, Enemy(1),ScreenPos Y)) + var(52)
Random = 0, 0
Facing = Facing * IfElse(var(54) = 0, 1, -1)
VFacing = IfElse(var(53) = 0, 1, -1)
Scale = Const(Size.XScale) * fvar(20), Const(Size.YScale) * fvar(21)
OnTop = 1
RemoveTime = -2
OwnPal = 1
BindTime = 1
PauseMoveTime = 9999
SuperMoveTime = 9999

;---------------------------------------------------------------------------
;立ち
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, HelperFailSafe]
Type = DestroySelf
Trigger1 = IsHelper = 1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;▼着地
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, RemoveExplod]
Type = RemoveExplod
Trigger1 = Time = 0
ID = 999

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;▼ジャンプ
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = (var(59) = 0) && (command = "holdfwd")
trigger2 = (var(59) = 1) && (var(58) = 42)
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = (var(59) = 0) && (command = "holdback")
trigger2 = (var(59) = 1) && (var(58) = 43)
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevStateNo = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;▼ダッシュ
[Statedef 100]
type    = S
physics = S
;anim = 100
sprpriority = 1

[State 100, ChangeAnim]
Type = ChangeAnim
Trigger1 = Anim != 100
Value = 100

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, Ctrl]  ;走り始めは一瞬操作不能
Type = CtrlSet
Trigger1 = 1
Value = IfElse(Time < 3, 0, 1)

[State 100, 4]
type = ChangeState
trigger1 = (command != "holdfwd") && (Ctrl = 1) && (var(59) = 0)
trigger2 = (var(59) = 1) && (Ctrl = 1) && (var(58) != 100)
value = 0


;▼バックステップ
[Statedef 105]
Type = A
Physics = A
Ctrl = 0
Anim = 105

[State 105, Move]
Type = VelSet
Trigger1 = Time = 0
X = const(velocity.run.back.x)
Y = const(velocity.run.back.y)

[State 105, NotHitBy]
Type = NotHitBy
Trigger1 = Time < 15
Value = SCA
time = 1

[State 105, Landing]
Type = PosSet
Trigger1 = Pos Y >= 0
Trigger1 = Time > 0
Y = 0

[State 105, Finish]
Type = ChangeState
Trigger1 = Pos Y >= 0
Trigger1 = Time > 0
Value = 0
Ctrl = 1

;---------------------------------------------------------------------------
; RUN_UP
[Statedef 110]
type    = S
physics = N

[State 110, 0]
type = CtrlSet
trigger1 = Time = 0
value = 0

[State 110, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 110

[State 110, 2]
type = HitBy
trigger1 = Time = 0
value = SCA, NT, ST, HT
time = 30

[State 110, 3]
type = VelSet
trigger1 = Time = 0
x = 0
z = -7

[State 110, 4]
type = VelMul
trigger1 = 1
z = 0.8

[State 110, 5]
type = VelSet
trigger1 = AnimTime = -8
z = 0

[State 110, 7]
type = CtrlSet
trigger1 = AnimTime = 0
value = 1

[State 110, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

