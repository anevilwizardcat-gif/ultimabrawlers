;▼立ちガード中
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State 150, JustGuard]
Type = VarSet
IgnoreHitPause = 1
Persistent = 0
TriggerAll = Anim < 1000
Trigger1 = Time = 0
Trigger1 = var(43) = [1, 12]
var(44) = 100  ;とりあえず100にして、実際の持続Fは-2ステートで調整

[State 150, JustGuard_ResetInput]
Type = VarSet
IgnoreHitPause = 1
Trigger1 = var(44) = 100
var(43) = 60  ;後ろ入力F数に加算して、このまま押しっぱなしでは連続成立しないようにする

[State 150, JustGuard_IgnoreDamage]
Type = StateTypeSet
IgnoreHitPause = 1
Trigger1 = var(44) = 100
MoveType = I  ;JG成立時、1FだけMoveTypeを変更してダメージを無効化する

[State 150, JustGuard_IgnoreDamage_Reset]
Type = StateTypeSet
IgnoreHitPause = 1
Trigger1 = MoveType = I
Trigger1 = var(44) != 100
MoveType = H

[State 150, Senkou]
type = ChangeState
triggerall = anim = 2400
trigger1 = AnimTime = 0
value = 2402

[State 150, Shin_Senkou]
type = ChangeState
triggerall = anim = 3404
trigger1 = AnimTime = 0
Trigger2 = HitShakeOver = 1
value = 3401

[State 150, Shin_Senkou_Crouch]
Type = HitOverride
TriggerAll = Anim = 3404
Trigger1 = 1
Attr = C, AA, AP
