trigger1 = Time = 50
value = S100, ifelse(root,Var(4)=0,66,67)
Volumescale = 100

[State 7010, VOICE NEW]
type = PlaySnd
trigger1 = root,var(25) = 0
trigger1 = Time = 50
value = S100, ifelse(root,Var(4)=0,25,26)
Volumescale = 100

[State 300, MUSIC_OLD] 
