trigger1 = 1
value = 20 

[State 6, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 1007, Finish big]
type = AngleDraw
;triggerall = root,var(25) = 0
trigger1 = time =0
value = 0
scale = 0,0

[State 1007, Finish big]
type = AngleDraw
;triggerall = root,var(25) = 0
trigger1 = time >0
trigger1 = time <50
value = 0
scale = IfElse(Time >0,0+(Time*0.02),0.5), IfElse(Time >0,0+(Time*0.02),0.5)

[State 1007, Finish big]
type = AngleDraw
;triggerall = root,var(25) = 0
trigger1 = time >=50
trigger1 = time <=150
value = 0
scale = 1,1

[State 5, 0]
type = AngleDraw
triggerall = root,var(25) = 0
trigger1 = time >150
value = 0
scale = FVar(14) * Const(size.xscale), FVar(14) * Const(size.yscale)

[State -2, VarAdd]
type = Varset
trigger1 = Time = 150
ignorehitpause = 1
fv = 14
value = 1

[State -2, VarAdd]
type = Varadd
trigger1 = Time > 150
ignorehitpause = 1
fv = 14
value = -0.02

[State -2, VarAdd]
type = Varadd
trigger1 = Time >= 200
ignorehitpause = 1
fv = 14
value = 0

[State 1007, Finish big]
type = AngleDraw
triggerall = root,var(25) = 0
trigger1 = time >200
value = 0
scale = 0,0

[State 300, 5]
type = DestroySelf
trigger1 = animtime = 0







