;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3,Display]
type = DisplayToClipboard
trigger1 = var(10) >= 1
text = "Var(10)=%d, var 10 activada,Pox y = %f%%"
params = var(10),p2dist y
[State -3,Display.de.Tela]
type = DisplayToClipboard
trigger1 = var(10) <= 0
text = "Var(10)=%d, var 10 desactivada,Pox y = %f%%"
params = var(10),p2dist y

