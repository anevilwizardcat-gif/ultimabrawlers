trigger1=!AnimTime
value=56
ctrl =1
;--------------------------------------------------------------------------------
; Super Jump
[Statedef 56]
type = A
physics = A
Anim = 41
velset = 0,-10.4
ctrl = 1

[State 40, Dust]
type = helper
trigger1 = !time
helpertype = normal
stateno = 8100
ID = 8100
name = "Jump Dust"
postype = p1
ownpal = 1

[State 56, PlaySnd]
type = PlaySnd
trigger1 = time = 1
value = S40,1
volume = 255
;channel = 1

[State 56, 1]
type = VelAdd
triggerall = Vel X>= - 2
trigger1 = command = "holdback"
trigger1=Anim!= 43
x = -0.24

[State 56, 2]
type = VelAdd
triggerall = Vel X<= 2.5
trigger1 = command = "holdfwd"
trigger1 =Anim!= 42
x = 0.4

[State 56, 3]
type = VelSet
trigger1 = Anim = 42
trigger1 = Time = [0,5]
x = 5

[State 56, 4]
type = VelSet
trigger1 = Anim = 43
trigger1 = Time = [0,5]
x = -3.88

[State 56, 5]
type = ChangeAnim
trigger1 = sysvar(1) = 1
trigger1 = Time = [0,4]
value=42

[State 56, 6]
type = ChangeAnim
trigger1 = sysvar(1) = -1
trigger1 = Time = [0,4]
value = 43

[state 56, VelAdd]
type = VelAdd
trigger1 = Time > 30
x = 0
y = -.20

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 56, 10]
type = turn
trigger1 = p2dist x < -4

[state 9000, End]
type = ChangeState
trigger1 = Pos Y >= 1
value = 52
ctrl = 0
