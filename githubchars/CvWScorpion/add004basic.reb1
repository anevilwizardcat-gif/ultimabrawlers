postype = left    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 99999999
pausemovetime = 99999999
ignorehitpause = 1

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
