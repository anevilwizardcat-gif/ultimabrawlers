trigger1 = anim = 47 
time = 1
add = 0,0,0

[State -2, チェーンコンボリセット]
type = VarSet
trigger1 = Ctrl
trigger2 = (StateNo = 0) && Ctrl
trigger3 = (StateNo = 11) && Ctrl
trigger4 = (StateNo = 52)
var(8) = 0

[State -2, 強弱リセット]
type = VarSet
triggerall = Ctrl
trigger1 = var(1) >= 1
var(1) = 0

[State -2, GCリセット]
type = VarSet
triggerall = Ctrl
trigger1 = var(4) >= 1 
var(4) = 0

[State -2, 入れっぱ]
type = VarSet
triggerall = !Ctrl
trigger1 = Command = "holdup"
trigger2 = Command = "holddown"
trigger3 = Command = "holdfwd"
trigger4 = Command = "holdback"
var(5) = 1

[State -2, 入れっぱ]
type = VarSet
triggerall = !Ctrl
trigger1 = Command != "holdup"
trigger1 = Command != "holddown"
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
var(5) = 0

[State -2, 投げ記憶]
type = VarSet
trigger1 = (command = "y") || (command = "z")
trigger2 = (command = "b") || (command = "c")
var(13) = ifelse(command="y",1,ifelse(command="b",1,2))

[State -2, 投げ記憶リセット]
type = VarSet
triggerall = var(13)
trigger1 = Ctrl
var(13) = 0

[State -2, フライング防止]
