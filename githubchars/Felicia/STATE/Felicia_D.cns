;成功
[Statedef 701]
type     = U
movetype = A
physics  = N
anim     = 701
ctrl     = 0
poweradd = 60
velset   = 0,0

[State 701, 変数]
type = VarSet
trigger1 = Time = 0
var(29) = 0
IgnoreHitPause = 1
Persistent = 1

[State 701, 変数];投げ抜けフラグ・相手が特定のコマンドを入力した事を記憶
type = VarSet
triggerall = (NumTarget)
triggerall = (var(29) = 0) && (Time = [1,7])
trigger1 = (Target,command = "holdfwd") && (Target,command = "y")
trigger2 = (Target,command = "holdback") && (Target,command = "y")
trigger3 = (Target,command = "holdfwd") && (Target,command = "z")
trigger4 = (Target,command = "holdback") && (Target,command = "z")
var(29) = 1
IgnoreHitPause = 1
Persistent = 1

[State 701, 物理的なキャラの幅]
type = Width
trigger1 = AnimElem = 2
edge = 15,0

[State 701, 反転]
type = Turn
triggerall = var(30) = 1
trigger1 = AnimElem = 2

[State 701, 掴んだ相手のステート変更]
type = TargetState
trigger1 = AnimElem = 2
value = 703

[State 701, 軸位置移動]
type = PosAdd
trigger1 = AnimElem = 2
x = Ifelse(var(30)=1,-15,0)
y = -33

[State 701, 掴んだ相手の位置１]
type = TargetFacing
trigger1 = 1
value = -1

[State 701, 掴んだ相手の位置]
type = TargetBind
trigger1 = 1
pos = 15, 0

[State 701, 掴んだ相手のライフ増減]
type = TargetLifeAdd
trigger1 = AnimElem = 6
trigger2 = AnimElem = 10
value =-ceil(((1*6.67)+((1*6.67)*(Ifelse(var(14)=1,1,fvar(1)))))*const(data.attack)*0.01) ;(1,1)

[State 701, ヴァイタルソース回復量]
type = VarAdd
trigger1 = AnimElem = 6
var(37) = Ceil((9*6.67)*(const(data.attack)*0.01))

[State 701,エフェクト]
type = Explod
trigger1 = AnimElem = 6
trigger2 = AnimElem = 10
anim = 15002
pos = 40, -20
postype = p1
ontop = 1
ownpal = 1

[State 701, 音声]
type = PlaySnd
trigger1 = time = 1
value = 800
channel = -1

[State 701, 音声]
type = PlaySnd
trigger1 = AnimElem = 6
trigger2 = AnimElem = 10
value = 5, 0
channel = -1

[State 701, ステート変更]
type = ChangeState
triggerall = (Time = [1,7])
trigger1 = var(29) = 1
value = 702

[State 701, ステート変更]
type = ChangeState
trigger1 = time = 140
value = 702
ctrl = 1

