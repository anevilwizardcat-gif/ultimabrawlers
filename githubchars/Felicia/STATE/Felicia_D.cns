;通常P投げ
[Statedef 700]
type     = U
movetype = A
physics  = N
juggle   = 0
anim     = 699
ctrl     = 0
poweradd = 9*7
velset   = 0,0
sprpriority = 2

[State 700, ヒット定義（投げ用）];地上
type = HitDef
triggerall = (StateType != A)
trigger1 = Time = 0
attr = S, NT
hitflag = M-
priority = 1, Miss
sparkno = -1
sprpriority = 1
;p1stateno = 701
;p2stateno = 703
guard.dist = 0
fall = 1
ID = Ifelse(var(14)=0,700,Ifelse(var(20)=0,45000,700))

[State 700]
type = TargetDrop
trigger1 = NumTarget(700) >= 2
excludeID = 700
keepone = 1

[State 700]
type = TargetDrop
trigger1 = NumTarget(45000) >= 2
excludeID = 45000
keepone = 1

[State 700, ヴァイタルソース]
type = TargetState
triggerall = NumTarget(45000)
trigger1 = MoveHit = 1
value = 45000
ctrl = 0
ID = 45000
ignorehitpause = 1
persistent = 0

[State 700, 通常]
type = TargetState
triggerall = NumTarget(700)
trigger1 = MoveHit = 1
value = 703
ctrl = 0
ID = 700
ignorehitpause = 1
persistent = 0

[State 700]
type = ChangeState
triggerall = MoveHit = 1
trigger1 = NumTarget(700)
trigger2 = NumTarget(45000)
value = 701

[State 700, ステート変更]
type = ChangeState
trigger1 = Time >= 1
trigger1 = var(21) := 1
value = ifelse(P2BodyDist X<=9,ifelse(var(13)=1,206,211),ifelse(var(13)=1,205,210))
ctrl = 0

