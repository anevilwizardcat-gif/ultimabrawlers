value = 5100

;Pursuit(Enemy)
[statedef 15080]
type = L
physics = N
movetype=H
ctrl = 0
velset = 0,0

[state 5080]
type = DefenceMulSet
trigger1 = !time
value = 1

[state 5080]
type = PosSet
trigger1 = !time
y = 0

[state 5080]
type = SelfState
trigger1 = !time && !gethitvar(yvel)
value = 5080

[state 5080]
type = ChangeAnim
trigger1 = !HitShakeover
value = 5080+(SelfAnimExist(5080+Anim%10))*Anim%10

[state 5080]
type = ChangeAnim
trigger1 = !HitShakeover
value = anim

[state 5080]
type = SelfState
trigger1 = HitShakeOver
value = 5081

