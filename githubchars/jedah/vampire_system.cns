;---------------------------------------------------------------------------
; HITG_SLICE_SHAKE
[Statedef 105508]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 0]
type = ChangeAnim
trigger1 = !Time
trigger1 = GetHitVar(animtype) != [3,5]
value = 5000+(selfanimexist(105508))*100509

[State 5000, 2]
type = ChangeAnim
trigger1 = !Time
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype)

[State 5000, 4]
type = ChangeAnim
trigger1 = Time
value = anim

[State 5000, 5]
type = NotHitBy
trigger1 = selfanimexist(105508)
value = SCA, AA,AT,AP
time = 1

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = !Time
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 105509 ;HITG_SLICE_SLIDE

