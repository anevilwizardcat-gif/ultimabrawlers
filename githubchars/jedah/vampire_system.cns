; HIT_TRIP2 (fall through air)
[Statedef 15071]
type    = A
movetype= H
physics = N

[State 5071, 1]
type = HitVelSet
trigger1 = Time=1
x = 1
y = 1

[State 5071, 2] ;Acceleration
