;Var(0):ランダム用
;Var(1):強弱判定など
;Var(2):方向判定など
;Var(3):FINISH判別
;Var(4):KO時やられ声
;Var(5):モード別ゲージの溜まりやすさ
;Var(6):モード別ゲージの溜まりやすさ（相手用）
;Var(7):攻撃ヒットした瞬間のアニメ判別1
;Var(8):攻撃ヒットした瞬間のアニメ判別2
;var(9):コマンド先行入力
;var(10):自分側のhitpause作成用
;var(11):ジャンプ攻撃再入力用・連打キャンセル判別用
;var(12):ダッシュ中に出したか
;var(13):ヒットしてから何F経ったか
;var(14):フレンドシップ使用回数用
;var(15):Life
;Var(16):ヒット数（コンボ補正用）
;var(17):削りＫＯ判定
;var(18):空中コンボ制限数
;var(19):アドバンシングガード用(強弱)
;Var(20):アドバンシングガード用(回数)
;var(21):アドバンシングガード用(ガード時間)
;var(22):ダークフォース（サントゥアーリオ）残り時間
;var(23):セイヴァー２ダークフォース残り時間
;Var(24):Reversal用コマンド受付
;var(25):投げ抜け可能状態判定
;Var(26):FirstAttack判別
;var(27):Reversal判別
;var(28):ダークフォース中のゲージ残量保持
;var(29):ダークフォース使用不能時間
;var(30):追い打ち攻撃使用不能状態判別
;var(31):投げ技使用不能時間
;var(32):カルマ＝エレガンテ使用回数
;var(33):サントゥ＝アーリオのキャラ色変化ランダム用(1:セイヴァー２、2:EXエディション)
;~~~~インパクトダメージゲージシステム用(相手側)~~~~
;var(34):バットマーク残り本数(その他はヘルパー内)
;var(35):回復可能ダメージ
;var(36):
;var(37):
;var(38):
;var(39):DF中のゲージ設定
;var(40):ヒット音判別（弱・中・強・斬．．．）
;var(41):ヒット属性判別（弱・中・強・必殺技）
;var(42):ヒットスパークＸ座標
;Var(43):ヒットスパークＹ座標
;Var(44):ダメージ判別（削りダメージ用）
;Var(45):
;Var(46):
;Var(47):KOした相手の位置判別
;var(48):ダッシュ攻撃迎撃確率
;var(49):mugen1.0判別
;var(50):相手AI判別
;var(51):ランダム（CPUの動き)
;~~~~インパクトダメージゲージシステム用~~~~
;var(52):削り回復可能ダメージ判別
;var(53):インパクトダメージゲージシステム有無・回復可能ダメージ判別
;var(54):バットマーク残り本数
;var(55):回復可能ダメージ量
;var(56):回復の間隔用
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
;var(57):ゲージのON/OFF判別・音声変更のON/OFF判別
;Var(58):勝ち負け判定(Complese用)
;var(59):モード判別
;fvar(0):
;fVar(1):
;fVar(2):
;fVar(3):
;fvar(4):
;fvar(5):攻撃力補正（相手体力）
;fvar(6):コンボ数によるダメージ補正
;fvar(7):補正後の攻撃力
;fvar(8):ガードされた数
;fvar(9):画面端ヒットバック用（相手のヒットポーズ時間判別）
;fvar(10):画面端ヒットバック用(ground.velocity)
;fvar(11):画面端ヒットバック用(ground.slidetime)
;fvar(12):画面端ヒットバック用(現在の速度取得)
;fvar(13):Dash Command
;fvar(14):22 Command
;fvar(15):ダッシュ攻撃ガードされる頻度判別
;fvar(16):遠距離地上ディオ＝セーガ潰された回数判別
;fvar(17):永久コンボ中判定
;fvar(18):相手の中段技使用回数（使用中か・空中技か）
;fvar(19):相手の中段技使用回数（回数）
;fvar(20):相手の出した技判別(相手が攻撃中か)
;fvar(21):相手の出した技判別(技判別)
;fvar(22):相手の出した技判別(相手が技出していない時間判別)
;fvar(23):相手のジャンプ頻度判別
;fvar(24):自分が攻めている状態か判別
;fvar(25):相手の間合い判別（最大リーチの技判別）
;fvar(26):相手のヘルパー系飛び道具出現時間判別
;fvar(27):相手の飛び道具出現時間判別
;fvar(28):AI反応速度用
;fvar(29):相手の攻撃状態判別用
;fvar(30):状態判定用時間など
;fvar(31):相手が空中にいる時間判別
;fvar(32):相手の隙判別
;fvar(33):状態判定
;fvar(34):リーチの長いキャラ判別
;fvar(35):ガードすべき状況判別
;fvar(36):跳び込みヒット判定
;fvar(37):AILV設定(0:Beginner 1:Advanced 2:Expert)
;fvar(38):AI判定
;fvar(39):システム判別(3:Vampire Savior)
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000          ; 体力ゲージ、上限値（デフォルト：1000）
power = 99000        ; パワーゲージ、デフォルト：1000
attack = 100         ; 攻撃力（％）
defence = 100        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 12    ; ダウン時間
airjuggle = 15       ; 空中コンボ
sparkno = -1          ; 初期ヒットスパーク番号
guard.sparkno = 40   ; 初期ガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー（0:OFF、1:ON）
volume = 255         ; キャラボイスボリューム値
IntPersistIndex = 53 ;次のラウンドに持ち越すVarを決める
FloatPersistIndex = 37;次のラウンドに持ち越すfVarを決める

[Size]
xscale = .833        ; 水平サイズ倍率
yscale = 1.07        ; 垂直サイズ倍率
ground.back = 22     ; キャラ幅（地上、後ろ側）
ground.front = 22    ; キャラ幅（地上、前側）
air.back = 16        ; キャラ幅（空中、後ろ側）
air.front = 16       ; キャラ幅（空中、前側）
z.width = 10         ; キャラ幅（ｚ軸）
height = 60          ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 2,-105    ; 頭部座標
mid.pos = -10,-72    ; 体中心部座標
shadowoffset = 0     ; キャラの影・オフセット値

[Velocity]
walk.fwd  = 3.1      ; 前進速度
walk.back = -2.7     ; 後退速度
run.fwd  = 8.0, -3.0     ; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -7.0,-3.0 ; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-10.8      ; 垂直ジャンプ速度
jump.fwd = 5.0        ; 前方ジャンプ速度
jump.back = -4.0      ; 後方ジャンプ速度

[Movement]
airjump.num = 0        ; 空中ジャンプ回数
;airjump.height = 35   ; 空中ジャンプ最低高度
yaccel = .52           ; キャラ重力加速度
stand.friction = .85   ; 摩擦係数（立ち状態）
crouch.friction = .82  ; 摩擦係数（しゃがみ状態）


;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

;Liquid like Blood
[state 250]
type = PlaySND
trigger1 = AnimElem=38
value = 5,0+((var(57)>=10)||var(59)=2)*100
volume = ifelse(((var(57)>=10)||var(59)=2),-208,255)

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = null;VelSet
triggerall = !fvar(10)&&!fvar(12)
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = ifelse((enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5),fvar(10),0)

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = 1
x = ifelse((enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5),fvar(10),0)

[state 0]
type = ChangeState
trigger1 = var(22)=-1
value = 2050

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = 1
x = ifelse((enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5),fvar(10),0)

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0&&anim!=15990
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0&&anim!=15990
fvalue = 0

;Liquid like Blood
[state 250]
type = PlaySND
trigger1 = (AnimElem=38)&&anim!=15990
value = 5,0+((var(57)>=10)||var(59)=2)*100

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = (roundno = 1||!roundsexisted)&&anim!=15990
value = 190

[State 5900, 3]
type = PosSet
trigger1 = anim=15990
y = 0

[State 5900, 3] ;Intro for round 1
type = SelfState
trigger1 = anim=15990
value = 0

;_/_/_/_/CPU_/_/_/_/
;---------------------------------------------------------------------------
;立ち状態(ＣＰＵ)
[Statedef 3]
type    = S
physics = S
anim = 0
sprpriority = 0
velset = 0,0
ctrl =0

[State 13, 1]
type = ChangeAnim
trigger1 = P2Dist X<0
value = 5

[State 13, 1]
type = Turn
trigger1 = P2Dist X<0

[State 13, 1]
type = ChangeState
trigger1 = roundstate!=2
value = 0
ctrl = 1

[State 13, 1]
type = ChangeState
trigger1 = ((time = [10,16]) && random <100) || ((time = [66,70]) && random <50) || time = 108
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;しゃがみ状態(ＣＰＵ)
[Statedef 13]
anim = 10
sprpriority = 0
velset = 0,0
ctrl =0

[State 13, 1]
type = ChangeAnim
trigger1 = P2Dist X<0
value = 6

[State 13, 1]
type = Turn
trigger1 = P2Dist X<0

[State 13, 1]
type = ChangeAnim
trigger1 = Anim!=11&&AnimTime=0
trigger2 = Statetype=C&&time=0
value = 11

[state 13]
type = Statetypeset
trigger1 = time=0
statetype=C
physics = C

[State 13, 1]
type = ChangeState
trigger1 = roundstate!=2
value = 11
ctrl = 1

;----------------------------------------------------------------------

;-----
;歩き（前）（CPU）
[Statedef 21]
type    = S
physics = N
sprpriority = 0
ctrl = 0

[State 20, 1]
type = VelSet
trigger1 = time>=2
x = const(velocity.walk.fwd.x)

[State 20, 3]
type = ChangeAnim
trigger1 = time=0
value = 20

[State 20, 4]
type = changestate
trigger1 = P2dist x <= 0
value = 0
ctrl = 1

[State 20, 4]
type = changestate
trigger1 = time>=1 && fvar(35)
trigger2 = P2BodyDist X>40 && time>=ifelse(!fvar(37),12,6)
trigger2 = (((P2BodyDist X =[70,80])&&random<500) || (random<200 && P2BodyDist X =[80,120]) || (random<160 && (P2BodyDist X =[120,160])) || (random<70 && P2BodyDist X >160))
trigger3 = P2bodydist X>140 && (enemynear,numproj>0||((enemynear,hitdefattr!=SCA,AA,AT,AP)&&inguarddist&&P2movetype!=A))||(P2movetype=A&&enemynear,time>24)
value = 13

;----------------------------------------------------------------------

;-----
;歩き（後）（CPU）
[Statedef 22]
type    = S
physics = N
sprpriority = 0
ctrl = 0

[State 20, 1]
type = VelSet
trigger1 = time>=2
x = const(velocity.walk.back.x)

[State 20, 4]
type = ChangeAnim
trigger1 = time=0
value = 21

[State 20, 4]
type = changestate
trigger1 = P2dist x <= 0
value = 0
ctrl = 1

[State 20, 4]
type = changestate
trigger1 = time>=ifelse(!fvar(37),12,8) && random<=250
value = 13

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"&&time>=2
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"&&time>=2
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = command="holdfwd"
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = command="holdback"
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

;~~~~~~~~~~~~~~~~~~~~~~~~
;コマンド先行入力
[state 250]
type = varset
trigger1 = time=0
var(9) = 0

;ジャンプ攻撃再入力用
[state 250]
type = varset
trigger1 = time=0
var(11) = 0

;ダッシュ中に出したか判定
[state 250]
type = varset
trigger1 = time=0
var(12) = 0

[state 250]
type = varset
trigger1 = time=0
fvar(10) = 0

;カルマ＝エレガンテ
[state -2]
type = VarSet
trigger1 = time=0
var(32) = 0
;~~~~~~~~~~~~~~~~~~~~~~~~

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = Time = 0&&command = "holdfwd"&&!fvar(38)
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = Time = 0&&command = "holdback"&&!fvar(38)
sysvar(1) = -1

;===AI(CPU)===
[State 40, 2]
type = VarSet
trigger1 = Time = 0&&fvar(38)&&P2bodydist X>180&&random%7<ifelse(numhelper(6000),5,3)
trigger2 = time=0&&fvar(38)&&!fvar(37)&&P2bodydist X>120
sysvar(1) = 1

[State 40, 2]
type = VarSet
trigger1 = Time = 0&&fvar(38)&&(P2bodydist X=[100,160])&&random%7<ifelse(fvar(22)>0,4,2)&&fvar(37)
trigger2 = Time=0 &&fvar(38)&&!var(22)&&!numhelper(6000)&&(P2bodydist X=[60,80])
sysvar(1) = -1

[state 250]
type = VarSet
trigger1 = Time=0
var(2)=ifelse(var(22),1,sysvar(1))

;画面端ヒットバック用
[state 250]
type = varset
trigger1 = time=0
fvar(12) = 0

[state 250]
type = varset
trigger1 = animtime=0
fvar(12) = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(var(22)>0,-1,const(velocity.jump.y))

[State 40, 5]
type = null;VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 5110, 6]
type = PlaySnd
trigger1 = AnimTime = 0 && var(59)=2
value = 40, 0+(var(59)=2)*100
volume = ifelse(((var(57)>=10)||var(59)=2),-208,255)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0&&(!(var(22)>0)||vel Y)
trigger2 = var(22)=-1&&anim!=ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2&&(!(var(22)>0)||vel Y)
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;ジャンプ攻撃再入力用
[state 250]
type = ChangeAnim
trigger1 = Time=0&&(prevstateno=[600,799])
value = 41
elem = 11

;~~ダークフォース中~~~
[State 50, 1]
type = VarSet
trigger1 = Time = 0&&var(22)>0&&(Prevstateno=[1200,1250])
var(2) = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0&&var(22)>0&&(Prevstateno=[1200,1250])
var(12) = 0

[State 50, 1]
type = CtrlSet
trigger1 = Time = 0&&var(22)>0
value = 1

[State 50, 1]
type = CtrlSet
trigger1 = var(22)=-1
value = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0&&var(22)>0 && var(2)
value = 2000

[State 50, 2]
type = Turn
trigger1 = P2dist X<-const(size.air.back)&&var(22)>0 && var(2)

[State 50, 1]
type = StatetypeSet
trigger1 = var(22)<=0
physics = A

[State 50, 1]
type = StatetypeSet
trigger1 = Time = 0 && var(22)>0 && var(2)
physics = N

[State 50, 1]
type = VarSet
trigger1 = Time = 0&&var(22)>0 && var(2)
var(11)=0

[State 50, 1]
type = velmul
triggerall = !fvar(38)
trigger1 = var(22)>0 && var(2)
x = .85
y = .85

[State 50, 1]
type = velset
triggerall = !fvar(38)
trigger1 = var(22)>0 && var(2)
x = ifelse(vel X&&abs(vel X)<1,0,ifelse(command="holdfwd",const(velocity.jump.fwd.x),ifelse(command="holdback",-const(velocity.jump.fwd.x),Vel X)))
y = ifelse((Pos Y<=-110&&Vel Y<0)||(vel Y&&abs(vel Y)<1),0,ifelse(command="holdup"&&Pos Y>-110,const(velocity.jump.y)*.3,ifelse(command="holddown",-const(velocity.jump.y)*.3,vel Y)))

;===AI(CPU)===
[State 50, 1]
type = velset
triggerall = fvar(38)
trigger1 = var(22)>0 && var(2)
x = ifelse((P2bodydist X>(ceil(120*const(size.xscale))-const(size.ground.front))&&Pos Y<-70)&&time>10,ifelse(var(51)%5<3,const(velocity.jump.fwd.x),-const(velocity.jump.fwd.x)),Vel X)
y = ifelse(time<=1||(P2bodydist X>(ceil(120*const(size.xscale))-const(size.ground.front))&&Pos Y>-90&&var(51)%5<3),const(velocity.jump.y)*.3,ifelse(time>10&&vel Y>=0,-const(velocity.jump.y)*.3,0))

[State 50, 1]
type = velset
triggerall = fvar(38)
trigger1 = var(22)>0 && var(2)
x = ifelse(P2bodydist X<(ceil(120*const(size.xscale))-const(size.ground.front))&&time<=1,const(velocity.jump.fwd.x),Vel X)

[State 50, 1]
type = VarSet
trigger1 = var(22)>0 && var(2)
fvar(12)=ifelse(abs(fvar(12))<1,0,fvar(12)*.9)

[State 50, 1]
type = VarSet
triggerall = !fvar(38)
trigger1 = var(22)>0 && var(2)
fvar(12)=ifelse(command="holdfwd",const(velocity.jump.fwd.x),ifelse(command="holdback",-const(velocity.jump.fwd.x),fvar(12)))

;===AI(CPU)===
[State 50, 1]
type = VarSet
triggerall = fvar(38)
trigger1 = var(22)>0 && var(2)
fvar(12) = ifelse((P2bodydist X>(ceil(120*const(size.xscale))-const(size.ground.front))&&Pos Y<-70),ifelse(var(51)%5<3,const(velocity.jump.fwd.x),-const(velocity.jump.fwd.x)),fvar(12))

[State 50, 1]
type = VelSet
trigger1 = var(22)>0 && var(2)
x = ifelse(enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5,fvar(10),0)+fvar(12)

[State 50, 1]
type = ChangeState
trigger1 = Pos Y>=0 && Vel Y>0 && var(22) && var(2)
value = 52+(var(22)=-1)*2000
;~~~~~~~~~~~~~~~~
;---------------------------------------------------------------------------
;着地(Jump Land)
[Statedef 52]
type    = S
physics = S
ctrl = ifelse((prevstateno=[100,110])||var(12),0,1)
anim = 47

[State 40, 1]
type = PlaySND
trigger1 = !Time
value = 52,0+(var(59)>=3)*50+(var(59)=2)*100
volume = ifelse(var(59)=2,-208,255)

[State 1000, land_FX_back]
type = Explod
trigger1 = !Time && var(59)=2 && PrevStateNo!=5040 && (PrevStateNo!=[5200,5210])
Anim = 7910
pos = 0, 0
postype = P1
ownpal = 1
sprpriority = -4
scale = .5,.5

[State 1000, land_FX_front]
type = Explod
trigger1 = !Time && var(59)=2 && PrevStateNo!=5040 && (PrevStateNo!=[5200,5210])
Anim = 7911
pos = 0, 0
postype = P1
ownpal = 1
sprpriority = 4
scale = .5,.5

[state 250]
type = varset
trigger1 = time=0
fvar(12) = 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
x = ifelse(enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5,fvar(10),0)+fvar(12)
