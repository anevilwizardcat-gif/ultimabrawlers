[State 0, HitDef]
type = HitDef
triggerall = (prevstateno!=[150,153])
triggerall = !var(18) && (var(10)<=0||var(10)=100)
trigger1 = AnimElem=5 && !var(1)
attr = S,SA
hitflag = MAF
guardflag = M
getpower = 9*var(5),4*var(5)
givepower = ifelse(var(16)>=11,0,8)*var(6),0
animtype = hard
air.animtype = back
;fall.animtype = Back
damage = ifelse(((16+(var(53)>0)*6)-floor((16+(var(53)>0)*6)*fvar(7)))<2,2,((16+(var(53)>0)*6)-floor((16+(var(53)>0)*6)*fvar(7))))*7,ceil((5+(var(53)>0)*3)*1.0/4)*7
