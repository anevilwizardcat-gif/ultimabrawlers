trigger1 = AnimElem=4
helpertype = normal
name = "saga"
ID = 6000
stateno = 6005
pos = ceil(3*const(size.yscale)),ceil(-37*const(size.yscale))
postype = p1
facing = 1
ownpal = 0
persistent =0

[state 250]
type = velset
trigger1 = AnimElem=2
x = fvar(12)+ifelse(enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5,fvar(10),0)
y = 0

[state 250]
type = VelSet
trigger1 = AnimElem=5
x = ifelse(var(22),-.5,-.75)
y = ifelse(var(22),-.5,ifelse(var(59)=2,-4.5,-5.0))

[state 250]
type = VelAdd
trigger1 = (Anim=[1200,1201])&&((AnimElem=1,>0&&AnimElem=2,<0)||AnimElem=5,>0) && !(var(22)&&(var(2)||Vel Y>=ifelse(AnimElem=3,<0,-.5,2.0)))
y = ifelse(var(59)=2,.5,.55)

[state 250]
type = CtrlSet
trigger1 = AnimElemTime(11)>=0&&var(59)=2
value = 1

[state 250]
type = ChangeState
trigger1 = AnimTime=0&&var(59)=2
value = 50
ctrl = 1

[state 250]
type = ChangeAnim
trigger1 = Vel Y>0 && Pos Y>=0
value = 47

[state 250]
type = statetypeset
trigger1 = Anim=47
statetype=S
physics = S
movetype =I

[state 250]
type = Posset
trigger1 = Anim=47
y = 0

[state 250]
type = VelSet
trigger1 = Anim=47
x = 0
y = 0

[state 250]
type = ChangeState
trigger1 = Anim=47&&AnimTime=0
value = 0
ctrl = 1

;~~ダークフォース中~~

[State 50, 1]
type = ChangeState
trigger1 = Pos Y>=0 && var(22)
value = 52+(var(22)=-1)*1998

[state 250]
type = ChangeState
trigger1 = var(22)&&Time=40
value = 50
ctrl = 1
