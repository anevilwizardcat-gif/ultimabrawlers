;ジャンプ弱Ｐ　マーノ＝ビアシマーレ（窘めの手）
;Jump Light Punch mano biasimare
[statedef 600]
type    = A
physics = N
movetype= A
ctrl    = 0
anim    = 600+(var(59)=2)
juggle = 15

[state 250]
type = PlaySND
trigger1 = AnimElem=2
value = 2,0+(var(59)=2)*100
channel = 2
volume = ifelse(((var(57)>=10)||var(59)=2),-208,255)

;~~~自分側のhitpause作成~~
[state 250]
type = varset
trigger1 = time=0
var(10) = 100

[state 250]
type = varset
trigger1 = movecontact=1
var(10) = 10-(var(59)=2)*2

[state 250]
type = varadd
trigger1 = movecontact&&var(10)>=0
var(10) = -1

;必殺技キャンセル時ヒットポーズ1F減少
[state 250]
type = varadd
trigger1 = movecontact&&var(9)>=1000&&var(10)=1&&var(59)<2
var(10) = -1

[state 250]
type = varset
trigger1 = movecontact&&((enemynear,prevstateno=[5000,5099])||(enemynear,prevstateno=[150,155]))&&P2movetype!=H&&ifelse(var(59)>=3,P2movetype=I,1)&&var(10)>0
var(10) = 0

[state 250]
type = ChangeAnim
trigger1 = movecontact && var(10)>var(8) && var(10)>3
value = anim
elem = ifelse(AnimElemNo(0)=var(7),AnimElemNo(0),AnimElemNo(-1))

[state 250]
type = varset
trigger1 = (var(10)<=0||var(10)=100)
var(7) = AnimElemNo(0)

[state 250]
type = varset
trigger1 = (var(10)<=0||var(10)=100)
var(8) = AnimElemTime(AnimElemNo(0))
;~~~~~~~~~~~~~~~~~~~~~~
;~~~相手側のhitpause作成~~
[state 250]
type = varset
trigger1 = time=0
fvar(9) = 100

[state 250]
type = varset
trigger1 = movecontact=1
fvar(9) = 10-(var(59)=2)*2

[state 250]
type = varadd
trigger1 = movecontact&&fvar(9)>=0
fvar(9) = -1

[state 250]
type = varset
trigger1 = movecontact&&((enemynear,prevstateno=[5000,5099])||(enemynear,prevstateno=[150,155]))&&P2movetype!=H&&ifelse(var(59)>=3,P2movetype=I,1)&&fvar(9)>0
fvar(9) = 0
;~~~~~~~~~~~~~~~~~~~~~~

[State 0, HitDef]
type = HitDef
triggerall = !var(18) && (var(10)<=0||var(10)=100)
trigger1 = AnimElem=3
attr = A,NA
hitflag = MAF
guardflag = HA
getpower = 6*var(5),3*var(5)
givepower = ifelse(var(16)>=11,0,8)*var(6),0
animtype = light
air.animtype = back
;fall.animtype = Back
damage = ifelse(((6+(var(53)>0)*3)-floor((6+(var(53)>0)*3)*fvar(7)))<2,2,((6+(var(53)>0)*3)-floor((6+(var(53)>0)*3)*fvar(7))))*7
pausetime = 1,10
sparkno = -1
guard.sparkno = -1
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),ceil(-45*const(size.yscale))
hitsound = -1;s1,0
guardsound = -1;s0,0
ground.type = High
;air.type = High
ground.slidetime = 10
ground.hittime = 10
guard.slidetime = 9
guard.hittime = 9
airguard.ctrltime = 2
yaccel = .5
ground.velocity = -5.75*const(size.xscale)
air.velocity = -4.0,-6.0
airguard.velocity = -5.45*const(size.xscale),-1.0*const(size.yscale)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall.xvelocity = -4.0*const(size.xscale)*ifelse(enemynear,facing=facing,-1,1)
fall.yvelocity = -1.25*const(size.yscale)
air.hittime = 99
fall.recover = 0
forcenofall = 1


;===CFJ
[State 0, HitDef]
type = HitDef
triggerall = !var(18) && (var(10)<=0||var(10)=100)
trigger1 = AnimElem=3 && var(59)=2
attr = A,NA
hitflag = MAF
guardflag = HA
getpower = 2*var(5),1*var(5)
givepower = 1*var(6),0
animtype = light
air.animtype = back
;fall.animtype = Back
damage = ifelse(floor((5+(var(53)>0)*2)*7*fvar(7))<7,7,floor((5+(var(53)>0)*2)*7*fvar(7)))
pausetime = 1,8
sparkno = -1
guard.sparkno = -1
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),ceil(-45*const(size.yscale))
hitsound = -1;s1,0
guardsound = -1;s0,0
ground.type = High
;air.type = High
ground.slidetime = 10
ground.hittime = 10
guard.slidetime = 9
guard.hittime = 9
yaccel = .5
ground.velocity = -5.75*const(size.xscale)
air.velocity = -4.0,-6.0
airguard.velocity = -5.45*const(size.xscale),-1.0*const(size.yscale)
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
fall.xvelocity = -4.0*const(size.xscale)*ifelse(enemynear,facing=facing,-1,1)
fall.yvelocity = -1.25*const(size.yscale)
air.hittime = 99
fall.recover = 0
forcenofall = 1

;~~コマンド先行入力~~
[state 250]
type = varset
trigger1 = time=0
trigger2 = animtime=-1
var(9) = 0

;~~ES必殺技~~~
;ESイラ＝スピンタ
[state 250]
type = varset
trigger1 = !var(9) && Power>=1000 && var(10)>0 && movecontact && ((prevstateno!=[600,799])||(var(59)=1&&(prevstateno=600||prevstateno=630)))
var(9) = ifelse(command = "spinta"&&(command="ab"||command="ac"||command="bc"),1550,0)

;ESディオ＝セーガ
[state 250]
type = varset
trigger1 = !var(9) && Power>=1000 && var(10)>0 && movecontact && ((prevstateno!=[600,799])||(var(59)=1&&(prevstateno=600||prevstateno=630)))
var(9) = ifelse(command = "saga"&&(command="xy"||command="xz"||command="yz"),1250,0)

;~~~~~~~~~~~~~~
;~~必殺技~~~
;イラ＝スピンタ
[state 250]
type = varset
trigger1 = !var(9) && var(10)>0 && movecontact && ((prevstateno!=[600,799])||(var(59)=1&&(prevstateno=600||prevstateno=630)))
var(9) = ifelse(command="spinta",ifelse(command = "a",1500,ifelse(command = "b",1510,1520)),0)

;ディオ＝セーガ
[state 250]
type = varset
trigger1 = !var(9) && var(10)>0 && movecontact && ((prevstateno!=[600,799])||(var(59)=1&&(prevstateno=600||prevstateno=630)))
var(9) = ifelse(command="saga",ifelse(command = "x",1200,ifelse(command = "y",1210,1220)),0)
;~~~~~~~~~~~

;チェーンコンボ(CFJ:ジャンプ攻撃再入力)
[state 250]
type = varset
trigger1 = !var(9) && var(10)>0 && movecontact && (!var(12)||var(59)=2)
var(9) = ifelse(command="a",4,ifelse(command="b",5,ifelse(command="c",6,ifelse(var(59)=2&&command="x",1,ifelse(command="y",2,ifelse(command="z",3,0))))))

;~~~~~~~~~~~~~~~~~~~~~~~~~
;ジャンプ攻撃再入力用
[state 250]
type = varadd
trigger1 = time=0&&((prevstateno!=[600,799])||var(59)=2)
var(11) = 1

;ダッシュ中に出したか判定
[state 250]
type = varset
trigger1 = time=0 && (prevstateno=[100,110])
var(12) = ifelse(prevstateno=105,2,1)

;~~~~~~~~~~~~~~~~~~~~~~~~
;~~~~~~~~~~~~~~~~~~~~~~~~~
;====ヒット音設定
[state 200]
type = varset
trigger1 = time=0
var(40) = 0

;====攻撃属性設定
[state 200]
type = varset
trigger1 = time=0
var(41) = 0

;====ヒットスパークＸ座標
[state 200]
type = varset
trigger1 = time=0
var(42) = ceil(P2dist X)+ifelse((Abs(P2bodydist X)-10)<20,0,-10)

;====ヒットスパークＹ座標
[state 200]
type = varset
trigger1 = time=0
var(43) = ceil(-45*const(size.yscale))
;~~~~~~~~~~~~~~~~~~~~~~~~~

;回復可能ダメージ設定（予約）
[state 250]
type = varset
trigger1 = var(53) && var(53)<1000 && var(23)<=0
var(53) = ifelse(var(59)=2,ifelse(floor(3*fvar(7))<1,1,floor(3*fvar(7))),ifelse((4-floor(4*fvar(7)))<1,1,(4-floor(4*fvar(7)))))+1

;削り
[state 250]
type = varset
trigger1 = var(53) && var(53)<1000 && var(23)<=0
var(52) = 0

;~~~~~~~~~~~~~~~~~~~~~~~~~
;~~~画面端ヒットバック~~~
[State 200]
type = varset
trigger1 = time=0
fvar(12) = ifelse(var(12),ifelse(var(12)=2,-2.0,3.5)*ifelse(var(59)=2,.8,1)*ifelse(P2dist X<-const(size.air.back),-1,1),fvar(12))

[State 200]
type = velset
trigger1 = movecontact=1; && enemynear,backedgebodydist <=5
x = fvar(12)
ignorehitpause=1

[State 200]
type = varset
trigger1 = movecontact=1; && enemynear,backedgebodydist <=5
fvar(10) = -5.75*const(size.xscale)
ignorehitpause=1

[State 200]
type = varset
trigger1 = movecontact=1; && enemynear,backedgebodydist <=5
fvar(11) = ifelse(moveguarded,9,10)
ignorehitpause=1

[state -2]
type = varset
trigger1 = movecontact&&((!var(10)&&fvar(9)=100)||!fvar(9))
var(13) = ifelse(moveguarded,-1,1)
ignorehitpause=1
;~~~~~~~~~~~~~~~~~~~~~~~~~
[state 100]
type= PlayerPush
trigger1 = var(12)
trigger1 = P2dist Y>ifelse(P2statetype=C&&var(59)!=2,8,27)
value = 0

[state 100]
type= PlayerPush
trigger1 = var(12)
trigger1 = P2dist Y<=ifelse(P2statetype=C&&var(59)!=2,8,27)
value = 1

[state 250]
type = VelSet
trigger1 = time=0&&var(12)
y = ifelse(var(59)=2,-1.75,ifelse((prevstateno!=[100,110]),-1.0,-1.5))

[state 250]
type = VelSet
trigger1 = time=0&&var(12)
x = ifelse(var(12)=2,-2.5,3.5)*ifelse(var(59)=2,.8,1)

[state 250]
type = Turn
trigger1 = Time=0 && var(12) && P2dist X<-const(size.air.back)

[state 250]
type = PosFreeze
trigger1 = (var(10)>0||(fvar(9)=[1,10]))&&movecontact
value = 1

[state 250]
type = Gravity
triggerall = !(var(22)>0 && var(2)) && !var(12)
trigger1 = var(10)<=0||!movecontact

[state 250]
type = VelAdd
triggerall = !(var(22)>0 && var(2)) && var(12)
trigger1 = var(10)<=0||!movecontact
y = const(movement.yaccel)*.7;.75

;ジャンプ攻撃再入力用
[state 250]
type = ChangeState
trigger1 = (Anim-(var(59)=2))=stateno && AnimTime=0 && (!movecontact||var(12)||(var(22)>0)||var(59)=1) && var(59)!=2
value = 50

;ヒット時は再入力不可（ダッシュ中のみ可）
[state 250]
type = ChangeAnim
trigger1 = (Anim-(var(59)=2))=stateno && AnimTime=0 && movecontact && !var(12) && !(var(22)>0)
value = 41
elem = 11

[state 250]
type = StatetypeSet
trigger1 = AnimElem=4&&var(59)!=2
movetype=I

[state 250]
type = ChangeState
trigger1 = Vel Y>0 && Pos Y>=-Vel Y && (var(10)<=0||!movecontact)
value = 52

;~~ダークフォース中~~
[State 50, 1]
type = VarSet
trigger1 = time=0 && var(22)>0 && (var(12)||(prevstateno!=50)&&(prevstateno!=[600,799]))
var(2) = 0

[State 50, 1]
type = velmul
trigger1 = var(22)>0 && var(2) && (var(10)<=0||!movecontact)
x = .85
y = .85

[State 50, 1]
type = velset
triggerall = !fvar(38)
trigger1 = var(22)>0 && var(2)
x = ifelse(vel X&&abs(vel X)<1,0,ifelse(command="holdfwd",const(velocity.jump.fwd.x),ifelse(command="holdback",-const(velocity.jump.fwd.x),Vel X)))
y = ifelse((Pos Y<=-110&&Vel Y<0)||(vel Y&&abs(vel Y)<1),0,ifelse(command="holdup"&&Pos Y>-110,const(velocity.jump.y)*.3,ifelse(command="holddown",-const(velocity.jump.y)*.3,vel Y)))

;===AI(CPU)===
[State 50, 1]
type = velset
triggerall = fvar(38)
trigger1 = var(22)>0 && var(2)
x = ifelse(Pos Y>-30||vel X>0,const(velocity.jump.fwd.x),vel x)
y = ifelse(Pos Y<-30,-const(velocity.jump.y)*.3,vel Y)

[State 50, 1]
type = VarSet
trigger1 = var(22)>0 && var(2) && (var(10)<=0||!movecontact)
fvar(12)=ifelse(abs(fvar(12))<1,0,fvar(12)*.9)

[State 50, 1]
type = VarSet
triggerall = !fvar(38)
trigger1 = var(22)>0 && var(2)
fvar(12)=ifelse(command="holdfwd",const(velocity.jump.fwd.x),ifelse(command="holdback",-const(velocity.jump.fwd.x),fvar(12)))

;===AI(CPU)===
[State 50, 1]
type = VarSet
triggerall = fvar(38)
trigger1 = var(22)>0 && var(2)
fvar(12)=ifelse(Pos Y>-30||vel X>0,const(velocity.jump.fwd.x),fvar(12))

[State 50, 1]
type = VelSet
trigger1 = var(22)>0 && var(2)
x = ifelse(enemynear,backedgebodydist<=5||enemynear,frontedgebodydist<=5,fvar(10),0)+fvar(12)

[State 50, 1]
type = ChangeState
trigger1 = Pos Y>=0 && Vel Y>0 && var(22) && !var(12) && (prevstateno=50||(prevstateno=[600,799]))
value = 52+(var(22)=-1)*2000

[state 250]
type = ChangeState
trigger1 = var(22) && !var(12) && (prevstateno=50||(prevstateno=[600,799]))&&Anim=44
value = 50
ctrl = 1
;~~~~~~~~~~~~~~~~~~~~
;============================
;ジャンプ中Ｐ　ディート＝カルマーレ（宥めの指）
;Jump Medium Punch dito calmare
[statedef 610]
type    = A
physics = N
movetype= A
ctrl    = 0
anim    = 610+(var(59)=2)
juggle = 15
poweradd = ifelse(var(59)=2,1,ifelse(var(12)||(prevstateno=[100,110]),0,3))*var(5)

[state 250]
type = PlaySND
trigger1 = AnimElem=3
value = 2,1+(var(59)=2)*100
channel = 2
volume = ifelse(((var(57)>=10)||var(59)=2),-208,255)

