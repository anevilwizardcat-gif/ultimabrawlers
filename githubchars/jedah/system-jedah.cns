trigger4 = var(20)=6 && ifelse(var(59)=1,var(0)%100<68,var(0)%4<4)
trigger5 = var(20)=7 && var(0)%100<85 && var(59)=1
trigger6 = var(20)=8 && var(0)%100<100 && var(59)=1
var(19) = -2

[state -2]
type = varadd
trigger1 = var(21)<=0||var(21)>=2
var(21) = 1

[state -2]
type = varset
triggerall = numhelper(7600)
trigger1 = !hitshakeover && var(21)<=0 && time=0
trigger2 = var(19)=-2 && helper(7600),time>1
var(21) = 2

[state -2]
type = varset
trigger1 = var(19)=-2
var(20) = 0

[state -2]
type = varadd
trigger1 = var(19)<0
var(19) = -1

