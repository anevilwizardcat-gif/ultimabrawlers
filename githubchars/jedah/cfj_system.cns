ctrl = 0
anim = 90000

[state 8740,SFX]
type = PlaySND
trigger1 = !time
value = 8845,0
volume = -208
ignorehitpause=1

[State 8740, logo]
type = Explod
trigger1 = !time
ID = 8845
anim = 8845
pos = 160,120
postype = Left
removetime=-1
bindtime=-1
sprpriority = 10
ontop = 1
scale = .125,.125
facing = 1

[State 8740]
type = ModifyExplod
trigger1 = time<11
ID = 8845
scale = .125+.0375*time,.125+.0375*time

[state 8870]
type = RemoveExplod
trigger1 = time>=144
id = 8845

[state 8870]
type = AssertSpecial
trigger1 = time<144
flag = roundnotover

