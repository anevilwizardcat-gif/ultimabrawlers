;-----------
;K.O.
[statedef 8742]
type = A
anim = 90000
ctrl = 0

[State 8800, message]
type = Helper
trigger1 = !numhelper(8750) && !time
helpertype = normal
name = "finish_annouce"
ID = 8800+ifelse(!numhelper(8800),0,ifelse(!numhelper(8801),1,ifelse(!numhelper(8802),2,3)))
stateno = 8820+root,var(3)
pos = 0,160
postype = back
ownpal = 1
ignorehitpause =1
pausemovetime = 9999
supermovetime = 9999

[state 8740,SFX]
type = PlaySND
trigger1 = !time
value = 8745,0
volume = -208
abspan = 0
ignorehitpause=1

[state 8740]
type = AssertSpecial
trigger1 = time<64 && root,var(3)=3
flag = NoBG
flag2 = NoFG
flag3 = GlobalNoShadow
ignorehitpause = 1

[state 8740]
type = AssertSpecial
trigger1 = roundstate=2
flag = NoKO
ignorehitpause = 1

[state 8740]
type = Pause
trigger1 = !time
time=64
movetime=64
ignorehitpause =1

[state 8740,slow]
type = Pause
trigger1 = (time=(63,144]) && time%(1+(time>120))=0
time=1
movetime=1
ignorehitpause =1

[state 8740, lifemax]
type = VarAdd
trigger1 = !time && root,life>=root,lifemax
trigger1 = (root,var(58)=1 && (root,var(54)>1&&root,var(53)&&root,var(53)<1000&&!(root,teammode=turns)))||root,teammode=turns
trigger2 = var(1) && roundstate>3 && (root,stateno=[180,189])
var(1) = 1

[state 8740, perfect!]
type = Helper
trigger1 = !numhelper(8845) && !numhelper(8750) && var(1)>128 && (root,stateno=[180,189]) && root,alive
name = "perfect_annouce"
id = 8845
stateno = 8845
helpertype = normal
pos = 160,0
postype = Left
ownpal = 1
pausemovetime = 9999
supermovetime = 9999

[state 8740]
type = DestroySelf
trigger1 = roundstate>4
ignorehitpause = 1

