p2.n.spr = 100,0
; Win by special
p1.s.spr = 100,0
p2.s.spr = 100,0
; Win by hyper (super)
p1.h.spr = 100,0
p2.h.spr = 100,0
; Win by normal throw
p1.throw.spr = 100,0
p2.throw.spr = 100,0
; Win by cheese
p1.c.spr = 100,0
p2.c.spr = 100,0
; Win by time over
p1.t.spr = 100,0
p2.t.spr = 100,0
; Win by suicide (here's a fun one)
