#===============================================================================
# Global states (not halted by Pause/SuperPause, no helper limitations)
#===============================================================================
[StateDef -4]

ignoreHitPause if !const(Default.Enable.Action) || isHelper || teamSide = 0 {
	# Do nothing, global code disabled locally or executed by helper or stage
} else if roundState >= 2 {
	# First Attack
	let ret = call IkSys_FirstAttack();
	if $ret {
		lifebarAction{spr: const(MsgFirstAttack), 0; top: 1}
	}
	# Counter Hit
	let ret = call IkSys_CounterHit();
	if $ret {
		lifebarAction{spr: const(MsgCounterHit), 0; top: 1}
	}
	# Technical
	let ret = call IkSys_Technical();
	if $ret {
		lifebarAction{spr: const(MsgTechnical), 0; top: 1}
	}
	# Reversal
	let ret = call IkSys_Reversal();
	if $ret {
		lifebarAction{spr: const(MsgReversal), 0; top: 1}
	}
	# Parry
	let ret = call IkSys_Parry();
	if $ret {
		lifebarAction{spr: const(MsgParry), 0; top: 1; redirectId: enemy,id}
	}
	# Just Defend
	let ret = call IkSys_JustDefend();
	if $ret {
		lifebarAction{spr: const(MsgJustDefend), 0; top: 1}
	}
	# Danger
	let ret = call IkSys_Danger();
	if $ret {
		lifebarAction{anim: 4050; timeMul: 2; top: 1}   # DANGER (animated red pulse)
	}
	# Dizzy
	let ret = call IkSys_Dizzy();
	if $ret {
		lifebarAction{spr: const(MsgDizzy), 0; timeMul: 2; top: 1}
	}
	# Guard Break
	let ret = call IkSys_GuardBreak();
	if $ret {
		lifebarAction{spr: const(MsgGuardBreak), 0; timeMul: 2; top: 1}
	}
	# Partner Down
	let ret = call IkSys_PartnerDown();
	if $ret {
		lifebarAction{spr: const(MsgPartnerDown), 0; timeMul: 2; top: 1}
	}
	# code executed only by P1 and P2
	if playerNo = teamSide {
		# Combo Count
		# === P092: DETACHED HUD counter under each default counter. ===
		# Origin is TOP-LEFT (confirmed in-engine: a marker at pos(0,0) lands at the top-left corner; pos scales with
		# the gamewidth/gameheight triggers). Earlier detaches assumed a CENTER origin -> wrong spot / off-screen.
		# Default counter = fight.def [Combo] 130/1150 , 224 in 1280x720. Placed as fractions of gamewidth/gameheight
		# (resolution-independent), just below it. space:screen+postype:none+ontop:1 = fixed HUD, no char-flip.
		# TUNE: bx fractions (13/128 P1, 115/128 P2), by (13/36 ~just under), scale 0.3, tens gap (-7) - nudge by screenshot.
		# === P093: count-up BOUNCE - matches the default counter (fight.def counter.shake=1 time=7 mult=0.05). ===
		# Engine formula (lifebar.go): z = 1 + shaketime*mult*sin(shaketime*pi/2.5); shaketime resets to 7 each new
		# hit, -1/frame. CONFIRMED in-engine. Re-spawned-each-frame explods just read the current scale.
		if comboCount > map(_ubcN) { map(_ubcST) := 7; }   # new hit -> kick the bounce
		map(_ubcN) := comboCount;                          # track prev count every frame (combo start/end stays correct)
		if map(_ubcST) > 0 { map(_ubcST) := map(_ubcST) - 1; }
		# slide + HOLD + latched count (P097/P098). Match default: showspeed 8, displaytime 90, hidespeed ~4.
		if comboCount > 1 {
			map(_dispC) := comboCount;
			map(_hold) := 60;
			if map(_slf) < 8 { map(_slf) := map(_slf) + 1; }
		} else {
			if map(_hold) > 0 { map(_hold) := map(_hold) - 1; }
			else if map(_slf) > 1 { map(_slf) := map(_slf) - 2; }
			else { map(_slf) := 0; }
		}
		if map(_slf) > 0 {
			let c = map(_dispC);
			let lo = ($c < 35);
			# <35: white digits tinted gold->red. 35+: BAKED rainbow-gradient frames (multi-colour per digit), so
			# palfx is neutral and the colour FLOWS via per-place animation phase. Vertical bob kept at 35+.
			if $lo {
				map(_ubcR0) := 256; map(_ubcG0) := 215 * (34 - $c) / 33; map(_ubcB0) := 0;
				map(_ubcR1) := map(_ubcR0); map(_ubcG1) := map(_ubcG0); map(_ubcB1) := map(_ubcB0);
				map(_ubcR2) := map(_ubcR0); map(_ubcG2) := map(_ubcG0); map(_ubcB2) := map(_ubcB0);
				map(_dy0) := 0; map(_dy1) := 0; map(_dy2) := 0;
			} else {
				map(_ubcR0) := 256; map(_ubcG0) := 256; map(_ubcB0) := 256;
				map(_ubcR1) := 256; map(_ubcG1) := 256; map(_ubcB1) := 256;
				map(_ubcR2) := 256; map(_ubcG2) := 256; map(_ubcB2) := 256;
				let bs = (min(99, $c) - 30) / 280.0;
				let amp = 1 + (min(99, $c) - 35) * 2 / 64;
				map(_dy0) := $amp * sin(gameTime * $bs);
				map(_dy1) := $amp * sin(gameTime * $bs + 1.5);
				map(_dy2) := $amp * sin(gameTime * $bs + 3.0);
			}
			# gradient flow phase (0..11): tens/huns lead by +4/+8 so the rainbow flows across the number; faster at high combo
			let fdiv = 8 - (min(99, $c) - 35) * 6 / 64;
			let phO = (gameTime / $fdiv) % 12;
			let phT = (gameTime / $fdiv + 4) % 12;
			let phH = (gameTime / $fdiv + 8) % 12;
			let bx = (teamSide = 1) * (gamewidth * 13 / 128) + (teamSide = 2) * (gamewidth * 115 / 128);
			let by = gameheight / 5;
			let so = (8 - map(_slf)) * gamewidth / 56;
			let ax = $bx - 4 - $so * (teamSide = 1) + $so * (teamSide = 2);
			let nd = ($c >= 100) + ($c >= 10) + 1;
			let ox = $ax + ($nd - 1) * 4;
			let ny = $by + 3;
			let z = 1 + map(_ubcST) * 0.05 * sin(map(_ubcST) * 1.25663706);
			let sc = 0.3 * $z / camerazoom;
			let sh = 0.25 / camerazoom;
			let cz = camerazoom;   # P106: also divide POSITION by zoom (screen explods render pos*cam.Scale from top-left origin)
			let oy = $ny + map(_dy0);
			let ty = $ny + map(_dy1);
			let hy = $ny + map(_dy2);
			let ones = $c % 10;
			let animO = $lo * (9000 + $ones) + (1 - $lo) * (9200 + $ones * 12 + $phO);
			let animHits = $lo * 9100 + (1 - $lo) * (9400 + $phO);
			explod{ anim: F($animHits); id: 8103; space: screen; postype: none; ontop: 1; pos: $ax / $cz, ($by + 13) / $cz; scale: $sh,$sh; removetime: 1; supermovetime: 999999; pausemovetime: 999999; ownpal: 1; sprpriority: 99; }
			explod{ anim: F($animO); id: 8101; space: screen; postype: none; ontop: 1; pos: $ox / $cz, $oy / $cz; scale: $sc,$sc; removetime: 1; supermovetime: 999999; pausemovetime: 999999; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR0), map(_ubcG0), map(_ubcB0); }
			if $c >= 10 {
				let tens = ($c / 10) % 10;
				let animT = $lo * (9000 + $tens) + (1 - $lo) * (9200 + $tens * 12 + $phT);
				explod{ anim: F($animT); id: 8102; space: screen; postype: none; ontop: 1; pos: ($ox - 8) / $cz, $ty / $cz; scale: $sc,$sc; removetime: 1; supermovetime: 999999; pausemovetime: 999999; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR1), map(_ubcG1), map(_ubcB1); }
			}
			if $c >= 100 {
				let huns = ($c / 100) % 10;
				let animH = $lo * (9000 + $huns) + (1 - $lo) * (9200 + $huns * 12 + $phH);
				explod{ anim: F($animH); id: 8104; space: screen; postype: none; ontop: 1; pos: ($ox - 16) / $cz, $hy / $cz; scale: $sc,$sc; removetime: 1; supermovetime: 999999; pausemovetime: 999999; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR2), map(_ubcG2), map(_ubcB2); }
			}
		}
		let ret = call IkSys_ComboCount();
		if $ret {
			# ULTIMA COMBO threshold raised 25 -> 35 (P072). 20-34 hits now show AMAZING (MsgCombo20).
			if $ret >= 35 {
				lifebarAction{anim: 4120; timeMul: 2.5; top: 1}   # ULTIMA COMBO (animated rainbow, lingers)
			# amazing combo (marvelous)
			} else if $ret >= 20 {
				lifebarAction{spr: const(MsgCombo20), 0; top: 1}
			# great combo (fantastic)
			} else if $ret >= 15 {
				lifebarAction{spr: const(MsgCombo15), 0; top: 1}
			# sweet combo (beautiful)
			} else if $ret >= 10 {
				lifebarAction{spr: const(MsgCombo10), 0; top: 1}
			# good combo (great)
			} else if $ret >= 5 {
				lifebarAction{spr: const(MsgCombo5), 0; top: 1}
			# nice combo (good)
			} else if $ret >= 3 {
				lifebarAction{spr: const(MsgCombo3), 0; top: 1}
			}
		}
		# Win Clutch
		let ret = call IkSys_WinClutch();
		if $ret {
			lifebarAction{spr: const(MsgWinClutch), 0; timeMul: 3; top: 1}
		}
		# Win Perfect
		let ret = call IkSys_WinPerfect();
		if $ret {
			lifebarAction{spr: const(MsgWinPerfect), 0; timeMul: 3; top: 1}
		}
		# Win Hyper
		let ret = call IkSys_WinHyper();
		if $ret {
			lifebarAction{spr: const(MsgWinHyper), 0; timeMul: 3; top: 1}
		}
		# Win Special
		let ret = call IkSys_WinSpecial();
		if $ret {
			lifebarAction{spr: const(MsgWinSpecial), 0; timeMul: 3; top: 1}
		}
	}
}
