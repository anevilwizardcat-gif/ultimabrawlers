#===============================================================================
# Global states (not halted by Pause/SuperPause, no helper limitations)
#===============================================================================
[StateDef -4]

ignoreHitPause if !const(Default.Enable.Action) || isHelper || teamSide = 0 {
	# Do nothing, global code disabled locally or executed by helper or stage
} else if roundState >= 2 {
	# First Attack
	let ret = call IkSys_FirstAttack();
	if $ret {
		lifebarAction{spr: const(MsgFirstAttack), 0; top: 1}
	}
	# Counter Hit
	let ret = call IkSys_CounterHit();
	if $ret {
		lifebarAction{spr: const(MsgCounterHit), 0; top: 1}
	}
	# Technical
	let ret = call IkSys_Technical();
	if $ret {
		lifebarAction{spr: const(MsgTechnical), 0; top: 1}
	}
	# Reversal
	let ret = call IkSys_Reversal();
	if $ret {
		lifebarAction{spr: const(MsgReversal), 0; top: 1}
	}
	# Parry
	let ret = call IkSys_Parry();
	if $ret {
		lifebarAction{spr: const(MsgParry), 0; top: 1; redirectId: enemy,id}
	}
	# Just Defend
	let ret = call IkSys_JustDefend();
	if $ret {
		lifebarAction{spr: const(MsgJustDefend), 0; top: 1}
	}
	# Danger
	let ret = call IkSys_Danger();
	if $ret {
		lifebarAction{anim: 4050; timeMul: 2; top: 1}   # DANGER (animated red pulse)
	}
	# Dizzy
	let ret = call IkSys_Dizzy();
	if $ret {
		lifebarAction{spr: const(MsgDizzy), 0; timeMul: 2; top: 1}
	}
	# Guard Break
	let ret = call IkSys_GuardBreak();
	if $ret {
		lifebarAction{spr: const(MsgGuardBreak), 0; timeMul: 2; top: 1}
	}
	# Partner Down
	let ret = call IkSys_PartnerDown();
	if $ret {
		lifebarAction{spr: const(MsgPartnerDown), 0; timeMul: 2; top: 1}
	}
	# code executed only by P1 and P2
	if playerNo = teamSide {
		# Combo Count
		# === P088: CUSTOM ANIMATED COMBO COUNTER - SCREEN-ANCHORED (detached from char) ===
		# space:screen + postype:none -> fixed HUD position (NOT tied to the character; survives tag-out, no flip).
		# pos.x is a fraction of gameWidth (trigger) so it's aspect-robust; pos.y from center. TUNE bx10/bxh/by/scale.
		# Explods are visual-only (no hitbox) so AI never perceives/interacts. Color = P086/P087 (gold->red / rainbow).
		if comboCount > 1 {
			if comboCount < 35 {
				map(_ubcR) := 256;
				map(_ubcG) := 215 * (34 - comboCount) / 33;
				map(_ubcB) := 0;
			} else {
				let ph = (gameTime / (4 + (99 - min(99, comboCount)) / 12)) % 6;
				map(_ubcR) := 256 * (($ph = 0) || ($ph = 1) || ($ph = 5));
				map(_ubcG) := 256 * (($ph = 1) || ($ph = 2) || ($ph = 3));
				map(_ubcB) := 256 * (($ph = 3) || ($ph = 4) || ($ph = 5));
			}
			let bx = (teamSide = 1) * (gameWidth / 10) + (teamSide = 2) * (gameWidth * 9 / 10);
			let by = -46;
			let ones = comboCount % 10;
			if $ones = 0 { explod{ anim: F9000; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 1 { explod{ anim: F9001; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 2 { explod{ anim: F9002; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 3 { explod{ anim: F9003; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 4 { explod{ anim: F9004; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 5 { explod{ anim: F9005; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 6 { explod{ anim: F9006; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 7 { explod{ anim: F9007; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 8 { explod{ anim: F9008; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $ones = 9 { explod{ anim: F9009; id: 8101; space: screen; postype: none; pos: $bx, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			if comboCount >= 10 {
				let tens = (comboCount / 10) % 10;
			if $tens = 0 { explod{ anim: F9000; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 1 { explod{ anim: F9001; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 2 { explod{ anim: F9002; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 3 { explod{ anim: F9003; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 4 { explod{ anim: F9004; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 5 { explod{ anim: F9005; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 6 { explod{ anim: F9006; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 7 { explod{ anim: F9007; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 8 { explod{ anim: F9008; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			else if $tens = 9 { explod{ anim: F9009; id: 8102; space: screen; postype: none; pos: $bx - 11, $by; scale: 0.5,0.5; removetime: 2; ownpal: 1; sprpriority: 100; palfx.time: -1; palfx.mul: map(_ubcR), map(_ubcG), map(_ubcB); } }
			}
		}
		let ret = call IkSys_ComboCount();
		if $ret {
			# ULTIMA COMBO threshold raised 25 -> 35 (P072). 20-34 hits now show AMAZING (MsgCombo20).
			if $ret >= 35 {
				lifebarAction{anim: 4120; timeMul: 2.5; top: 1}   # ULTIMA COMBO (animated rainbow, lingers)
			# amazing combo (marvelous)
			} else if $ret >= 20 {
				lifebarAction{spr: const(MsgCombo20), 0; top: 1}
			# great combo (fantastic)
			} else if $ret >= 15 {
				lifebarAction{spr: const(MsgCombo15), 0; top: 1}
			# sweet combo (beautiful)
			} else if $ret >= 10 {
				lifebarAction{spr: const(MsgCombo10), 0; top: 1}
			# good combo (great)
			} else if $ret >= 5 {
				lifebarAction{spr: const(MsgCombo5), 0; top: 1}
			# nice combo (good)
			} else if $ret >= 3 {
				lifebarAction{spr: const(MsgCombo3), 0; top: 1}
			}
		}
		# Win Clutch
		let ret = call IkSys_WinClutch();
		if $ret {
			lifebarAction{spr: const(MsgWinClutch), 0; timeMul: 3; top: 1}
		}
		# Win Perfect
		let ret = call IkSys_WinPerfect();
		if $ret {
			lifebarAction{spr: const(MsgWinPerfect), 0; timeMul: 3; top: 1}
		}
		# Win Hyper
		let ret = call IkSys_WinHyper();
		if $ret {
			lifebarAction{spr: const(MsgWinHyper), 0; timeMul: 3; top: 1}
		}
		# Win Special
		let ret = call IkSys_WinSpecial();
		if $ret {
			lifebarAction{spr: const(MsgWinSpecial), 0; timeMul: 3; top: 1}
		}
	}
}
