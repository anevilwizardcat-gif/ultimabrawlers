;FIGHT
fight.anim = 111             ;.
fight.offset = 160,-20       ;Component for FIGHT display  
fight.snd = 1,0              ;Sound to play        
fight.sndtime = 20           ;Time to play sound          
fight.time = 0               ;Time to show FIGHT component  

ctrl.time = 40               ;Time players get control after starting fight


;K.O.
KO.anim    = 112             ;.
KO.offset  = 160,0           ;Component for KO display  
KO.snd     = 2,0             ;Sound to play for KO announcement
KO.time    = 0               ;Time to show KO component


;DOUBLE K.O.
DKO.displaytime = 60
DKO.font = 5,0,0
DKO.offset = 160,104
DKO.snd = 2,1
DKO.text = Double K.O.


;TIME OVER
TO.displaytime = 60
TO.font = 5,0,0
TO.offset = 160,104
TO.snd = 2,2
TO.text = Time Over

KO.sndtime = 0               ;Time to play sound for KO, DKO and TO.


over.hittime = 10            ;Time after KO that players can still damage each other (for double KO)
over.time = 270              ;Time to wait before round ends
over.waittime = 30           ;Time to wait after KO before player control is stopped
over.wintime = 45            ;Time to wait before players change to win states
over.forcewintime = 900      ;Time to wait before forcing win states if any player is frozen

slow.fadetime = 45           ;KO slowdown fade length (default: 75% of slow.time)
slow.speed = 0.25            ;KO slowdown game speed adjustment (default: 0.25)
slow.time  = 60              ;Time for KO slowdown (in ticks)


;TIME TO WAIT BEFORE SHOWING WIN/DRAW MESSAGE
win.time = 60


;1-PLAYER WIN CONTENT
win.displaytime = 540
win.font = 5,0,0
win.offset = 160,104 
win.snd = 3,0
win.text = %s Wins


