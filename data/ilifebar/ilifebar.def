;FADE
fadein.time = 30             ;Round start fade time (default: 30)
fadein.col = 0,0,0           ;Round start fade color (default: 0,0,0)
fadeout.time = 30            ;Round end fade time (default: 30, extends over.time if fadeout.time is longer)
fadeout.col = 0,0,0          ;Round end fade color (default: 0,0,0)
shutter.time = 15            ;Skip intro fade time (default: 15, whole anim is twice as long)
shutter.col = 0,0,0          ;Skip intro fade color (default: 0,0,0)

